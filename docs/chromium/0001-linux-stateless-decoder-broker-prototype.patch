new file mode 100644
--- /dev/null
+++ b/sandbox/policy/linux/v4l2_request_decoder_paths.h
@@ -0,0 +1,121 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef SANDBOX_POLICY_LINUX_V4L2_REQUEST_DECODER_PATHS_H_
+#define SANDBOX_POLICY_LINUX_V4L2_REQUEST_DECODER_PATHS_H_
+
+#include <fcntl.h>
+#include <linux/media.h>
+#include <linux/videodev2.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace sandbox::policy {
+
+// Linux uses numbered video/media nodes, shared with cameras. Discover only
+// stateless M2M decoders before sandbox entry and grant exact topology-linked
+// paths. This is path-based admission, not hotplug support or an fd broker.
+// The bounds match V4L2Device's Linux discovery limits.
+template <typename AddPath>
+inline void AddV4L2RequestDecoderPaths(AddPath add_path) {
+  std::vector<std::pair<dev_t, std::string>> decoders;
+  for (int i = 0; i < 256; ++i) {
+    const std::string path = "/dev/video" + std::to_string(i);
+    int fd = open(path.c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) {
+      continue;
+    }
+    struct stat st = {};
+    struct v4l2_capability cap = {};
+    bool request_codec = false;
+    if (fstat(fd, &st) == 0 && S_ISCHR(st.st_mode) &&
+        ioctl(fd, VIDIOC_QUERYCAP, &cap) == 0) {
+      const uint32_t caps = (cap.capabilities & V4L2_CAP_DEVICE_CAPS)
+                                ? cap.device_caps
+                                : cap.capabilities;
+      if ((caps & V4L2_CAP_STREAMING) &&
+          (caps & V4L2_CAP_VIDEO_M2M_MPLANE)) {
+        // Bound even a misbehaving format enumerator. No buffers are allocated.
+        for (uint32_t n = 0; n < 128; ++n) {
+          struct v4l2_fmtdesc fmt = {};
+          fmt.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+          fmt.index = n;
+          if (ioctl(fd, VIDIOC_ENUM_FMT, &fmt) < 0) {
+            break;
+          }
+          if (fmt.pixelformat == V4L2_PIX_FMT_H264_SLICE ||
+              fmt.pixelformat == V4L2_PIX_FMT_HEVC_SLICE ||
+              fmt.pixelformat == V4L2_PIX_FMT_VP9_FRAME ||
+              fmt.pixelformat == V4L2_PIX_FMT_AV1_FRAME) {
+            request_codec = true;
+            break;
+          }
+        }
+      }
+    }
+    close(fd);
+    if (request_codec) {
+      decoders.emplace_back(st.st_rdev, path);
+    }
+  }
+  if (decoders.empty()) {
+    return;
+  }
+  for (int i = 0; i < 10; ++i) {
+    const std::string path = "/dev/media" + std::to_string(i);
+    int fd = open(path.c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) {
+      continue;
+    }
+    struct stat st = {};
+    struct media_v2_topology topology = {};
+    if (fstat(fd, &st) < 0 || !S_ISCHR(st.st_mode) ||
+        ioctl(fd, MEDIA_IOC_G_TOPOLOGY, &topology) < 0 ||
+        topology.num_interfaces == 0 || topology.num_interfaces > 256) {
+      close(fd);
+      continue;
+    }
+    const uint32_t count = topology.num_interfaces;
+    const uint64_t version = topology.topology_version;
+    std::vector<media_v2_interface> interfaces(count);
+    topology = {};
+    topology.num_interfaces = count;
+    topology.ptr_interfaces = reinterpret_cast<uintptr_t>(interfaces.data());
+    int result = ioctl(fd, MEDIA_IOC_G_TOPOLOGY, &topology);
+    close(fd);
+    if (result < 0 || topology.topology_version != version ||
+        topology.num_interfaces != count) {
+      continue;
+    }
+    bool linked = false;
+    for (const auto& intf : interfaces) {
+      if (intf.intf_type != MEDIA_INTF_T_V4L_VIDEO) {
+        continue;
+      }
+      const dev_t device = makedev(intf.devnode.major, intf.devnode.minor);
+      const auto match = std::find_if(
+          decoders.begin(), decoders.end(),
+          [device](const auto& decoder) { return decoder.first == device; });
+      if (match != decoders.end()) {
+        linked = true;
+        add_path(match->second);
+      }
+    }
+    if (linked) {
+      add_path(path);
+    }
+  }
+}
+
+}  // namespace sandbox::policy
+
+#endif  // SANDBOX_POLICY_LINUX_V4L2_REQUEST_DECODER_PATHS_H_
