+// Only grant a media controller when its topology names an already admitted
+// M2M video device. Capture-only controllers (including cameras) stay blocked.
+static void AddV4l2RequestMediaDevices(SandboxBroker::Policy* policy,
+                                     const nsTArray<dev_t>& aM2mDevices) {
+  if (aM2mDevices.IsEmpty()) {
+    return;
+  }
+  DIR* dir = opendir("/dev");
+  if (!dir) {
+    return;
+  }
+  while (auto entry = readdir(dir)) {
+    if (strncmp(entry->d_name, "media", 5) || !entry->d_name[5] ||
+        strspn(entry->d_name + 5, "0123456789") != strlen(entry->d_name + 5)) {
+      continue;
+    }
+    nsPrintfCString path("/dev/%s", entry->d_name);
+    int fd = open(path.get(), O_RDWR | O_NONBLOCK | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) {
+      continue;
+    }
+    struct stat st;
+    struct media_v2_topology topology = {};
+    if (fstat(fd, &st) < 0 || !S_ISCHR(st.st_mode) ||
+        ioctl(fd, MEDIA_IOC_G_TOPOLOGY, &topology) < 0 ||
+        topology.num_interfaces == 0 || topology.num_interfaces > 256) {
+      close(fd);
+      continue;
+    }
+    const uint32_t count = topology.num_interfaces;
+    const uint64_t version = topology.topology_version;
+    auto interfaces = std::make_unique<media_v2_interface[]>(count);
+    topology = {};
+    topology.num_interfaces = count;
+    topology.ptr_interfaces = reinterpret_cast<uintptr_t>(interfaces.get());
+    int result = ioctl(fd, MEDIA_IOC_G_TOPOLOGY, &topology);
+    close(fd);
+    // Topology can change between queries. Fail closed, including truncation.
+    if (result < 0 || topology.topology_version != version ||
+        topology.num_interfaces != count) {
+      continue;
+    }
+    bool allowed = false;
+    for (uint32_t i = 0; i < count; ++i) {
+      const auto& intf = interfaces[i];
+      if (intf.intf_type != MEDIA_INTF_T_V4L_VIDEO ||
+          !aM2mDevices.Contains(makedev(intf.devnode.major, intf.devnode.minor))) {
+        continue;
+      }
+      allowed = true;
+      nsPrintfCString uevent("/sys/dev/char/%u:%u/uevent", intf.devnode.major,
+                             intf.devnode.minor);
+      policy->AddPath(rdonly, uevent.get());
+      UniqueFreePtr<char[]> canonical(realpath(uevent.get(), nullptr));
+      if (canonical) {
+        policy->AddPath(rdonly, canonical.get());
+      }
+    }
+    if (allowed) {
+      policy->AddPath(rdwr, path.get());
+    }
+  }
+  closedir(dir);
+}
