# Fedora targeted policy requires SELinux in the shared kernel on every Mac.
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
# Flicker-free boot, as Fedora's own kernel: fbcon takes the boot framebuffer
# only once something is printed to it, so a quiet boot shows no text cursor
# between the bootloader's logo and the splash.
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
