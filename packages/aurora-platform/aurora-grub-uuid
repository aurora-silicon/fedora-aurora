#!/bin/sh
# Bring grub.cfg's partition UUIDs up to date with the disk.
#
# Fedora's grub.cfg is generated once and then left alone (BLS entries carry
# the kernels). On a system whose ESP got a new filesystem UUID after grub.cfg
# was made, its 10_linux 'search --fs-uuid --set=boot <old>' fails on every
# boot and GRUB prints "error: ... no such device: <old>." on the screen,
# between the boot logo and the splash. GRUB still boots: the line is unused.
#
# This runs from aurora-platform-core's %posttrans. grub.cfg is regenerated only
# when every line that differs from what grub2-mkconfig produces today is such
# a 'search --fs-uuid' line, so a hand-maintained grub.cfg is never replaced.
set -u
cfg=${AURORA_GRUB_CFG:-/boot/grub2/grub.cfg}

command -v grub2-mkconfig > /dev/null || exit 0
[ -f "$cfg" ] || exit 0

current=$(mktemp) || exit 0
trap 'rm -f "$current"' EXIT
# --no-grubenv-update: without it Fedora's 10_linux rewrites every BLS entry's
# options (and /etc/kernel/cmdline) from /etc/default/grub, dropping arguments
# added with grubby, such as a J700's apple_sep.os_uuid pin.
grub2-mkconfig --no-grubenv-update > "$current" 2>/dev/null || exit 0
cmp -s "$current" "$cfg" && exit 0

# Only changed lines, no added or removed ones, and each a UUID search.
changed=$(diff "$cfg" "$current" | grep -E '^[<>]') || exit 0
[ "$(diff "$cfg" "$current" | grep -cE '^[0-9,]+c[0-9,]+$')" -gt 0 ] || exit 0
if diff "$cfg" "$current" | grep -qE '^[0-9,]+[ad][0-9,]+$'; then
    exit 0
fi
if printf '%s\n' "$changed" |
   grep -vqE '^[<>] search (--no-floppy )?--fs-uuid --set=[a-z]+ [0-9A-Fa-f-]+$'; then
    exit 0
fi

cp -p "$cfg" "$cfg.aurora-uuid"
# Rewrite in place, keeping the file's owner, mode and SELinux label.
cat "$current" > "$cfg" || cp -p "$cfg.aurora-uuid" "$cfg"
exit 0
