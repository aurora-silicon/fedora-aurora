#!/bin/sh
# aurora-kdump-setup enable|disable
#
# kdump saves Linux's own crashes to /var/crash (vmcore plus the crashed
# kernel's log); aurora-panic-log lists them. iBoot keeps no record of a
# Linux panic, so this is how one survives the restart. It is opt-in:
# installing aurora-platform-kdump runs "enable", removing it runs "disable".
#
# enable: enable kdump.service and, when the kernel command line has no
# crashkernel= yet, add kdump-utils' default size to every boot entry and to
# /etc/kernel/cmdline (kdumpctl reset-crashkernel, through grubby). The
# memory is reserved from the next boot.
# disable: disable kdump.service and remove crashkernel= again, but only if
# "enable" added it; a size the owner set stays.
set -u
state=${AURORA_KDUMP_STATE:-/var/lib/aurora/kdump-crashkernel-added}
cmdline=${AURORA_KERNEL_CMDLINE:-/etc/kernel/cmdline}

has_crashkernel() {
    [ -f "$cmdline" ] && grep -Eq '(^|[[:space:]])crashkernel=' "$cmdline"
}

case ${1:-} in
enable)
    systemctl enable kdump.service > /dev/null 2>&1 || :
    has_crashkernel && exit 0
    if kdumpctl reset-crashkernel --kernel=ALL > /dev/null 2>&1; then
        mkdir -p "${state%/*}"
        touch "$state"
        echo "aurora-kdump-setup: crash kernel memory is reserved from the next boot"
    else
        echo "aurora-kdump-setup: kdumpctl reset-crashkernel failed; run 'kdumpctl reset-crashkernel --kernel=ALL'" >&2
    fi
    ;;
disable)
    systemctl disable kdump.service > /dev/null 2>&1 || :
    [ -e "$state" ] || exit 0
    grubby --update-kernel=ALL --remove-args=crashkernel > /dev/null 2>&1 || :
    if has_crashkernel; then
        new=$(sed -E 's/(^|[[:space:]])crashkernel=[^[:space:]]*//g' "$cmdline") &&
            printf '%s\n' "$new" > "$cmdline"
    fi
    rm -f "$state"
    ;;
*)
    echo "usage: aurora-kdump-setup enable|disable" >&2
    exit 2
    ;;
esac
exit 0
