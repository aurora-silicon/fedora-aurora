#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# Keep authselect's vendor "local" profile: the installed default "local"
# profile with one change. With with-fingerprint on, its system-auth offers a
# fingerprint to every service that includes it, the console login and su
# among them. Here system-auth offers it only to the services named below;
# the lock screens keep fingerprint through fingerprint-auth, and every other
# file is a link to the default profile. authselect reads a vendor profile in
# place of the default one of the same name, so the selected profile and its
# features stay as they are.
#
# In system-auth and password-auth, a password that pam_unix accepts also
# re-arms a Touch ID lockout (pam_aurora_touchid, from aurora-touchid-rearm):
#
#   auth [success=ok new_authtok_reqd=ok default=2] pam_unix.so ...
#   -auth optional pam_aurora_touchid.so    (with with-fingerprint)
#   auth sufficient pam_permit.so
#
# replaces "auth sufficient pam_unix.so ...", and behaves as it did: a success
# ends the stack, a failure goes on to the next line. The module never changes
# the result, and the leading "-" skips it when it is not installed.
#
# The copy is rebuilt whenever this package or authselect is installed or
# updated, so it follows the installed authselect. When the default profile no
# longer has the expected fingerprint line, the vendor copy is removed and
# authselect's own profile applies. "--remove" removes it.
set -eu

default=${AURORA_AUTHSELECT_DEFAULT:-/usr/share/authselect/default/local}
vendor=${AURORA_AUTHSELECT_VENDOR:-/usr/share/authselect/vendor/local}
share=${vendor%/vendor/*}
services=sudo:sudo-i:polkit-1
marker=.aurora-sep

log() {
    echo "authselect-vendor-local: $*" >&2
}

# authselect applies a changed profile at boot only when this checksum
# changes; compute it as authselect's own package does.
refresh() {
    if [ -d "$share" ] && [ -w "$share" ]; then
        { find "$share" -mindepth 2 -type f -printf '%P\n' -exec sha256sum {} + |
            sha256sum >"$share/checksum"; } 2>/dev/null || :
    fi
    if [ -z "${AURORA_AUTHSELECT_NO_APPLY:-}" ] && command -v authselect >/dev/null 2>&1 &&
        [ -e /etc/authselect/authselect.conf ]; then
        # Rewrites the generated files, as authselect's own package does.
        authselect apply-changes >/dev/null 2>&1 ||
            log "authselect apply-changes did not run; see 'authselect check'"
    fi
}

remove() {
    rm -rf "$vendor"
}

# A copy this script did not write is left alone (an empty one is ours).
if [ -d "$vendor" ] && [ ! -e "$vendor/$marker" ] && [ -n "$(ls -A "$vendor")" ]; then
    log "$vendor is not Aurora's; leaving it alone"
    exit 0
fi

if [ "${1:-}" = --remove ]; then
    remove
    refresh
    exit 0
fi

if [ ! -f "$default/system-auth" ]; then
    log "no default local profile in $default"
    remove
    exit 0
fi

new=$vendor.new
rm -rf "$new"
mkdir -p "$new"
for f in "$default"/*; do
    case ${f##*/} in system-auth|password-auth) continue ;; esac
    ln -s "$f" "$new/${f##*/}"
done

# Copy $1 to $2 with the re-arm lines after its one "sufficient pam_unix.so".
rearm() {
    awk '
        /^auth[ \t]+sufficient[ \t]+pam_unix\.so([ \t]|$)/ {
            sub(/sufficient[ \t]+/, "[success=ok new_authtok_reqd=ok default=2]   ")
            print
            print "-auth       optional                                     pam_aurora_touchid.so {include if \"with-fingerprint\"}"
            print "auth        sufficient                                   pam_permit.so"
            n++
            next
        }
        { print }
        END { exit n != 1 }
    ' "$1" >"$2"
}
guard="auth        [success=1 default=ignore]                   pam_succeed_if.so service notin $services quiet {include if \"with-fingerprint\"}"
if ! awk -v guard="$guard" '
    /^auth[ \t]+sufficient[ \t]+pam_fprintd\.so([ \t].*)?\{include if "with-fingerprint"\}[ \t]*$/ {
        print guard
        n++
    }
    { print }
    END { exit n != 1 }
' "$default/system-auth" >"$new/system-auth"; then
    log "$default/system-auth does not have the expected pam_fprintd line; using authselect's own profile"
    rm -rf "$new"
    remove
    refresh
    exit 0
fi
if rearm "$new/system-auth" "$new/system-auth.rearm"; then
    mv "$new/system-auth.rearm" "$new/system-auth"
else
    rm -f "$new/system-auth.rearm"
    log "$default/system-auth does not have the expected pam_unix line; a password will not re-arm Touch ID there"
fi
chmod 0644 "$new/system-auth"
if [ -f "$default/password-auth" ] && rearm "$default/password-auth" "$new/password-auth"; then
    chmod 0644 "$new/password-auth"
else
    rm -f "$new/password-auth"
    [ -e "$default/password-auth" ] && ln -s "$default/password-auth" "$new/password-auth"
    log "$default/password-auth does not have the expected pam_unix line; a password will not re-arm Touch ID there"
fi
printf 'Written by %s; rebuilt from %s.\n' "$0" "$default" >"$new/$marker"
rm -rf "$vendor"
mv "$new" "$vendor"
refresh
