policy_module(aurora_sep, 1.4.2)

########################################
#
# Declarations
#

# /dev/sep-bio, the apple_sep driver's Touch ID device. The distribution
# packages build this module under the same name, so the type name has to
# match theirs: a module that drops the type leaves the node with a context
# the policy no longer knows.
type aurora_sep_device_t;
dev_node(aurora_sep_device_t)

# The apple_sep driver's own state in /var/lib: the Catacomb records, the
# identity keybag, the reference keys, the host store and the xART guard
# files. They hold enclave secrets, so they get their own type instead of
# var_lib_t, and only the domains that drive the enclave may use them.
type aurora_sep_state_t;
files_type(aurora_sep_state_t)

# /dev/sep-bio-rearm, where the driver reports the Touch ID lockout and ends
# it. Only aurora-touchid-rearm may use it, after it has verified the user's
# password.
type aurora_sep_rearm_device_t;
dev_node(aurora_sep_rearm_device_t)

# /dev/sep-key, Secure Enclave P-256 keys (OpenSSH security-key provider,
# FIDO authenticator). The kernel creates it 0600 and a udev rule grants the
# sep-key group; the enclave itself enforces each key's Touch ID policy.
type aurora_sep_key_device_t;
dev_node(aurora_sep_key_device_t)

# aurora-touchid-rearm, started by systemd for each connection to its socket.
type aurora_touchid_rearm_t;
type aurora_touchid_rearm_exec_t;
init_daemon_domain(aurora_touchid_rearm_t, aurora_touchid_rearm_exec_t)
# The unit runs with NoNewPrivileges=yes, so systemd needs the bounded
# transition into this domain.
init_nnp_daemon_domain(aurora_touchid_rearm_t)

# Its socket, which every PAM stack that accepted a password connects to.
type aurora_touchid_rearm_var_run_t;
files_pid_file(aurora_touchid_rearm_var_run_t)

# aurora-sep-load, which loads the driver and checks that the enclave seals
# and unseals a trusted key. It needs what the unconfined service domain gave
# it, so it stays unconfined; its own domain gives its probe keys their own
# label.
type aurora_sep_load_t;
type aurora_sep_load_exec_t;
init_daemon_domain(aurora_sep_load_t, aurora_sep_load_exec_t)

########################################
#
# Local policy
#

gen_require(`
	type init_t, kernel_t, var_lib_t;
')

# The driver opens its state files with kernel credentials (store_shim.c), so
# the kernel creates them. Give each new file the state type by name: a file
# that the kernel creates in /var/lib must never start out as var_lib_t.
allow kernel_t aurora_sep_state_t:file { create_file_perms rw_file_perms };
type_transition kernel_t var_lib_t:file aurora_sep_state_t "apple-sep-catacomb-master.bin";
type_transition kernel_t var_lib_t:file aurora_sep_state_t "apple-sep-catacomb-owner.bin";
type_transition kernel_t var_lib_t:file aurora_sep_state_t "apple-sep-catacomb-user.bin";
type_transition kernel_t var_lib_t:file aurora_sep_state_t "aurora-sep-keybag.bin";
type_transition kernel_t var_lib_t:file aurora_sep_state_t "aurora-sep-refkey.bin";
type_transition kernel_t var_lib_t:file aurora_sep_state_t "aurora-sep-refkey-v2.bin";
type_transition kernel_t var_lib_t:file aurora_sep_state_t "aurora-sep-host-state.bin";
type_transition kernel_t var_lib_t:file aurora_sep_state_t "aurora-sep-xart-owned.bin";
type_transition kernel_t var_lib_t:file aurora_sep_state_t "aurora-sep-xart-allow-once.bin";
type_transition kernel_t var_lib_t:file aurora_sep_state_t "aurora-sep-xart-policy-previous.bin";
type_transition kernel_t var_lib_t:file aurora_sep_state_t "aurora-sep-touchid-lockout.bin";

# Reads and writes on an open state file are checked against the task that
# drove the driver, not the opener. The loader's helpers check the files
# before they load the driver.
allow init_t aurora_sep_state_t:file read_file_perms;

# The units' helpers activate Touch ID with a read-only open and ask the
# driver about its sensor with an ioctl. Let them where they run as init_t.
allow init_t aurora_sep_device_t:chr_file { getattr open read ioctl };

# fprintd, through libfprint's aurora driver, is the device's only user.
optional_policy(`
	gen_require(`
		type fprintd_t;
	')

	allow fprintd_t aurora_sep_device_t:chr_file rw_chr_file_perms;

	# Enrolment and verification run in the context of fprintd: the driver reads
	# and writes the Catacomb records and the keybag on its behalf.
	allow fprintd_t aurora_sep_state_t:file rw_file_perms;

	# libfprint hides the reader while the lid is closed. It follows the
	# lid through the SW_LID switch of an input event device, which the
	# targeted policy keeps fprintd from reading.
	dev_read_input(fprintd_t)
')

# The OpenSSH provider runs inside the ssh client, ssh-agent and ssh-keygen.
# Unconfined users need nothing more. For the confined ssh domains: use the
# key node, and let the driver read and update its state (the identity bag,
# the lockout record) on their behalf. No open: they cannot open those files
# themselves, only the driver's own open file is read or written for them.
define(`aurora_sep_key_client',`
	optional_policy(`
		gen_require(`
			type $1;
		')

		allow $1 aurora_sep_key_device_t:chr_file rw_chr_file_perms;
		dev_list_all_dev_nodes($1)
		allow $1 aurora_sep_state_t:file { getattr read write };
	')
')
aurora_sep_key_client(ssh_t)
aurora_sep_key_client(ssh_agent_t)
aurora_sep_key_client(ssh_keygen_t)

# modprobe loads apple_sep, whose initialisation reads the keybag and the
# reference key and writes the keybag when it provisions one.
optional_policy(`
	gen_require(`
		type kmod_t;
	')

	allow kmod_t aurora_sep_state_t:file rw_file_perms;
')

# An administrator grants a one-time xART allowance by writing its file.
optional_policy(`
	gen_require(`
		type unconfined_t;
	')

	type_transition unconfined_t var_lib_t:file aurora_sep_state_t "aurora-sep-xart-allow-once.bin";
')

optional_policy(`
	unconfined_domain(aurora_sep_load_t)
')

# The probe keys and their session keyring belong to the loader alone. A root
# process that lists /proc/keys while the probe runs, such as the GDM session
# worker at an automatic login, is asked for view on each of them: their user
# view bit lets the check reach SELinux, which denies it, and the listing
# leaves them out. That denial is the intended result, so do not log it.
dontaudit domain aurora_sep_load_t:key view;

########################################
#
# aurora-touchid-rearm: ends a Touch ID lockout after a password
#

# The connection systemd accepted for it, on stdin and stdout. systemd labels
# a socket unit's sockets with the domain of the service it starts, and falls
# back to its own.
allow aurora_touchid_rearm_t { self init_t }:unix_stream_socket { getattr getopt setopt read write ioctl shutdown };

# SEP_BIO_REARM needs CAP_SYS_ADMIN; pam_unix reads /etc/shadow.
allow aurora_touchid_rearm_t self:capability { sys_admin dac_read_search };
dev_list_all_dev_nodes(aurora_touchid_rearm_t)
allow aurora_touchid_rearm_t aurora_sep_rearm_device_t:chr_file { getattr open read ioctl };

# The driver reads and rewrites its lockout record on this task's behalf.
allow aurora_touchid_rearm_t aurora_sep_state_t:file rw_file_perms;
files_search_var_lib(aurora_touchid_rearm_t)

# The password is checked again through its own PAM service.
auth_use_pam(aurora_touchid_rearm_t)
# pam_unix runs unix_chkpwd, still under NoNewPrivileges.
auth_nnp_domtrans_chkpwd(aurora_touchid_rearm_t)
auth_read_shadow(aurora_touchid_rearm_t)
logging_send_syslog_msg(aurora_touchid_rearm_t)
logging_send_audit_msgs(aurora_touchid_rearm_t)
miscfiles_read_localization(aurora_touchid_rearm_t)
files_read_etc_files(aurora_touchid_rearm_t)

# Only users with enrolled fingerprints may re-arm: it looks for their
# directory in fprintd's records.
optional_policy(`
	gen_require(`
		type fprintd_var_lib_t;
	')

	allow aurora_touchid_rearm_t fprintd_var_lib_t:dir { getattr search open read };
')

# The confined domains that run a PAM password stack connect to the socket.
# Unconfined ones (sudo for an unconfined user, Plasma's lock screen) need
# nothing more.
define(`aurora_touchid_rearm_client',`
	optional_policy(`
		gen_require(`
			type $1;
		')

		allow $1 aurora_touchid_rearm_var_run_t:sock_file write;
		allow $1 { aurora_touchid_rearm_t init_t }:unix_stream_socket connectto;
		files_search_pids($1)
	')
')
aurora_touchid_rearm_client(xdm_t)
aurora_touchid_rearm_client(policykit_auth_t)
aurora_touchid_rearm_client(local_login_t)
aurora_touchid_rearm_client(sshd_t)
