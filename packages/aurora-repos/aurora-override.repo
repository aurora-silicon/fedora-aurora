# Applies to every Aurora repository file, including one changed locally.
# The packages and the repository metadata (repomd.xml.asc) are both
# signature-checked against the key in /etc/pki/rpm-gpg.
[aurora]
repo_gpgcheck=1
# Trust that local key for the metadata without asking (libdnf5 >= 5.4.7),
# so a refresh nobody answers, such as the makecache timer, keeps the
# repository instead of skipping it.
auto_import_local_keys=1
