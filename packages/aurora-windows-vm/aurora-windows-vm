#!/usr/bin/env bash
# Launch a Windows ARM64 VM with UTM's Linux Neptune (D3D11/D3D12 over
# Vulkan) virtio-gpu backend.  This intentionally fails closed when the QEMU
# or virglrenderer build does not expose Neptune; plain virtio-gpu is not
# graphics acceleration for Windows.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: aurora-windows-vm --disk PATH [options]

Required:
  --disk PATH       Windows ARM64 disk image (raw/qcow2)

Options:
  --uefi-code PATH  AAVMF/EDK2 code image (default: /usr/share/edk2/aarch64/QEMU_EFI.fd)
  --uefi-vars PATH  writable UEFI vars image (default: alongside disk, Windows_VARS.fd)
  --memory SIZE     guest RAM (default: 8G)
  --cpus N          vCPUs (default: online host CPUs)
  --hostmem SIZE    virtio-gpu blob window (default: 4G)
  --host-prefix PATH  UTM DXVK/vkd3d library prefix (optional)
  --guest-driver-dir PATH  signed ARM64 viogpu3d package extracted from Windows build
  --qemu PATH       QEMU binary (default: qemu-system-aarch64)
  --no-gpu          launch 2D virtio-gpu for diagnostics only
  --dry-run         print the command without launching
  -h, --help        show this help

The accelerated path requires UTM QEMU with virtio-gpu-gl-pci and Neptune,
virglrenderer built with -Dneptune=true, and a Vulkan D3D12 backend. Set
NPT_D3D12_LIBRARY_PATH when libvkd3d-proton-d3d12.so is not in the loader path.
USAGE
}

qemu=${AURORA_WINDOWS_QEMU:-qemu-system-aarch64}
disk=
uefi_code=${AURORA_WINDOWS_UEFI_CODE:-/usr/share/edk2/aarch64/QEMU_EFI.fd}
uefi_vars=
mem=${AURORA_WINDOWS_MEMORY:-8G}
cpus=${AURORA_WINDOWS_CPUS:-}
hostmem=${AURORA_WINDOWS_HOSTMEM:-4G}
host_prefix=${AURORA_WINDOWS_HOST_PREFIX:-}
guest_driver_dir=${AURORA_WINDOWS_GUEST_DRIVER_DIR:-}
no_gpu=0
dry_run=0

while (($#)); do
  case $1 in
    --disk) [[ $# -ge 2 ]] || { echo "--disk needs a path" >&2; exit 2; }; disk=$2; shift 2 ;;
    --uefi-code) [[ $# -ge 2 ]] || { echo "--uefi-code needs a path" >&2; exit 2; }; uefi_code=$2; shift 2 ;;
    --uefi-vars) [[ $# -ge 2 ]] || { echo "--uefi-vars needs a path" >&2; exit 2; }; uefi_vars=$2; shift 2 ;;
    --memory) [[ $# -ge 2 ]] || { echo "--memory needs a size" >&2; exit 2; }; mem=$2; shift 2 ;;
    --cpus) [[ $# -ge 2 ]] || { echo "--cpus needs a number" >&2; exit 2; }; cpus=$2; shift 2 ;;
    --hostmem) [[ $# -ge 2 ]] || { echo "--hostmem needs a size" >&2; exit 2; }; hostmem=$2; shift 2 ;;
    --host-prefix) [[ $# -ge 2 ]] || { echo "--host-prefix needs a path" >&2; exit 2; }; host_prefix=$2; shift 2 ;;
    --guest-driver-dir) [[ $# -ge 2 ]] || { echo "--guest-driver-dir needs a path" >&2; exit 2; }; guest_driver_dir=$2; shift 2 ;;
    --qemu) [[ $# -ge 2 ]] || { echo "--qemu needs a path" >&2; exit 2; }; qemu=$2; shift 2 ;;
    --no-gpu) no_gpu=1; shift ;;
    --dry-run) dry_run=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ -n $disk ]] || { echo "aurora-windows-vm: --disk is required" >&2; exit 2; }
[[ -f $disk ]] || { echo "aurora-windows-vm: disk does not exist: $disk" >&2; exit 1; }
command -v "$qemu" >/dev/null 2>&1 || { echo "aurora-windows-vm: QEMU not found: $qemu" >&2; exit 1; }
[[ -f $uefi_code ]] || { echo "aurora-windows-vm: UEFI code does not exist: $uefi_code" >&2; exit 1; }
if [[ -z $cpus ]]; then
  # QEMU's -smp option accepts an integer; the string "host" is not a valid
  # shorthand (unlike -cpu host).  Match the host's online CPU count while
  # retaining a deterministic fallback for minimal containers.
  cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)
  [[ $cpus =~ ^[1-9][0-9]*$ ]] || cpus=4
fi
[[ $cpus =~ ^[1-9][0-9]*$ ]] || {
  echo "aurora-windows-vm: --cpus must be a positive integer (got '$cpus')" >&2
  exit 2
}
if [[ -z $uefi_vars ]]; then
  uefi_vars="${disk%/*}/Windows_VARS.fd"
  [[ $uefi_vars != "$disk" ]] || uefi_vars=Windows_VARS.fd
fi
if [[ ! -e $uefi_vars ]]; then
  # QEMU needs a writable vars image.  Prefer the distro template when one is
  # available; never truncate an existing vars file.
  vars_template=${AURORA_WINDOWS_UEFI_VARS_TEMPLATE:-/usr/share/edk2/aarch64/vars-template-pflash.raw}
  if [[ ! -f $vars_template ]]; then
    vars_template=/usr/share/edk2/aarch64/QEMU_VARS.fd
  fi
  [[ -f $vars_template ]] || { echo "aurora-windows-vm: UEFI vars template missing; pass --uefi-vars" >&2; exit 1; }
  cp -- "$vars_template" "$uefi_vars"
fi

args=("$qemu" -machine virt,accel=kvm -cpu host -smp "$cpus" -m "$mem"
  -drive "if=pflash,format=raw,readonly=on,file=$uefi_code"
  -drive "if=pflash,format=raw,file=$uefi_vars"
  -drive "if=none,id=windows-disk,format=raw,file=$disk"
  -device virtio-blk-pci,drive=windows-disk,disable-legacy=on,romfile=
  -device virtio-net-pci,netdev=windows-net,romfile=
  -netdev user,id=windows-net
  -device qemu-xhci -device usb-kbd -device usb-tablet
  -display gtk,gl=on)

if ((no_gpu)); then
  args+=( -device virtio-gpu-pci,blob=off,romfile= )
else
  # Neptune is UTM's D3D11/D3D12 protocol.  Venus alone only accelerates
  # Vulkan applications and does not register a Windows D3D adapter.
  # A private UTM build is normally installed as one prefix, so QEMU itself
  # also needs that prefix on the dynamic loader path (the backend search
  # below only locates DXVK/vkd3d libraries).  Preserve any caller-provided
  # loader directories after the private prefix.
  if [[ -n $host_prefix ]]; then
    loader_dirs=()
    for loader_dir in "$host_prefix/lib" "$host_prefix/lib64"; do
      [[ -d $loader_dir ]] && loader_dirs+=("$loader_dir")
    done
    if ((${#loader_dirs[@]})); then
      loader_prefix=$(IFS=:; printf '%s' "${loader_dirs[*]}")
      export LD_LIBRARY_PATH="$loader_prefix${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    fi
  fi
  if ! "$qemu" -device virtio-gpu-gl-pci,help 2>&1 | grep -q 'neptune'; then
    cat >&2 <<'MSG'
aurora-windows-vm: this QEMU has no Neptune virtio-gpu backend.
Install/build UTM's QEMU (utm-edition) and virglrenderer (staging/neptune-linux)
with -Dneptune=true, then pass --qemu /path/to/qemu-system-aarch64.
Plain virtio-gpu is 2D only and will not provide Windows GPU acceleration.
MSG
    exit 1
  fi
  [[ -n $guest_driver_dir && -d $guest_driver_dir ]] || {
    echo "aurora-windows-vm: signed ARM64 viogpu3d package is required for accelerated Windows" >&2
    echo "Pass --guest-driver-dir with the Windows WDK package containing viogpu3d.cat and Neptune/Venus DLLs." >&2
    exit 1
  }
  for required in viogpu3d.sys viogpu3d.inf viogpu3d.cat neptune_umd.dll vulkan_virtio.dll virtio_icd.json driver-signature.txt; do
    [[ -f $guest_driver_dir/$required ]] || {
      echo "aurora-windows-vm: guest driver package is incomplete (missing $required)" >&2
      exit 1
    }
  done
  grep -Eiq '^Authenticode=valid$' "$guest_driver_dir/driver-signature.txt" || {
    echo "aurora-windows-vm: driver-signature.txt does not prove a valid Authenticode catalog signature" >&2
    echo "Verify with Windows signtool before copying the package to the host." >&2
    exit 1
  }
  grep -Eiq '^Architecture=ARM64$' "$guest_driver_dir/driver-signature.txt" || {
    echo "aurora-windows-vm: guest driver signature record is not for ARM64" >&2
    exit 1
  }
  if command -v file >/dev/null 2>&1; then
    file "$guest_driver_dir/viogpu3d.sys" | grep -Eiq 'arm64|aarch64' || {
      echo "aurora-windows-vm: viogpu3d.sys is not identified as ARM64" >&2
      exit 1
    }
  fi
  search_lib() {
    local variable=$1 default=$2 alternate=${3:-$2} candidate
    if [[ -n ${!variable:-} ]]; then
      [[ -f ${!variable} ]] || { echo "aurora-windows-vm: $variable points to a missing file: ${!variable}" >&2; exit 1; }
      return
    fi
    local -a candidates=()
    if [[ -n $host_prefix ]]; then
      candidates+=("$host_prefix/lib/$default" "$host_prefix/lib64/$default")
      candidates+=("$host_prefix/lib/$alternate" "$host_prefix/lib64/$alternate")
    fi
    candidates+=(/usr/lib/$default /usr/lib64/$default /usr/local/lib/$default
                  /usr/lib/$alternate /usr/lib64/$alternate /usr/local/lib/$alternate)
    for candidate in "${candidates[@]}"; do
      if [[ -f $candidate ]]; then export "$variable=$candidate"; return; fi
    done
    echo "aurora-windows-vm: $default or $alternate is required for Linux/Vulkan Neptune" >&2
    echo "Set $variable to the host backend library." >&2
    exit 1
  }
  search_lib NPT_D3D11_LIBRARY_PATH libd3d11.so libdxvk_d3d11.so
  search_lib NPT_DXGI_LIBRARY_PATH libdxgi.so libdxvk_dxgi.so
  search_lib NPT_D3D12_LIBRARY_PATH libvkd3d-proton-d3d12.so
  args+=( -device "virtio-gpu-gl-pci,hostmem=$hostmem,blob=on,neptune=on" )
fi

printf 'Aurora Windows VM:'
printf ' %q' "${args[@]}"
printf '\n'
if ((dry_run)); then exit 0; fi
exec "${args[@]}"
