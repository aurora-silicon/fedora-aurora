index e209c785..64a77a3f 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -260,13 +260,16 @@ if with_neptune
       # so the renderer must not gain a NEEDED entry on libdxvk_*.
       dxvk_dep = dependency('dxvk-dxgi').partial_dependency(
          compile_args : true, includes : true)
-      # The shared-resource descriptor contract is a fork-only extension;
-      # bail early rather than fail to compile a Neptune source file.
-      if not cc.has_header('dxvk_shared_resource.h', dependencies : dxvk_dep)
-         error('Neptune requires the dxvk with shared-resource descriptors; ' +
-               'dxvk_shared_resource.h not found via dxvk-dxgi pkg-config.')
+      # The pinned DXVK native fork now takes its shared-resource descriptors
+      # from the directx-native ABI.  Keep the dependency headers-only: the
+      # Neptune worker dlopens DXVK and must not gain a NEEDED entry on it.
+      dxn_dep = dependency('directx-native-headers',
+         fallback : ['directx-native', 'directx_native_headers_dep'])
+      if not cc.has_header('directx-native/dxn_shared.h', dependencies : dxn_dep)
+         error('Neptune requires directx-native shared-resource descriptors; ' +
+               'directx-native/dxn_shared.h was not found.')
       endif
-      virgl_depends += [dxvk_dep]
+      virgl_depends += [dxvk_dep, dxn_dep]
    endif
 endif
 
