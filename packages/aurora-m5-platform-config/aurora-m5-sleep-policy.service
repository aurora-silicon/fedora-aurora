# Install the logind lid policy when the kernel selected deep sleep.
# logind uses the policy on machines that report a lid switch.
[Unit]
Description=Lid policy for kernel-selected deep sleep
Documentation=file:///usr/share/doc/aurora-m5-platform-config/README.md
DefaultDependencies=no
Before=sysinit.target systemd-logind.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Complete the start even when no policy is needed, so repeated dependency
# starts during sysinit cannot exhaust the unit's start rate limit.
ExecStart=/usr/bin/sh -ec 'if /usr/bin/grep -Fq "[deep]" /sys/power/mem_sleep 2>/dev/null; then exec /usr/bin/install -D -m 0644 /usr/share/aurora-m5-platform-config/90-aurora-m5-lid.conf /run/systemd/logind.conf.d/90-aurora-m5-lid.conf; fi'
