policy_module(speakerguardd, 1.0.0)

########################################
#
# Declarations
#

# The speakerguardd 1.0 supervisor. The type names match the policy in the
# speakerguardd source tree, so this module and that one label the same
# things the same way.
type speakerguardd_t;
type speakerguardd_exec_t;
init_daemon_domain(speakerguardd_t, speakerguardd_exec_t)

# /run/speakerguardd: the parameter blob the plugin loads, and one directory
# per session user holding that user's engine page (shared memory) and the
# session helper's report.
type speakerguardd_runtime_t;
files_pid_file(speakerguardd_runtime_t)

########################################
#
# Local policy
#

# chown and chmod hand each engine page to its session user; SCHED_FIFO and
# mlockall keep the 10 ms supervision tick on time.
allow speakerguardd_t self:capability { chown fowner sys_nice ipc_lock };
allow speakerguardd_t self:process { getsched setsched };
allow speakerguardd_t self:fifo_file rw_fifo_file_perms;
allow speakerguardd_t self:unix_stream_socket create_stream_socket_perms;
allow speakerguardd_t self:unix_dgram_socket create_socket_perms;

# The runtime directory: systemd creates it as RuntimeDirectory=; a
# directory or file the daemon creates under /run gets the runtime type too.
manage_dirs_pattern(speakerguardd_t, speakerguardd_runtime_t, speakerguardd_runtime_t)
manage_files_pattern(speakerguardd_t, speakerguardd_runtime_t, speakerguardd_runtime_t)
allow speakerguardd_t speakerguardd_runtime_t:file map;
files_pid_filetrans(speakerguardd_t, speakerguardd_runtime_t, { dir file })

# The speaker card's control device: "Speaker Protection" ownership, the
# lease and the amplifier's operating point.
dev_read_sound(speakerguardd_t)
dev_write_sound(speakerguardd_t)

# The speaker PCM's status in /proc/asound.
kernel_read_system_state(speakerguardd_t)

# The tuning bundle the installer stores with the vendor firmware, and its
# copy on the EFI system partition.
files_read_usr_files(speakerguardd_t)
files_search_boot(speakerguardd_t)
files_read_boot_files(speakerguardd_t)
fs_search_dos(speakerguardd_t)
fs_list_dos(speakerguardd_t)
fs_read_dos_files(speakerguardd_t)
dev_read_sysfs(speakerguardd_t)

# Start-up and diagnostics on stderr, which goes to the journal.
libs_use_ld_so(speakerguardd_t)
libs_use_shared_libs(speakerguardd_t)
miscfiles_read_localization(speakerguardd_t)
logging_send_syslog_msg(speakerguardd_t)

# The plugin runs in the session user's PipeWire, in that user's domain: it
# reads the parameters and maps its engine page read-write. Unconfined users
# may already; this covers the confined user domains too.
gen_require(`
	attribute login_userdomain;
')
allow login_userdomain speakerguardd_runtime_t:dir search_dir_perms;
allow login_userdomain speakerguardd_runtime_t:file { rw_file_perms map };
