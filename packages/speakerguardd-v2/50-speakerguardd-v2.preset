# speakerguardd 1.0 is the only speaker stack and is installed on every Mac.
# The gate (speakerguardd-gate, ExecCondition of the units) starts it on a
# qualified board whose kernel has the v2 interface; elsewhere no speaker
# daemon runs and the kernel holds the speakers at its floor.
enable speakerguardd-v2.service
enable speakerguardd-v2-provision.service
enable speakerguardd-v2-selfcheck.service
enable speakerguardd-v2-switchtest.service
enable speakerguardd-v2-seat.path
enable speakerguardd-v2-sleep.service
