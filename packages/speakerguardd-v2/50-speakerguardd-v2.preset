# speakerguardd 1.0 is installed on every Mac; the fleet gate
# (speakerguardd-gate, ExecCondition of each unit) picks v2 or the older
# daemons at every boot, so enabling the units changes nothing on a board
# or kernel v2 does not run on.
enable speakerguardd-v2.service
enable speakerguardd-v2-provision.service
enable speakerguardd-v2-selfcheck.service
enable speakerguardd-v2-seat.path
enable speakerguardd-v2-sleep.service
