diff --git a/src/tests/wayland-test-clients/session-lock.c b/src/tests/wayland-test-clients/session-lock.c
new file mode 100644
index 0000000..3e2de39
--- /dev/null
+++ b/src/tests/wayland-test-clients/session-lock.c
@@ -0,0 +1,585 @@
+/*
