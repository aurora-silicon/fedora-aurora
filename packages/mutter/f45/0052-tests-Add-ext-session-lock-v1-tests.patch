+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "config.h"
+
+#include <errno.h>
+#include <glib.h>
+#include <string.h>
+#include <wayland-client.h>
+
+#include "wayland-test-client-utils.h"
+
+#include "ext-session-lock-v1-client-protocol.h"
+
+/* Must match the colors in wayland-session-lock-tests.c */
+#define NORMAL_COLOR 0xffff0000
+#define LOCK_COLOR 0xff0000ff
+
+/* Sync points sent to the test */
+#define SYNC_NORMAL_SHOWN 1
+#define SYNC_LOCKED 2
+#define SYNC_FINISHED 3
+#define SYNC_UNLOCKED 4
+#define SYNC_DRAWN_BASE 10 /* + number of outputs with a drawn lock surface */
+
+/* Sync events sent by the test. They go to every client, so each kind of
+ * client waits for its own value. */
+#define EVENT_UNLOCK 100
+#define EVENT_EXIT_NORMAL 200
+#define EVENT_EXIT_ABANDON 300
+
+typedef struct _Output
+{
+  uint32_t name;
+  struct wl_output *wl_output;
+  struct wl_surface *surface;
+  struct ext_session_lock_surface_v1 *lock_surface;
+  gboolean drawn;
+} Output;
+
+static WaylandDisplay *display;
+static struct wl_registry *registry;
+static struct ext_session_lock_manager_v1 *lock_manager;
+static struct ext_session_lock_v1 *lock;
+static GList *outputs;
+static gboolean locked;
+static gboolean finished;
+static gboolean create_lock_surfaces = TRUE;
+static int last_drawn_report;
+
+static GHashTable *commands;
+
+static void
+on_command (WaylandDisplay *wayland_display,
+            uint32_t        serial,
+            gpointer        user_data)
+{
+  g_hash_table_add (commands, GUINT_TO_POINTER (serial));
+}
+
+/* Commands are recorded from the moment the client connected, so one sent
+ * while the client was busy with something else is not lost. */
+static void
+wait_for_command (uint32_t command)
+{
+  while (!g_hash_table_contains (commands, GUINT_TO_POINTER (command)))
+    wayland_display_dispatch (display);
+}
+
+static void
+report_drawn (void)
+{
+  GList *l;
+  int n_drawn = 0;
+
+  for (l = outputs; l; l = l->next)
+    {
+      Output *output = l->data;
+
+      if (!output->drawn)
+        return;
+      n_drawn++;
+    }
+
+  if (n_drawn == last_drawn_report)
+    return;
+
+  last_drawn_report = n_drawn;
+  test_driver_sync_point (display->test_driver, SYNC_DRAWN_BASE + n_drawn,
+                          NULL);
+}
+
+static void
+handle_lock_surface_configure (void                               *data,
+                               struct ext_session_lock_surface_v1 *lock_surface,
+                               uint32_t                            serial,
+                               uint32_t                            width,
+                               uint32_t                            height)
+{
+  Output *output = data;
+
+  ext_session_lock_surface_v1_ack_configure (lock_surface, serial);
+  draw_surface (display, output->surface, width, height, LOCK_COLOR);
+  wl_surface_commit (output->surface);
+  output->drawn = TRUE;
+  report_drawn ();
+}
+
+static const struct ext_session_lock_surface_v1_listener lock_surface_listener = {
+  handle_lock_surface_configure,
+};
+
+static void
+create_lock_surface (Output *output)
+{
+  if (!lock || finished || output->lock_surface)
+    return;
+
+  output->surface = wl_compositor_create_surface (display->compositor);
+  output->lock_surface =
+    ext_session_lock_v1_get_lock_surface (lock, output->surface,
+                                          output->wl_output);
+  ext_session_lock_surface_v1_add_listener (output->lock_surface,
+                                            &lock_surface_listener, output);
+}
+
+static void
+destroy_output (Output *output)
+{
+  g_clear_pointer (&output->lock_surface,
+                   ext_session_lock_surface_v1_destroy);
+  g_clear_pointer (&output->surface, wl_surface_destroy);
+  g_clear_pointer (&output->wl_output, wl_output_release);
+  g_free (output);
+}
+
+static void
+handle_locked (void                       *data,
+               struct ext_session_lock_v1 *lock_object)
+{
+  locked = TRUE;
+  test_driver_sync_point (display->test_driver, SYNC_LOCKED, NULL);
+}
+
+static void
+handle_finished (void                       *data,
+                 struct ext_session_lock_v1 *lock_object)
+{
+  finished = TRUE;
+  test_driver_sync_point (display->test_driver, SYNC_FINISHED, NULL);
+}
+
+static const struct ext_session_lock_v1_listener lock_listener = {
+  handle_locked,
+  handle_finished,
+};
+
+static void
+handle_registry_global (void               *user_data,
+                        struct wl_registry *wl_registry,
+                        uint32_t            name,
+                        const char         *interface,
+                        uint32_t            version)
+{
+  if (strcmp (interface, ext_session_lock_manager_v1_interface.name) == 0)
+    {
+      lock_manager =
+        wl_registry_bind (wl_registry, name,
+                          &ext_session_lock_manager_v1_interface, 1);
+    }
+  else if (strcmp (interface, wl_output_interface.name) == 0)
+    {
+      Output *output = g_new0 (Output, 1);
+
+      output->name = name;
+      output->wl_output = wl_registry_bind (wl_registry, name,
+                                            &wl_output_interface, 3);
+      outputs = g_list_append (outputs, output);
+
+      if (create_lock_surfaces)
+        create_lock_surface (output);
+    }
+}
+
+static void
+handle_registry_global_remove (void               *user_data,
+                               struct wl_registry *wl_registry,
+                               uint32_t            name)
+{
+  GList *l;
+
+  for (l = outputs; l; l = l->next)
+    {
+      Output *output = l->data;
+
+      if (output->name == name)
+        {
+          outputs = g_list_delete_link (outputs, l);
+          destroy_output (output);
+          last_drawn_report = 0;
+          report_drawn ();
+          return;
+        }
+    }
+}
+
+static const struct wl_registry_listener registry_listener = {
+  handle_registry_global,
+  handle_registry_global_remove,
+};
+
+static void
+connect_display (void)
+{
+  display = wayland_display_new (WAYLAND_DISPLAY_CAPABILITY_TEST_DRIVER);
+  commands = g_hash_table_new (NULL, NULL);
+  g_signal_connect (display, "sync-event", G_CALLBACK (on_command), NULL);
+  registry = wl_display_get_registry (display->display);
+  wl_registry_add_listener (registry, &registry_listener, NULL);
+  wl_display_roundtrip (display->display);
+  wl_display_roundtrip (display->display);
+
+  g_assert_nonnull (lock_manager);
+  g_assert_nonnull (outputs);
+}
+
+static void
+start_lock (void)
+{
+  GList *l;
+
+  lock = ext_session_lock_manager_v1_lock (lock_manager);
+  ext_session_lock_v1_add_listener (lock, &lock_listener, NULL);
+
+  if (create_lock_surfaces)
+    {
+      for (l = outputs; l; l = l->next)
+        create_lock_surface (l->data);
+    }
+}
+
+static void
+wait_for_locked (void)
+{
+  while (!locked && !finished)
+    wayland_display_dispatch (display);
+
+  g_assert_true (locked);
+}
+
+static void
+unlock (void)
+{
+  ext_session_lock_v1_unlock_and_destroy (lock);
+  lock = NULL;
+  wl_display_roundtrip (display->display);
+  test_driver_sync_point (display->test_driver, SYNC_UNLOCKED, NULL);
+  wl_display_roundtrip (display->display);
+}
+
+static int
+expect_protocol_error (const struct wl_interface *interface,
+                       uint32_t                   code)
+{
+  const struct wl_interface *error_interface = NULL;
+  uint32_t error_code;
+
+  while (wl_display_roundtrip (display->display) != -1)
+    ;
+
+  g_assert_cmpint (wl_display_get_error (display->display), ==, EPROTO);
+  error_code = wl_display_get_protocol_error (display->display,
+                                              &error_interface, NULL);
+  /* After a destructor request the proxy is gone, so libwayland can't name
+   * the interface; only the code is checked then. */
+  if (interface)
+    {
+      g_assert_nonnull (error_interface);
+      g_assert_cmpstr (error_interface->name, ==, interface->name);
+    }
+  g_assert_cmpuint (error_code, ==, code);
+
+  return EXIT_SUCCESS;
+}
+
+/* Lock, draw on every output (also outputs added later), unlock when
+ * asked. */
+static int
+run_lock (void)
+{
+  start_lock ();
+  wait_for_locked ();
+  wait_for_command (EVENT_UNLOCK);
+  unlock ();
+  return EXIT_SUCCESS;
+}
+
+/* Lock, draw, then go away without unlocking. */
+static int
+run_abandon (void)
+{
+  start_lock ();
+  wait_for_locked ();
+  while (last_drawn_report == 0)
+    wayland_display_dispatch (display);
+  wait_for_command (EVENT_EXIT_ABANDON);
+  return EXIT_SUCCESS;
+}
+
+/* Another client holds the lock: this one must get finished. */
+static int
+run_second (void)
+{
+  create_lock_surfaces = FALSE;
+  start_lock ();
+  while (!finished && !locked)
+    wayland_display_dispatch (display);
+  g_assert_true (finished);
+  g_assert_false (locked);
+
+  /* Lock surfaces on a finished lock are inert. */
+  create_lock_surfaces = TRUE;
+  create_lock_surface (outputs->data);
+  ext_session_lock_v1_destroy (lock);
+  lock = NULL;
+  wl_display_roundtrip (display->display);
+  g_assert_cmpint (wl_display_get_error (display->display), ==, 0);
+  return EXIT_SUCCESS;
+}
+
+/* Lock and give up before the locked event. */
+static int
+run_cancel (void)
+{
+  start_lock ();
+  ext_session_lock_v1_destroy (lock);
+  lock = NULL;
+  wl_display_roundtrip (display->display);
+  g_assert_false (locked);
+  g_assert_cmpint (wl_display_get_error (display->display), ==, 0);
+  test_driver_sync_point (display->test_driver, SYNC_UNLOCKED, NULL);
+  wl_display_roundtrip (display->display);
+  return EXIT_SUCCESS;
+}
+
+/* A normal fullscreen toplevel (the content that must never show while
+ * locked). */
+static int
+run_normal (void)
+{
+  WaylandSurface *surface;
+
+  surface = wayland_surface_new (display, "normal", 100, 100, NORMAL_COLOR);
+  xdg_toplevel_set_fullscreen (surface->xdg_toplevel, NULL);
+  wl_surface_commit (surface->wl_surface);
+  wait_for_window_shown (display, surface->wl_surface);
+  wait_for_effects_completed (display, surface->wl_surface);
+  test_driver_sync_point (display->test_driver, SYNC_NORMAL_SHOWN, NULL);
+  wait_for_command (EVENT_EXIT_NORMAL);
+  g_object_unref (surface);
+  return EXIT_SUCCESS;
+}
+
+static Output *
+first_output (void)
+{
+  return outputs->data;
+}
+
+static struct ext_session_lock_surface_v1 *
+get_raw_lock_surface (struct wl_surface *surface,
+                      Output            *output,
+                      uint32_t          *serial,
+                      int               *width,
+                      int               *height);
+
+typedef struct _RawConfigure
+{
+  gboolean configured;
+  uint32_t serial;
+  int width;
+  int height;
+} RawConfigure;
+
+static void
+handle_raw_configure (void                               *data,
+                      struct ext_session_lock_surface_v1 *lock_surface,
+                      uint32_t                            serial,
+                      uint32_t                            width,
+                      uint32_t                            height)
+{
+  RawConfigure *configure = data;
+
+  configure->configured = TRUE;
+  configure->serial = serial;
+  configure->width = width;
+  configure->height = height;
+}
+
+static const struct ext_session_lock_surface_v1_listener raw_listener = {
+  handle_raw_configure,
+};
+
+static struct ext_session_lock_surface_v1 *
+get_raw_lock_surface (struct wl_surface *surface,
+                      Output            *output,
+                      uint32_t          *serial,
+                      int               *width,
+                      int               *height)
+{
+  static RawConfigure configure;
+  struct ext_session_lock_surface_v1 *lock_surface;
+
+  configure = (RawConfigure) { 0 };
+  lock_surface = ext_session_lock_v1_get_lock_surface (lock, surface,
+                                                       output->wl_output);
+  ext_session_lock_surface_v1_add_listener (lock_surface, &raw_listener,
+                                            &configure);
+  while (!configure.configured)
+    wayland_display_dispatch (display);
+
+  *serial = configure.serial;
+  *width = configure.width;
+  *height = configure.height;
+  return lock_surface;
+}
+
+static int
+run_error (const char *error)
+{
+  struct wl_surface *surface;
+  struct ext_session_lock_surface_v1 *lock_surface;
+  uint32_t serial;
+  int width, height;
+
+  create_lock_surfaces = FALSE;
+  start_lock ();
+
+  if (g_strcmp0 (error, "invalid-unlock") == 0)
+    {
+      /* In the same flush as lock: the locked event can't be sent yet. */
+      ext_session_lock_v1_unlock_and_destroy (lock);
+      return expect_protocol_error (NULL,
+                                    EXT_SESSION_LOCK_V1_ERROR_INVALID_UNLOCK);
+    }
+
+  wait_for_locked ();
+  surface = wl_compositor_create_surface (display->compositor);
+
+  if (g_strcmp0 (error, "invalid-destroy") == 0)
+    {
+      ext_session_lock_v1_destroy (lock);
+      return expect_protocol_error (NULL,
+                                    EXT_SESSION_LOCK_V1_ERROR_INVALID_DESTROY);
+    }
+  else if (g_strcmp0 (error, "role") == 0)
+    {
+      struct xdg_surface *xdg_surface =
+        xdg_wm_base_get_xdg_surface (display->xdg_wm_base, surface);
+
+      xdg_surface_get_toplevel (xdg_surface);
+      ext_session_lock_v1_get_lock_surface (lock, surface,
+                                            first_output ()->wl_output);
+      return expect_protocol_error (&ext_session_lock_v1_interface,
+                                    EXT_SESSION_LOCK_V1_ERROR_ROLE);
+    }
+  else if (g_strcmp0 (error, "role-twice") == 0)
+    {
+      ext_session_lock_v1_get_lock_surface (lock, surface,
+                                            first_output ()->wl_output);
+      ext_session_lock_v1_get_lock_surface (lock, surface,
+                                            first_output ()->wl_output);
+      return expect_protocol_error (&ext_session_lock_v1_interface,
+                                    EXT_SESSION_LOCK_V1_ERROR_ROLE);
+    }
+  else if (g_strcmp0 (error, "duplicate-output") == 0)
+    {
+      struct wl_surface *other =
+        wl_compositor_create_surface (display->compositor);
+
+      ext_session_lock_v1_get_lock_surface (lock, surface,
+                                            first_output ()->wl_output);
+      ext_session_lock_v1_get_lock_surface (lock, other,
+                                            first_output ()->wl_output);
+      return expect_protocol_error (&ext_session_lock_v1_interface,
+                                    EXT_SESSION_LOCK_V1_ERROR_DUPLICATE_OUTPUT);
+    }
+  else if (g_strcmp0 (error, "already-constructed") == 0)
+    {
+      draw_surface (display, surface, 64, 64, LOCK_COLOR);
+      wl_surface_commit (surface);
+      ext_session_lock_v1_get_lock_surface (lock, surface,
+                                            first_output ()->wl_output);
+      return expect_protocol_error (&ext_session_lock_v1_interface,
+                                    EXT_SESSION_LOCK_V1_ERROR_ALREADY_CONSTRUCTED);
+    }
+  else if (g_strcmp0 (error, "commit-before-ack") == 0)
+    {
+      lock_surface = get_raw_lock_surface (surface, first_output (),
+                                           &serial, &width, &height);
+      draw_surface (display, surface, width, height, LOCK_COLOR);
+      wl_surface_commit (surface);
+      return expect_protocol_error (&ext_session_lock_surface_v1_interface,
+                                    EXT_SESSION_LOCK_SURFACE_V1_ERROR_COMMIT_BEFORE_FIRST_ACK);
+    }
+  else if (g_strcmp0 (error, "null-buffer") == 0)
+    {
+      lock_surface = get_raw_lock_surface (surface, first_output (),
+                                           &serial, &width, &height);
+      ext_session_lock_surface_v1_ack_configure (lock_surface, serial);
+      wl_surface_commit (surface);
+      return expect_protocol_error (&ext_session_lock_surface_v1_interface,
+                                    EXT_SESSION_LOCK_SURFACE_V1_ERROR_NULL_BUFFER);
+    }
+  else if (g_strcmp0 (error, "dimensions-mismatch") == 0)
+    {
+      lock_surface = get_raw_lock_surface (surface, first_output (),
+                                           &serial, &width, &height);
+      ext_session_lock_surface_v1_ack_configure (lock_surface, serial);
+      draw_surface (display, surface, width / 2, height / 2, LOCK_COLOR);
+      wl_surface_commit (surface);
+      return expect_protocol_error (&ext_session_lock_surface_v1_interface,
+                                    EXT_SESSION_LOCK_SURFACE_V1_ERROR_DIMENSIONS_MISMATCH);
+    }
+  else if (g_strcmp0 (error, "invalid-serial") == 0)
+    {
+      lock_surface = get_raw_lock_surface (surface, first_output (),
+                                           &serial, &width, &height);
+      ext_session_lock_surface_v1_ack_configure (lock_surface, serial + 100);
+      return expect_protocol_error (&ext_session_lock_surface_v1_interface,
+                                    EXT_SESSION_LOCK_SURFACE_V1_ERROR_INVALID_SERIAL);
+    }
+  else if (g_strcmp0 (error, "ack-twice") == 0)
+    {
+      lock_surface = get_raw_lock_surface (surface, first_output (),
+                                           &serial, &width, &height);
+      ext_session_lock_surface_v1_ack_configure (lock_surface, serial);
+      ext_session_lock_surface_v1_ack_configure (lock_surface, serial);
+      return expect_protocol_error (&ext_session_lock_surface_v1_interface,
+                                    EXT_SESSION_LOCK_SURFACE_V1_ERROR_INVALID_SERIAL);
+    }
+
+  g_error ("Unknown error mode %s", error);
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  const char *mode;
+
+  g_assert_cmpint (argc, ==, 2);
+  mode = argv[1];
+
+  connect_display ();
+
+  if (g_strcmp0 (mode, "normal") == 0)
+    return run_normal ();
+  else if (g_strcmp0 (mode, "lock") == 0)
+    return run_lock ();
+  else if (g_strcmp0 (mode, "abandon") == 0)
+    return run_abandon ();
+  else if (g_strcmp0 (mode, "second") == 0)
+    return run_second ();
+  else if (g_strcmp0 (mode, "cancel") == 0)
+    return run_cancel ();
+  else if (g_str_has_prefix (mode, "error-"))
+    return run_error (mode + strlen ("error-"));
+
+  g_error ("Unknown mode %s", mode);
+}
