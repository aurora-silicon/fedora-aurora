+/*
+ * ext-session-lock-v1 tests. Every frame of every view is read back from
+ * its onscreen framebuffer. While the session is locked, a frame may only
+ * contain the black blank and the blue lock surfaces: any other pixel (the
+ * red client, the desktop background, anything) counts as a leak, and
+ * every test asserts there were none.
+ */
+
+#include "config.h"
+
+#include <cairo.h>
+#include <math.h>
+
+#include "backends/meta-monitor-manager-private.h"
+#include "backends/meta-renderer.h"
+#include "compositor/compositor-private.h"
+#include "meta-test/meta-context-test.h"
+#include "tests/meta-monitor-manager-test.h"
+#include "tests/meta-monitor-test-utils.h"
+#include "tests/meta-test-utils.h"
+#include "tests/meta-wayland-test-driver.h"
+#include "tests/meta-wayland-test-utils.h"
+#include "wayland/meta-wayland-keyboard.h"
+#include "wayland/meta-wayland-pointer.h"
+#include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-seat.h"
+#include "wayland/meta-wayland-session-lock.h"
+#include "wayland/meta-wayland-surface-private.h"
+
+/* Must match the test client. */
+#define SYNC_NORMAL_SHOWN 1
+#define SYNC_LOCKED 2
+#define SYNC_FINISHED 3
+#define SYNC_UNLOCKED 4
+#define SYNC_DRAWN_BASE 10
+#define EVENT_UNLOCK 100
+#define EVENT_EXIT_NORMAL 200
+#define EVENT_EXIT_ABANDON 300
+
+#define CURSOR_BOX 64
+
+#define MONITOR_WIDTH 1024
+#define MONITOR_HEIGHT 768
+
+typedef struct _FrameStats
+{
+  int64_t red;   /* the normal client */
+  int64_t green;
+  int64_t blue;  /* lock surfaces */
+  int64_t black; /* the blank */
+  int64_t other;
+  int64_t cursor; /* not counted, see on_after_paint () */
+  int width;
+  int height;
+  uint32_t sample;
+} FrameStats;
+
+static MetaContext *test_context;
+static MetaWaylandTestDriver *test_driver;
+static GHashTable *sync_points;
+
+static GHashTable *last_frames; /* ClutterStageView -> FrameStats */
+static const char *dump_label;
+static int64_t n_frames;
+static int64_t n_locked_frames;
+static int64_t n_leaked_frames;
+
+static MonitorTestCaseSetup one_monitor = {
+  .modes = {
+    {
+      .width = MONITOR_WIDTH,
+      .height = MONITOR_HEIGHT,
+      .refresh_rate = 60.0
+    }
+  },
+  .n_modes = 1,
+  .outputs = {
+     {
+      .crtc = 0,
+      .modes = { 0 },
+      .n_modes = 1,
+      .preferred_mode = 0,
+      .possible_crtcs = { 0 },
+      .n_possible_crtcs = 1,
+      .width_mm = 222,
+      .height_mm = 125,
+      .serial = "session-lock-1",
+    },
+  },
+  .n_outputs = 1,
+  .crtcs = {
+    {
+      .current_mode = 0
+    },
+  },
+  .n_crtcs = 1
+};
+
+static MonitorTestCaseSetup two_monitors = {
+  .modes = {
+    {
+      .width = MONITOR_WIDTH,
+      .height = MONITOR_HEIGHT,
+      .refresh_rate = 60.0
+    }
+  },
+  .n_modes = 1,
+  .outputs = {
+     {
+      .crtc = 0,
+      .modes = { 0 },
+      .n_modes = 1,
+      .preferred_mode = 0,
+      .possible_crtcs = { 0 },
+      .n_possible_crtcs = 1,
+      .width_mm = 222,
+      .height_mm = 125,
+      .serial = "session-lock-1",
+    },
+     {
+      .crtc = 1,
+      .modes = { 0 },
+      .n_modes = 1,
+      .preferred_mode = 0,
+      .possible_crtcs = { 1 },
+      .n_possible_crtcs = 1,
+      .width_mm = 222,
+      .height_mm = 125,
+      .serial = "session-lock-2",
+    },
+  },
+  .n_outputs = 2,
+  .crtcs = {
+    {
+      .current_mode = 0
+    },
+    {
+      .current_mode = 0
+    },
+  },
+  .n_crtcs = 2
+};
+
+static MetaBackend *
+get_backend (void)
+{
+  return meta_context_get_backend (test_context);
+}
+
+static MetaWaylandCompositor *
+get_wayland_compositor (void)
+{
+  return meta_context_get_wayland_compositor (test_context);
+}
+
+static void
+set_monitors (MonitorTestCaseSetup *setup)
+{
+  /* Every test starts here: forget sync points of earlier clients. */
+  g_hash_table_remove_all (sync_points);
+
+  MetaBackend *backend = get_backend ();
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  MetaMonitorTestSetup *test_setup;
+
+  test_setup = meta_create_monitor_test_setup (backend, setup,
+                                               MONITOR_TEST_FLAG_NO_STORED);
+  meta_monitor_manager_test_emulate_hotplug (
+    META_MONITOR_MANAGER_TEST (monitor_manager), test_setup);
+}
+
+static GList *
+get_views (void)
+{
+  MetaRenderer *renderer = meta_backend_get_renderer (get_backend ());
+
+  return meta_renderer_get_views (renderer);
+}
+
+/* With MUTTER_SESSION_LOCK_DUMP_DIR set, dump_views () saves what the
+ * onscreen framebuffers hold as PNGs. */
+static void
+maybe_dump (ClutterStageView *view,
+            const uint8_t    *pixels,
+            int               width,
+            int               height)
+{
+  const char *dir = g_getenv ("MUTTER_SESSION_LOCK_DUMP_DIR");
+  g_autofree char *path = NULL;
+  cairo_surface_t *surface;
+  uint8_t *data;
+  int stride, x, y;
+
+  if (!dir || !dump_label)
+    return;
+
+  path = g_strdup_printf ("%s/%s-view%d.png", dir, dump_label,
+                          g_list_index (get_views (), view));
+  surface = cairo_image_surface_create (CAIRO_FORMAT_RGB24, width, height);
+  data = cairo_image_surface_get_data (surface);
+  stride = cairo_image_surface_get_stride (surface);
+  for (y = 0; y < height; y++)
+    {
+      for (x = 0; x < width; x++)
+        {
+          const uint8_t *p = &pixels[(y * width + x) * 4];
+          uint32_t *d = (uint32_t *) (data + y * stride) + x;
+
+          *d = (p[0] << 16) | (p[1] << 8) | p[2];
+        }
+    }
+  cairo_surface_mark_dirty (surface);
+  g_assert_cmpint (cairo_surface_write_to_png (surface, path), ==,
+                   CAIRO_STATUS_SUCCESS);
+  cairo_surface_destroy (surface);
+}
+
+static void
+on_after_paint (ClutterStage     *stage,
+                ClutterStageView *view,
+                ClutterFrame     *frame,
+                gpointer          user_data)
+{
+  CoglFramebuffer *framebuffer = clutter_stage_view_get_onscreen (view);
+  g_autofree uint8_t *pixels = NULL;
+  FrameStats *stats;
+  graphene_point_t pointer;
+  MtkRectangle layout;
+  int width, height, i;
+
+  width = cogl_framebuffer_get_width (framebuffer);
+  height = cogl_framebuffer_get_height (framebuffer);
+  pixels = g_malloc0 ((size_t) width * height * 4);
+  g_assert_true (cogl_framebuffer_read_pixels (framebuffer, 0, 0,
+                                               width, height,
+                                               COGL_PIXEL_FORMAT_RGBA_8888,
+                                               pixels));
+
+  /* The pointer sprite is painted by the compositor in this backend; while
+   * locked it is never a normal client's cursor (pointer focus is only
+   * ever on lock surfaces, asserted by the tests), so the box around the
+   * pointer is not counted. */
+  clutter_seat_query_state (clutter_backend_get_default_seat (
+                              meta_backend_get_clutter_backend (get_backend ())),
+                            NULL, &pointer, NULL);
+  clutter_stage_view_get_layout (view, &layout);
+
+  stats = g_new0 (FrameStats, 1);
+  stats->width = width;
+  stats->height = height;
+  memcpy (&stats->sample, &pixels[((height / 2) * width + width / 2) * 4], 4);
+  for (i = 0; i < width * height; i++)
+    {
+      uint8_t *p = &pixels[i * 4];
+      float x = layout.x + (float) (i % width) * layout.width / width;
+      float y = layout.y + (float) (i / width) * layout.height / height;
+
+      if (fabsf (x - pointer.x) <= CURSOR_BOX && fabsf (y - pointer.y) <= CURSOR_BOX)
+        {
+          stats->cursor++;
+          continue;
+        }
+
+      if (p[0] == 0xff && p[1] == 0 && p[2] == 0)
+        stats->red++;
+      else if (p[0] == 0 && p[1] == 0xff && p[2] == 0)
+        stats->green++;
+      else if (p[0] == 0 && p[1] == 0 && p[2] == 0xff)
+        stats->blue++;
+      else if (p[0] == 0 && p[1] == 0 && p[2] == 0)
+        stats->black++;
+      else
+        stats->other++;
+    }
+
+  n_frames++;
+  if (meta_wayland_compositor_is_session_locked (get_wayland_compositor ()))
+    {
+      n_locked_frames++;
+      if (stats->red || stats->green || stats->other)
+        {
+          n_leaked_frames++;
+          g_warning ("Frame painted while locked shows normal content: "
+                     "red %" G_GINT64_FORMAT " green %" G_GINT64_FORMAT
+                     " other %" G_GINT64_FORMAT,
+                     stats->red, stats->green, stats->other);
+        }
+    }
+
+  maybe_dump (view, pixels, width, height);
+  g_hash_table_insert (last_frames, view, stats);
+}
+
+static void
+on_sync_point (MetaWaylandTestDriver *driver,
+               unsigned int           sequence,
+               struct wl_resource    *surface_resource,
+               struct wl_client      *wl_client,
+               gpointer               user_data)
+{
+  g_hash_table_add (sync_points, GUINT_TO_POINTER (sequence));
+}
+
+static void
+wait_for_sync (unsigned int sequence)
+{
+  while (!g_hash_table_contains (sync_points, GUINT_TO_POINTER (sequence)))
+    g_main_context_iteration (NULL, TRUE);
+  g_hash_table_remove (sync_points, GUINT_TO_POINTER (sequence));
+}
+
+/* Paint every view once more and return when all of them painted. */
+static void
+repaint_all_views (void)
+{
+  GList *l;
+
+  g_hash_table_remove_all (last_frames);
+  for (l = get_views (); l; l = l->next)
+    {
+      clutter_stage_view_add_redraw_clip (l->data, NULL);
+      clutter_stage_view_schedule_update (l->data);
+    }
+
+  while (g_hash_table_size (last_frames) < g_list_length (get_views ()))
+    g_main_context_iteration (NULL, TRUE);
+}
+
+static void
+dump_views (const char *label)
+{
+  dump_label = label;
+  repaint_all_views ();
+  dump_label = NULL;
+}
+
+static FrameStats *
+stats_for_view (int index)
+{
+  ClutterStageView *view = g_list_nth_data (get_views (), index);
+  FrameStats *stats = g_hash_table_lookup (last_frames, view);
+
+  g_assert_nonnull (stats);
+  return stats;
+}
+
+static void
+assert_view_all (int         index,
+                 const char *color)
+{
+  FrameStats *stats = stats_for_view (index);
+  int64_t n_pixels = (int64_t) stats->width * stats->height - stats->cursor;
+  int64_t count;
+
+  if (g_str_equal (color, "blue"))
+    count = stats->blue;
+  else if (g_str_equal (color, "black"))
+    count = stats->black;
+  else if (g_str_equal (color, "red"))
+    count = stats->red;
+  else if (g_str_equal (color, "green"))
+    count = stats->green;
+  else
+    g_assert_not_reached ();
+
+  g_debug ("view %d: %dx%d red %" G_GINT64_FORMAT " green %" G_GINT64_FORMAT
+           " blue %" G_GINT64_FORMAT " black %" G_GINT64_FORMAT
+           " other %" G_GINT64_FORMAT " sample %08x",
+           index, stats->width, stats->height, stats->red, stats->green,
+           stats->blue, stats->black, stats->other, stats->sample);
+  g_assert_cmpint (count, ==, n_pixels);
+}
+
+/* Normal content is shown: the red client is visible, nothing of a lock
+ * surface is. */
+static void
+assert_view_unlocked (int index)
+{
+  FrameStats *stats = stats_for_view (index);
+
+  g_debug ("view %d: %dx%d red %" G_GINT64_FORMAT " blue %" G_GINT64_FORMAT
+           " black %" G_GINT64_FORMAT " other %" G_GINT64_FORMAT,
+           index, stats->width, stats->height, stats->red, stats->blue,
+           stats->black, stats->other);
+  g_assert_cmpint (stats->red, >, 0);
+  g_assert_cmpint (stats->blue, ==, 0);
+}
+
+static void
+assert_no_leaks (void)
+{
+  g_assert_cmpint (n_leaked_frames, ==, 0);
+}
+
+static MetaWaylandSurface *
+get_keyboard_focus (void)
+{
+  return meta_wayland_keyboard_get_focus_surface (
+    get_wayland_compositor ()->seat->keyboard);
+}
+
+static MetaWaylandSurface *
+get_pointer_focus (void)
+{
+  return meta_wayland_pointer_get_focus_surface (
+    get_wayland_compositor ()->seat->pointer);
+}
+
+static gboolean
+is_lock_surface (MetaWaylandSurface *surface)
+{
+  return surface && META_IS_WAYLAND_SESSION_LOCK_SURFACE (surface->role);
+}
+
+static void
+move_pointer (ClutterVirtualInputDevice *pointer,
+              float                      x,
+              float                      y)
+{
+  clutter_virtual_input_device_notify_absolute_motion (pointer,
+                                                       CLUTTER_CURRENT_TIME,
+                                                       x, y);
+  meta_flush_input (test_context);
+  repaint_all_views ();
+  while (g_main_context_iteration (NULL, FALSE))
+    ;
+}
+
+static MetaWaylandTestClient *
+start_normal_client (void)
+{
+  MetaWaylandTestClient *client;
+
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "session-lock",
+                                                   "normal",
+                                                   NULL);
+  wait_for_sync (SYNC_NORMAL_SHOWN);
+  repaint_all_views ();
+  assert_view_unlocked (0);
+  return client;
+}
+
+static void
+stop_normal_client (MetaWaylandTestClient *client)
+{
+  meta_wayland_test_driver_emit_sync_event (test_driver, EVENT_EXIT_NORMAL);
+  meta_wayland_test_client_finish (client);
+}
+
+/* Lock client locks, every frame from the lock request on shows no normal
+ * content, the lock surface covers the output and gets the input, unlock
+ * restores the session. */
+static void
+session_lock_lock_unlock (void)
+{
+  g_autoptr (ClutterVirtualInputDevice) pointer = NULL;
+  g_autoptr (ClutterVirtualInputDevice) keyboard = NULL;
+  ClutterSeat *seat =
+    clutter_backend_get_default_seat (
+      meta_backend_get_clutter_backend (get_backend ()));
+  MetaWaylandTestClient *normal;
+  MetaWaylandTestClient *lock;
+  MetaWaylandSurface *normal_surface;
+
+  set_monitors (&one_monitor);
+  pointer = clutter_seat_create_virtual_device (seat, CLUTTER_POINTER_DEVICE);
+  keyboard = clutter_seat_create_virtual_device (seat, CLUTTER_KEYBOARD_DEVICE);
+  meta_flush_input (test_context);
+
+  normal = start_normal_client ();
+  dump_views ("lock-0-before");
+  meta_window_focus (meta_find_window_from_title (test_context, "normal"),
+                     META_CURRENT_TIME);
+  move_pointer (pointer, 10, 10);
+  move_pointer (pointer, 500, 400);
+  normal_surface = get_keyboard_focus ();
+  g_assert_nonnull (normal_surface);
+  g_assert_false (is_lock_surface (normal_surface));
+  g_debug ("keyboard focus %p pointer focus %p caps %u", normal_surface,
+           get_pointer_focus (), get_wayland_compositor ()->seat->capabilities);
+  g_assert_true (get_pointer_focus () == normal_surface);
+
+  n_locked_frames = n_leaked_frames = 0;
+  lock = meta_wayland_test_client_new_with_args (test_context,
+                                                 "session-lock", "lock",
+                                                 NULL);
+  wait_for_sync (SYNC_LOCKED);
+  g_assert_true (meta_wayland_compositor_is_session_locked (
+    get_wayland_compositor ()));
+  /* locked is sent only after a blanked frame was presented. */
+  g_assert_cmpint (n_locked_frames, >, 0);
+  assert_no_leaks ();
+
+  wait_for_sync (SYNC_DRAWN_BASE + 1);
+  dump_views ("lock-2-drawn");
+  assert_view_all (0, "blue");
+
+  /* The keyboard and the pointer go to the lock surface. */
+  g_assert_true (is_lock_surface (get_keyboard_focus ()));
+  move_pointer (pointer, 300, 200);
+  g_assert_true (is_lock_surface (get_pointer_focus ()));
+
+  meta_wayland_test_driver_emit_sync_event (test_driver, EVENT_UNLOCK);
+  wait_for_sync (SYNC_UNLOCKED);
+  meta_wayland_test_client_finish (lock);
+  g_assert_false (meta_wayland_compositor_is_session_locked (
+    get_wayland_compositor ()));
+
+  dump_views ("lock-3-unlocked");
+  assert_view_unlocked (0);
+  g_assert_true (get_keyboard_focus () == normal_surface);
+  move_pointer (pointer, 500, 400);
+  g_assert_true (get_pointer_focus () == normal_surface);
+
+  assert_no_leaks ();
+  g_debug ("frames %" G_GINT64_FORMAT ", painted while locked %" G_GINT64_FORMAT
+           ", leaked %" G_GINT64_FORMAT,
+           n_frames, n_locked_frames, n_leaked_frames);
+  stop_normal_client (normal);
+}
+
+/* A monitor plugged in while locked never shows normal content, not even
+ * in its first frame, and gets its own lock surface; unplugging it keeps
+ * the rest locked. */
+static void
+session_lock_hotplug (void)
+{
+  MetaWaylandTestClient *normal;
+  MetaWaylandTestClient *lock;
+  int64_t frames_before;
+
+  set_monitors (&one_monitor);
+  normal = start_normal_client ();
+
+  n_locked_frames = n_leaked_frames = 0;
+  lock = meta_wayland_test_client_new_with_args (test_context,
+                                                 "session-lock", "lock",
+                                                 NULL);
+  wait_for_sync (SYNC_LOCKED);
+  wait_for_sync (SYNC_DRAWN_BASE + 1);
+
+  frames_before = n_locked_frames;
+  set_monitors (&two_monitors);
+  g_assert_cmpuint (g_list_length (get_views ()), ==, 2);
+
+  /* Until the client draws on the new output, it is blank. */
+  dump_views ("hotplug-1-plugged");
+  assert_view_all (0, "blue");
+  if (stats_for_view (1)->blue == 0)
+    assert_view_all (1, "black");
+  assert_no_leaks ();
+
+  wait_for_sync (SYNC_DRAWN_BASE + 2);
+  dump_views ("hotplug-2-drawn");
+  assert_view_all (0, "blue");
+  assert_view_all (1, "blue");
+  g_assert_cmpint (n_locked_frames, >, frames_before);
+  assert_no_leaks ();
+
+  set_monitors (&one_monitor);
+  g_assert_cmpuint (g_list_length (get_views ()), ==, 1);
+  wait_for_sync (SYNC_DRAWN_BASE + 1);
+  repaint_all_views ();
+  assert_view_all (0, "blue");
+  assert_no_leaks ();
+
+  meta_wayland_test_driver_emit_sync_event (test_driver, EVENT_UNLOCK);
+  wait_for_sync (SYNC_UNLOCKED);
+  meta_wayland_test_client_finish (lock);
+
+  repaint_all_views ();
+  assert_view_unlocked (0);
+  assert_no_leaks ();
+  stop_normal_client (normal);
+}
+
+/* A keyboard plugged in while locked types into the lock surface, never
+ * into the focused normal window. */
+static void
+session_lock_keyboard_hotplug (void)
+{
+  ClutterSeat *seat =
+    clutter_backend_get_default_seat (
+      meta_backend_get_clutter_backend (get_backend ()));
+  g_autoptr (ClutterVirtualInputDevice) keyboard = NULL;
+  MetaWaylandTestClient *normal;
+  MetaWaylandTestClient *lock;
+  MetaWaylandSurface *normal_surface;
+
+  set_monitors (&one_monitor);
+  normal = start_normal_client ();
+  meta_window_focus (meta_find_window_from_title (test_context, "normal"),
+                     META_CURRENT_TIME);
+  normal_surface = get_wayland_compositor ()->seat->input_focus;
+  g_assert_nonnull (normal_surface);
+
+  lock = meta_wayland_test_client_new_with_args (test_context,
+                                                 "session-lock", "lock",
+                                                 NULL);
+  wait_for_sync (SYNC_LOCKED);
+  wait_for_sync (SYNC_DRAWN_BASE + 1);
+
+  keyboard = clutter_seat_create_virtual_device (seat, CLUTTER_KEYBOARD_DEVICE);
+  meta_flush_input (test_context);
+  while (!(get_wayland_compositor ()->seat->capabilities &
+           WL_SEAT_CAPABILITY_KEYBOARD))
+    g_main_context_iteration (NULL, TRUE);
+  while (g_main_context_iteration (NULL, FALSE))
+    ;
+  g_assert_true (is_lock_surface (get_keyboard_focus ()));
+
+  meta_wayland_test_driver_emit_sync_event (test_driver, EVENT_UNLOCK);
+  wait_for_sync (SYNC_UNLOCKED);
+  meta_wayland_test_client_finish (lock);
+  g_assert_true (get_keyboard_focus () == normal_surface);
+
+  stop_normal_client (normal);
+}
+
+/* Lock (if needed) and unlock with a new lock client. */
+static void
+recover_session (void)
+{
+  MetaWaylandTestClient *lock;
+
+  g_hash_table_remove_all (sync_points);
+
+  lock = meta_wayland_test_client_new_with_args (test_context,
+                                                 "session-lock", "lock",
+                                                 NULL);
+  wait_for_sync (SYNC_LOCKED);
+  meta_wayland_test_driver_emit_sync_event (test_driver, EVENT_UNLOCK);
+  wait_for_sync (SYNC_UNLOCKED);
+  meta_wayland_test_client_finish (lock);
+  g_assert_false (meta_wayland_compositor_is_session_locked (
+    get_wayland_compositor ()));
+}
+
+/* The lock client goes away while locked: the session stays locked and
+ * blank until another lock client unlocks it. */
+static void
+session_lock_abandon (void)
+{
+  MetaWaylandTestClient *normal;
+  MetaWaylandTestClient *lock;
+  int i;
+
+  set_monitors (&one_monitor);
+  normal = start_normal_client ();
+
+  n_locked_frames = n_leaked_frames = 0;
+  lock = meta_wayland_test_client_new_with_args (test_context,
+                                                 "session-lock", "abandon",
+                                                 NULL);
+  wait_for_sync (SYNC_LOCKED);
+  wait_for_sync (SYNC_DRAWN_BASE + 1);
+  g_test_expect_message ("libmutter", G_LOG_LEVEL_WARNING,
+                         "ext-session-lock: the lock client went away*");
+  meta_wayland_test_driver_emit_sync_event (test_driver, EVENT_EXIT_ABANDON);
+  meta_wayland_test_client_finish (lock);
+  while (g_main_context_iteration (NULL, FALSE))
+    ;
+  g_test_assert_expected_messages ();
+
+  g_assert_true (meta_wayland_compositor_is_session_locked (
+    get_wayland_compositor ()));
+  for (i = 0; i < 5; i++)
+    {
+      dump_views (i == 0 ? "abandon-1-dead" : NULL);
+      assert_view_all (0, "black");
+    }
+  g_assert_null (get_keyboard_focus ());
+
+  recover_session ();
+  repaint_all_views ();
+  assert_view_unlocked (0);
+  assert_no_leaks ();
+  stop_normal_client (normal);
+}
+
+/* While one client holds the lock, another one's lock is finished. */
+static void
+session_lock_second (void)
+{
+  MetaWaylandTestClient *lock;
+  MetaWaylandTestClient *second;
+
+  set_monitors (&one_monitor);
+  lock = meta_wayland_test_client_new_with_args (test_context,
+                                                 "session-lock", "lock",
+                                                 NULL);
+  wait_for_sync (SYNC_LOCKED);
+  wait_for_sync (SYNC_DRAWN_BASE + 1);
+
+  second = meta_wayland_test_client_new_with_args (test_context,
+                                                   "session-lock", "second",
+                                                   NULL);
+  wait_for_sync (SYNC_FINISHED);
+  meta_wayland_test_client_finish (second);
+
+  repaint_all_views ();
+  assert_view_all (0, "blue");
+  g_assert_true (meta_wayland_compositor_is_session_locked (
+    get_wayland_compositor ()));
+
+  meta_wayland_test_driver_emit_sync_event (test_driver, EVENT_UNLOCK);
+  wait_for_sync (SYNC_UNLOCKED);
+  meta_wayland_test_client_finish (lock);
+  g_assert_false (meta_wayland_compositor_is_session_locked (
+    get_wayland_compositor ()));
+}
+
+/* Destroying the lock before locked gives up the lock. */
+static void
+session_lock_cancel (void)
+{
+  MetaWaylandTestClient *normal;
+  MetaWaylandTestClient *lock;
+
+  set_monitors (&one_monitor);
+  normal = start_normal_client ();
+
+  n_locked_frames = n_leaked_frames = 0;
+  lock = meta_wayland_test_client_new_with_args (test_context,
+                                                 "session-lock", "cancel",
+                                                 NULL);
+  wait_for_sync (SYNC_UNLOCKED);
+  meta_wayland_test_client_finish (lock);
+  g_assert_false (meta_wayland_compositor_is_session_locked (
+    get_wayland_compositor ()));
+
+  repaint_all_views ();
+  assert_view_unlocked (0);
+  assert_no_leaks ();
+  stop_normal_client (normal);
+}
+
+static void
+session_lock_protocol_error (gconstpointer data)
+{
+  const char *error = data;
+  g_autofree char *mode = g_strdup_printf ("error-%s", error);
+  MetaWaylandTestClient *normal;
+  MetaWaylandTestClient *client;
+
+  set_monitors (&one_monitor);
+  normal = start_normal_client ();
+
+  n_locked_frames = n_leaked_frames = 0;
+  g_test_expect_message ("libmutter", G_LOG_LEVEL_MESSAGE,
+                         "ext-session-lock: session locked by*");
+  g_test_expect_message ("libmutter", G_LOG_LEVEL_WARNING,
+                         "WL: error in client communication*");
+  if (g_str_equal (error, "invalid-unlock"))
+    {
+      g_test_expect_message ("libmutter", G_LOG_LEVEL_MESSAGE,
+                             "ext-session-lock: session unlocked");
+    }
+  else
+    {
+      g_test_expect_message ("libmutter", G_LOG_LEVEL_WARNING,
+                             "ext-session-lock: the lock client went away*");
+    }
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "session-lock", mode,
+                                                   NULL);
+  meta_wayland_test_client_finish (client);
+  while (g_main_context_iteration (NULL, FALSE))
+    ;
+  g_test_assert_expected_messages ();
+
+  if (g_str_equal (error, "invalid-unlock"))
+    {
+      /* Never locked: the lock is given up. */
+      g_assert_false (meta_wayland_compositor_is_session_locked (
+        get_wayland_compositor ()));
+    }
+  else
+    {
+      /* Locked, then killed by the error: stays locked. */
+      g_assert_true (meta_wayland_compositor_is_session_locked (
+        get_wayland_compositor ()));
+      repaint_all_views ();
+      assert_view_all (0, "black");
+      recover_session ();
+    }
+
+  repaint_all_views ();
+  assert_view_unlocked (0);
+  assert_no_leaks ();
+  stop_normal_client (normal);
+}
+
+static void
+on_before_tests (MetaContext *context)
+{
+  MetaWaylandCompositor *compositor =
+    meta_context_get_wayland_compositor (context);
+  ClutterActor *stage = meta_backend_get_stage (get_backend ());
+
+  test_driver = meta_wayland_test_driver_new (compositor);
+  sync_points = g_hash_table_new (NULL, NULL);
+  g_signal_connect (test_driver, "sync-point",
+                    G_CALLBACK (on_sync_point), NULL);
+
+  last_frames = g_hash_table_new_full (NULL, NULL, NULL, g_free);
+  g_signal_connect (stage, "after-paint",
+                    G_CALLBACK (on_after_paint), NULL);
+
+}
+
+static void
+on_after_tests (MetaContext *context)
+{
+  ClutterActor *stage = meta_backend_get_stage (get_backend ());
+
+  g_signal_handlers_disconnect_by_func (stage, on_after_paint, NULL);
+  g_clear_pointer (&last_frames, g_hash_table_unref);
+  g_clear_pointer (&sync_points, g_hash_table_unref);
+  g_clear_object (&test_driver);
+}
+
+static const char *protocol_errors[] = {
+  "invalid-unlock",
+  "invalid-destroy",
+  "role",
+  "role-twice",
+  "duplicate-output",
+  "already-constructed",
+  "commit-before-ack",
+  "null-buffer",
+  "dimensions-mismatch",
+  "invalid-serial",
+  "ack-twice",
+};
+
+static void
+init_tests (void)
+{
+  size_t i;
+
+  g_test_add_func ("/wayland/session-lock/lock-unlock",
+                   session_lock_lock_unlock);
+  g_test_add_func ("/wayland/session-lock/hotplug",
+                   session_lock_hotplug);
+  g_test_add_func ("/wayland/session-lock/keyboard-hotplug",
+                   session_lock_keyboard_hotplug);
+  g_test_add_func ("/wayland/session-lock/abandon",
+                   session_lock_abandon);
+  g_test_add_func ("/wayland/session-lock/second-lock",
+                   session_lock_second);
+  g_test_add_func ("/wayland/session-lock/cancel",
+                   session_lock_cancel);
+
+  for (i = 0; i < G_N_ELEMENTS (protocol_errors); i++)
+    {
+      g_autofree char *path =
+        g_strdup_printf ("/wayland/session-lock/error/%s", protocol_errors[i]);
+
+      g_test_add_data_func (path, protocol_errors[i],
+                            session_lock_protocol_error);
+    }
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_autoptr (MetaContext) context = NULL;
+
+  context = meta_create_test_context (META_CONTEXT_TEST_TYPE_TEST,
+                                      META_CONTEXT_TEST_FLAG_NO_X11 |
+                                      META_CONTEXT_TEST_FLAG_TEST_CLIENT);
+  g_assert_true (meta_context_configure (context, &argc, &argv, NULL));
+
+  test_context = context;
+
+  init_tests ();
+
+  g_signal_connect (context, "before-tests",
+                    G_CALLBACK (on_before_tests), NULL);
+  g_signal_connect (context, "after-tests",
+                    G_CALLBACK (on_after_tests), NULL);
+
+  return meta_context_test_run_tests (META_CONTEXT_TEST (context),
+                                      META_TEST_RUN_FLAG_NONE);
+}
