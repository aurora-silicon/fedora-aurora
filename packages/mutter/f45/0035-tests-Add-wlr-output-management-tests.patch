+#include "config.h"
+
+#include <glib.h>
+#include <string.h>
+
+#include "wayland-test-client-utils.h"
+
+#include "wlr-output-management-unstable-v1-client-protocol.h"
+
+#define MAX_MODES 8
+
+typedef struct _Mode
+{
+  struct zwlr_output_mode_v1 *mode;
+  int width;
+  int height;
+  int refresh;
+  gboolean preferred;
+  gboolean finished;
+} Mode;
+
+typedef struct _Head
+{
+  struct zwlr_output_head_v1 *head;
+  char *name;
+  Mode modes[MAX_MODES];
+  int n_modes;
+  gboolean enabled;
+  int current_mode;
+  int x, y;
+  int transform;
+  wl_fixed_t scale;
+  gboolean adaptive_sync;
+  gboolean finished;
+} Head;
+
+typedef enum _Result
+{
+  RESULT_NONE,
+  RESULT_SUCCEEDED,
+  RESULT_FAILED,
+  RESULT_CANCELLED,
+} Result;
+
+typedef struct _HeadConfig
+{
+  gboolean enable;
+  int mode;
+  int x, y;
+  int transform;
+  int adaptive_sync;
+  double scale;
+} HeadConfig;
+
+static struct zwlr_output_manager_v1 *output_manager;
+static Head heads[2];
+static int n_heads;
+static uint32_t serial;
+static int n_done;
+static int n_head_events;
+
+static Head *
+find_head (struct zwlr_output_head_v1 *head)
+{
+  int i;
+
+  for (i = 0; i < n_heads; i++)
+    {
+      if (heads[i].head == head)
+        return &heads[i];
+    }
+
+  g_assert_not_reached ();
+}
+
+static Mode *
+find_mode (struct zwlr_output_mode_v1 *mode)
+{
+  int i, j;
+
+  for (i = 0; i < n_heads; i++)
+    {
+      for (j = 0; j < heads[i].n_modes; j++)
+        {
+          if (heads[i].modes[j].mode == mode)
+            return &heads[i].modes[j];
+        }
+    }
+
+  g_assert_not_reached ();
+}
+
+static void
+handle_mode_size (void                       *user_data,
+                  struct zwlr_output_mode_v1 *mode,
+                  int32_t                     width,
+                  int32_t                     height)
+{
+  find_mode (mode)->width = width;
+  find_mode (mode)->height = height;
+}
+
+static void
+handle_mode_refresh (void                       *user_data,
+                     struct zwlr_output_mode_v1 *mode,
+                     int32_t                     refresh)
+{
+  find_mode (mode)->refresh = refresh;
+}
+
+static void
+handle_mode_preferred (void                       *user_data,
+                       struct zwlr_output_mode_v1 *mode)
+{
+  find_mode (mode)->preferred = TRUE;
+}
+
+static void
+handle_mode_finished (void                       *user_data,
+                      struct zwlr_output_mode_v1 *mode)
+{
+  find_mode (mode)->finished = TRUE;
+}
+
+static const struct zwlr_output_mode_v1_listener mode_listener = {
+  handle_mode_size,
+  handle_mode_refresh,
+  handle_mode_preferred,
+  handle_mode_finished,
+};
+
+static void
+handle_head_name (void                       *user_data,
+                  struct zwlr_output_head_v1 *head,
+                  const char                 *name)
+{
+  find_head (head)->name = g_strdup (name);
+  n_head_events++;
+}
+
+static void
+handle_head_description (void                       *user_data,
+                         struct zwlr_output_head_v1 *head,
+                         const char                 *description)
+{
+  n_head_events++;
+}
+
+static void
+handle_head_physical_size (void                       *user_data,
+                           struct zwlr_output_head_v1 *head,
+                           int32_t                     width,
+                           int32_t                     height)
+{
+  n_head_events++;
+}
+
+static void
+handle_head_mode (void                       *user_data,
+                  struct zwlr_output_head_v1 *head,
+                  struct zwlr_output_mode_v1 *mode)
+{
+  Head *h = find_head (head);
+
+  g_assert_cmpint (h->n_modes, <, MAX_MODES);
+  h->modes[h->n_modes++] = (Mode) { .mode = mode };
+  zwlr_output_mode_v1_add_listener (mode, &mode_listener, NULL);
+  n_head_events++;
+}
+
+static void
+handle_head_enabled (void                       *user_data,
+                     struct zwlr_output_head_v1 *head,
+                     int32_t                     enabled)
+{
+  Head *h = find_head (head);
+
+  h->enabled = enabled;
+  if (!enabled)
+    h->current_mode = -1;
+  n_head_events++;
+}
+
+static void
+handle_head_current_mode (void                       *user_data,
+                          struct zwlr_output_head_v1 *head,
+                          struct zwlr_output_mode_v1 *mode)
+{
+  Head *h = find_head (head);
+  int i;
+
+  for (i = 0; i < h->n_modes; i++)
+    {
+      if (h->modes[i].mode == mode)
+        h->current_mode = i;
+    }
+  n_head_events++;
+}
+
+static void
+handle_head_position (void                       *user_data,
+                      struct zwlr_output_head_v1 *head,
+                      int32_t                     x,
+                      int32_t                     y)
+{
+  find_head (head)->x = x;
+  find_head (head)->y = y;
+  n_head_events++;
+}
+
+static void
+handle_head_transform (void                       *user_data,
+                       struct zwlr_output_head_v1 *head,
+                       int32_t                     transform)
+{
+  find_head (head)->transform = transform;
+  n_head_events++;
+}
+
+static void
+handle_head_scale (void                       *user_data,
+                   struct zwlr_output_head_v1 *head,
+                   wl_fixed_t                  scale)
+{
+  find_head (head)->scale = scale;
+  n_head_events++;
+}
+
+static void
+handle_head_finished (void                       *user_data,
+                      struct zwlr_output_head_v1 *head)
+{
+  find_head (head)->finished = TRUE;
+  n_head_events++;
+}
+
+static void
+handle_head_string (void                       *user_data,
+                    struct zwlr_output_head_v1 *head,
+                    const char                 *string)
+{
+  n_head_events++;
+}
+
+static void
+handle_head_adaptive_sync (void                       *user_data,
+                           struct zwlr_output_head_v1 *head,
+                           uint32_t                    state)
+{
+  find_head (head)->adaptive_sync =
+    state == ZWLR_OUTPUT_HEAD_V1_ADAPTIVE_SYNC_STATE_ENABLED;
+  n_head_events++;
+}
+
+static const struct zwlr_output_head_v1_listener head_listener = {
+  handle_head_name,
+  handle_head_description,
+  handle_head_physical_size,
+  handle_head_mode,
+  handle_head_enabled,
+  handle_head_current_mode,
+  handle_head_position,
+  handle_head_transform,
+  handle_head_scale,
+  handle_head_finished,
+  handle_head_string,
+  handle_head_string,
+  handle_head_string,
+  handle_head_adaptive_sync,
+};
+
+static void
+handle_manager_head (void                          *user_data,
+                     struct zwlr_output_manager_v1 *manager,
+                     struct zwlr_output_head_v1    *head)
+{
+  g_assert_cmpint (n_heads, <, (int) G_N_ELEMENTS (heads));
+  heads[n_heads++] = (Head) { .head = head, .current_mode = -1 };
+  zwlr_output_head_v1_add_listener (head, &head_listener, NULL);
+}
+
+static void
+handle_manager_done (void                          *user_data,
+                     struct zwlr_output_manager_v1 *manager,
+                     uint32_t                       done_serial)
+{
+  serial = done_serial;
+  n_done++;
+}
+
+static void
+handle_manager_finished (void                          *user_data,
+                         struct zwlr_output_manager_v1 *manager)
+{
+}
+
+static const struct zwlr_output_manager_v1_listener manager_listener = {
+  handle_manager_head,
+  handle_manager_done,
+  handle_manager_finished,
+};
+
+static void
+handle_registry_global (void               *user_data,
+                        struct wl_registry *registry,
+                        uint32_t            id,
+                        const char         *interface,
+                        uint32_t            version)
+{
+  if (strcmp (interface, zwlr_output_manager_v1_interface.name) == 0)
+    {
+      g_assert_cmpuint (version, >=, 4);
+      output_manager = wl_registry_bind (registry, id,
+                                         &zwlr_output_manager_v1_interface, 4);
+      zwlr_output_manager_v1_add_listener (output_manager, &manager_listener,
+                                           NULL);
+    }
+}
+
+static void
+handle_registry_global_remove (void               *user_data,
+                               struct wl_registry *registry,
+                               uint32_t            name)
+{
+}
+
+static const struct wl_registry_listener registry_listener = {
+  handle_registry_global,
+  handle_registry_global_remove
+};
+
+static void
+handle_config_succeeded (void                                *user_data,
+                         struct zwlr_output_configuration_v1 *config)
+{
+  Result *result = user_data;
+
+  *result = RESULT_SUCCEEDED;
+  /* Changes caused by the apply must come after the result. */
+  n_head_events = 0;
+}
+
+static void
+handle_config_failed (void                                *user_data,
+                      struct zwlr_output_configuration_v1 *config)
+{
+  Result *result = user_data;
+
+  *result = RESULT_FAILED;
+  n_head_events = 0;
+}
+
+static void
+handle_config_cancelled (void                                *user_data,
+                         struct zwlr_output_configuration_v1 *config)
+{
+  Result *result = user_data;
+
+  *result = RESULT_CANCELLED;
+  n_head_events = 0;
+}
+
+static const struct zwlr_output_configuration_v1_listener config_listener = {
+  handle_config_succeeded,
+  handle_config_failed,
+  handle_config_cancelled,
+};
+
+static void
+sync_point (WaylandDisplay *display,
+            int             sequence)
+{
+  wl_display_roundtrip (display->display);
+  test_driver_sync_point (display->test_driver, sequence, NULL);
+  wait_for_sync_event (display, sequence);
+}
+
+static HeadConfig
+current_config (int i)
+{
+  return (HeadConfig) {
+    .enable = heads[i].enabled,
+    .mode = heads[i].current_mode,
+    .x = heads[i].x,
+    .y = heads[i].y,
+    .transform = -1,
+    .adaptive_sync = -1,
+  };
+}
+
+static struct zwlr_output_configuration_v1 *
+create_config (uint32_t    config_serial,
+               HeadConfig *config,
+               Result     *result)
+{
+  struct zwlr_output_configuration_v1 *output_config;
+  int i;
+
+  output_config =
+    zwlr_output_manager_v1_create_configuration (output_manager, config_serial);
+  *result = RESULT_NONE;
+  zwlr_output_configuration_v1_add_listener (output_config, &config_listener,
+                                             result);
+
+  for (i = 0; i < n_heads; i++)
+    {
+      struct zwlr_output_configuration_head_v1 *config_head;
+
+      if (!config[i].enable)
+        {
+          zwlr_output_configuration_v1_disable_head (output_config,
+                                                     heads[i].head);
+          continue;
+        }
+
+      config_head =
+        zwlr_output_configuration_v1_enable_head (output_config,
+                                                  heads[i].head);
+      if (config[i].mode >= 0)
+        {
+          zwlr_output_configuration_head_v1_set_mode (config_head,
+                                                      heads[i].modes[config[i].mode].mode);
+        }
+      zwlr_output_configuration_head_v1_set_position (config_head,
+                                                      config[i].x,
+                                                      config[i].y);
+      if (config[i].transform >= 0)
+        {
+          zwlr_output_configuration_head_v1_set_transform (config_head,
+                                                           config[i].transform);
+        }
+      if (config[i].scale > 0)
+        {
+          zwlr_output_configuration_head_v1_set_scale (config_head,
+                                                       wl_fixed_from_double (config[i].scale));
+        }
+      if (config[i].adaptive_sync >= 0)
+        {
+          zwlr_output_configuration_head_v1_set_adaptive_sync (config_head,
+                                                               config[i].adaptive_sync);
+        }
+    }
+
+  return output_config;
+}
+
+static Result
+finish_config (WaylandDisplay                      *display,
+               struct zwlr_output_configuration_v1 *output_config,
+               Result                              *result,
+               gboolean                             test_only)
+{
+  int n_done_before = n_done;
+
+  if (test_only)
+    zwlr_output_configuration_v1_test (output_config);
+  else
+    zwlr_output_configuration_v1_apply (output_config);
+
+  while (*result == RESULT_NONE)
+    {
+      if (wl_display_dispatch (display->display) == -1)
+        g_error ("Lost the connection to the compositor");
+    }
+
+  /* An applied change is announced with a new done. */
+  if (*result == RESULT_SUCCEEDED && !test_only)
+    {
+      while (n_done == n_done_before)
+        {
+          if (wl_display_dispatch (display->display) == -1)
+            g_error ("Lost the connection to the compositor");
+        }
+    }
+
+  zwlr_output_configuration_v1_destroy (output_config);
+  wl_display_roundtrip (display->display);
+
+  return *result;
+}
+
+static Result
+run_config (WaylandDisplay *display,
+            HeadConfig     *config,
+            gboolean        test_only)
+{
+  Result result;
+
+  return finish_config (display, create_config (serial, config, &result),
+                        &result, test_only);
+}
+
+static int
+find_mode_index (Head *head,
+                 int   width,
+                 int   height)
+{
+  int i;
+
+  for (i = 0; i < head->n_modes; i++)
+    {
+      if (head->modes[i].width == width && head->modes[i].height == height)
+        return i;
+    }
+
+  g_assert_not_reached ();
+}
+
+static void
+test_apply (WaylandDisplay *display)
+{
+  struct zwlr_output_configuration_v1 *stale_config;
+  Result stale_result;
+  HeadConfig config[2];
+  int mode_1080p, mode_720p, mode_768;
+
+  /* Initial state: both heads enabled side by side; the fixed and the
+   * variable 1920x1080@60 modes are one mode. */
+  g_assert_cmpint (n_heads, ==, 2);
+  g_assert_cmpint (heads[0].n_modes, ==, 3);
+  g_assert_cmpint (heads[1].n_modes, ==, 1);
+  mode_1080p = find_mode_index (&heads[0], 1920, 1080);
+  mode_720p = find_mode_index (&heads[0], 1280, 720);
+  mode_768 = find_mode_index (&heads[0], 1024, 768);
+  g_assert_cmpint (heads[0].modes[mode_1080p].refresh, ==, 60000);
+  g_assert_true (heads[0].modes[mode_1080p].preferred);
+  g_assert_true (heads[0].enabled && heads[1].enabled);
+  g_assert_cmpint (heads[0].current_mode, ==, mode_1080p);
+  g_assert_false (heads[0].adaptive_sync);
+  g_assert_cmpint (heads[0].x, ==, 0);
+  g_assert_cmpint (heads[1].x, ==, 1920);
+  g_assert_cmpint (heads[0].scale, ==, wl_fixed_from_int (1));
+  sync_point (display, 0);
+
+  /* Test only: nothing changes. */
+  config[0] = current_config (0);
+  config[1] = current_config (1);
+  config[0].mode = mode_720p;
+  config[1].x = 1280;
+  g_assert_cmpint (run_config (display, config, TRUE), ==, RESULT_SUCCEEDED);
+  g_assert_cmpint (n_head_events, ==, 0);
+  g_assert_cmpint (heads[0].current_mode, ==, mode_1080p);
+  sync_point (display, 1);
+
+  /* Apply both heads at once. */
+  g_assert_cmpint (run_config (display, config, FALSE), ==, RESULT_SUCCEEDED);
+  g_assert_cmpint (heads[0].current_mode, ==, mode_720p);
+  g_assert_cmpint (heads[1].x, ==, 1280);
+  sync_point (display, 2);
+
+  /* Adaptive sync selects the variable refresh rate variant. */
+  config[0] = current_config (0);
+  config[1] = current_config (1);
+  config[0].mode = mode_1080p;
+  config[0].adaptive_sync = ZWLR_OUTPUT_HEAD_V1_ADAPTIVE_SYNC_STATE_ENABLED;
+  config[1].x = 1920;
+  g_assert_cmpint (run_config (display, config, FALSE), ==, RESULT_SUCCEEDED);
+  g_assert_true (heads[0].adaptive_sync);
+  g_assert_cmpint (heads[0].current_mode, ==, mode_1080p);
+  sync_point (display, 3);
+
+  /* No variable refresh rate at 1280x720: refused, nothing changes. */
+  config[0] = current_config (0);
+  config[1] = current_config (1);
+  config[0].mode = mode_720p;
+  config[0].adaptive_sync = ZWLR_OUTPUT_HEAD_V1_ADAPTIVE_SYNC_STATE_ENABLED;
+  config[1].x = 1280;
+  g_assert_cmpint (run_config (display, config, FALSE), ==, RESULT_FAILED);
+  g_assert_true (heads[0].adaptive_sync);
+  g_assert_cmpint (heads[0].current_mode, ==, mode_1080p);
+
+  /* One bad head fails the whole configuration. */
+  config[0].adaptive_sync = ZWLR_OUTPUT_HEAD_V1_ADAPTIVE_SYNC_STATE_DISABLED;
+  config[1].scale = 0.3;
+  g_assert_cmpint (run_config (display, config, FALSE), ==, RESULT_FAILED);
+
+  /* A gap between the heads is refused. */
+  config[0] = current_config (0);
+  config[1] = current_config (1);
+  config[1].x = 2000;
+  g_assert_cmpint (run_config (display, config, FALSE), ==, RESULT_FAILED);
+  g_assert_cmpint (heads[0].current_mode, ==, mode_1080p);
+  g_assert_cmpint (heads[1].x, ==, 1920);
+  sync_point (display, 4);
+
+  /* Rotate and move the second head; turn adaptive sync off. */
+  config[0] = current_config (0);
+  config[1] = current_config (1);
+  config[0].adaptive_sync = ZWLR_OUTPUT_HEAD_V1_ADAPTIVE_SYNC_STATE_DISABLED;
+  config[1].x = 0;
+  config[1].y = 1080;
+  config[1].transform = WL_OUTPUT_TRANSFORM_90;
+  g_assert_cmpint (run_config (display, config, FALSE), ==, RESULT_SUCCEEDED);
+  g_assert_false (heads[0].adaptive_sync);
+  g_assert_cmpint (heads[1].transform, ==, WL_OUTPUT_TRANSFORM_90);
+  g_assert_cmpint (heads[1].y, ==, 1080);
+  sync_point (display, 5);
+
+  /* Mirror: both heads at 1024x768 at 0,0. */
+  config[0] = current_config (0);
+  config[1] = current_config (1);
+  config[0].mode = mode_768;
+  config[1].x = 0;
+  config[1].y = 0;
+  config[1].transform = WL_OUTPUT_TRANSFORM_NORMAL;
+  g_assert_cmpint (run_config (display, config, FALSE), ==, RESULT_SUCCEEDED);
+  g_assert_cmpint (heads[0].x, ==, 0);
+  g_assert_cmpint (heads[1].x, ==, 0);
+  sync_point (display, 6);
+
+  /* Disable the second head. */
+  config[0] = current_config (0);
+  config[1] = current_config (1);
+  config[1].enable = FALSE;
+  g_assert_cmpint (run_config (display, config, FALSE), ==, RESULT_SUCCEEDED);
+  g_assert_false (heads[1].enabled);
+  sync_point (display, 7);
+
+  /* Re-enable it with nothing set: preferred mode, right of the first. */
+  config[0] = current_config (0);
+  config[1] = (HeadConfig) { .enable = TRUE, .mode = -1, .x = 1024, .y = 0,
+                             .transform = -1, .adaptive_sync = -1 };
+  g_assert_cmpint (run_config (display, config, FALSE), ==, RESULT_SUCCEEDED);
+  g_assert_true (heads[1].enabled);
+  g_assert_true (heads[1].modes[heads[1].current_mode].preferred);
+  g_assert_cmpint (heads[1].x, ==, 1024);
+
+  /* A configuration made before a hotplug is cancelled. */
+  config[0] = current_config (0);
+  config[1] = current_config (1);
+  stale_config = create_config (serial, config, &stale_result);
+  sync_point (display, 8);
+  /* The compositor unplugged the second monitor. */
+  wl_display_roundtrip (display->display);
+  g_assert_true (heads[1].finished);
+  g_assert_true (heads[1].modes[0].finished);
+  g_assert_false (heads[0].finished);
+  g_assert_cmpint (finish_config (display, stale_config, &stale_result, FALSE),
+                   ==, RESULT_CANCELLED);
+  sync_point (display, 9);
+}
+
+static void
+test_already_set (WaylandDisplay *display)
+{
+  struct zwlr_output_configuration_v1 *output_config;
+  struct zwlr_output_configuration_head_v1 *config_head;
+
+  output_config = zwlr_output_manager_v1_create_configuration (output_manager,
+                                                               serial);
+  config_head = zwlr_output_configuration_v1_enable_head (output_config,
+                                                          heads[0].head);
+  zwlr_output_configuration_head_v1_set_position (config_head, 0, 0);
+  zwlr_output_configuration_head_v1_set_position (config_head, 0, 0);
+
+  g_assert_cmpint (wl_display_roundtrip (display->display), ==, -1);
+  g_assert_cmpint (wl_display_get_protocol_error (display->display, NULL, NULL),
+                   ==, ZWLR_OUTPUT_CONFIGURATION_HEAD_V1_ERROR_ALREADY_SET);
+}
+
+static void
+test_unconfigured_head (WaylandDisplay *display)
+{
+  struct zwlr_output_configuration_v1 *output_config;
+
+  output_config = zwlr_output_manager_v1_create_configuration (output_manager,
+                                                               serial);
+  zwlr_output_configuration_v1_enable_head (output_config, heads[0].head);
+  zwlr_output_configuration_v1_apply (output_config);
+
+  g_assert_cmpint (wl_display_roundtrip (display->display), ==, -1);
+  g_assert_cmpint (wl_display_get_protocol_error (display->display, NULL, NULL),
+                   ==, ZWLR_OUTPUT_CONFIGURATION_V1_ERROR_UNCONFIGURED_HEAD);
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_autoptr (WaylandDisplay) display = NULL;
+  struct wl_registry *registry;
+
+  g_assert_cmpint (argc, ==, 2);
+
+  display = wayland_display_new (WAYLAND_DISPLAY_CAPABILITY_TEST_DRIVER);
+  registry = wl_display_get_registry (display->display);
+  wl_registry_add_listener (registry, &registry_listener, NULL);
+  wl_display_roundtrip (display->display);
+  g_assert_nonnull (output_manager);
+  while (n_done == 0)
+    {
+      if (wl_display_dispatch (display->display) == -1)
+        g_error ("Lost the connection to the compositor");
+    }
+
+  if (g_strcmp0 (argv[1], "apply") == 0)
+    test_apply (display);
+  else if (g_strcmp0 (argv[1], "already-set") == 0)
+    test_already_set (display);
+  else if (g_strcmp0 (argv[1], "unconfigured-head") == 0)
+    test_unconfigured_head (display);
+  else
+    g_error ("Unknown test '%s'", argv[1]);
+
+  return EXIT_SUCCESS;
+}
