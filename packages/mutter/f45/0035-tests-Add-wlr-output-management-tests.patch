+#include "config.h"
+
+#include <string.h>
+
+#include "backends/meta-logical-monitor-private.h"
+#include "backends/meta-monitor-manager-private.h"
+#include "backends/meta-monitor-private.h"
+#include "meta-test/meta-context-test.h"
+#include "tests/meta-monitor-manager-test.h"
+#include "tests/meta-monitor-test-utils.h"
+#include "tests/meta-wayland-test-driver.h"
+#include "tests/meta-wayland-test-utils.h"
+
+static MetaContext *test_context;
+static MetaWaylandTestDriver *test_driver;
+
+/* Output 0 has 1920x1080@60 with a fixed and a variable refresh rate,
+ * 1280x720@60 and 1024x768@60; output 1 has 1024x768@60. */
+static MonitorTestCaseSetup base_monitor_setup = {
+  .modes = {
+    {
+      .width = 1920,
+      .height = 1080,
+      .refresh_rate = 60.0,
+      .refresh_rate_mode = META_CRTC_REFRESH_RATE_MODE_FIXED,
+    },
+    {
+      .width = 1920,
+      .height = 1080,
+      .refresh_rate = 60.0,
+      .refresh_rate_mode = META_CRTC_REFRESH_RATE_MODE_VARIABLE,
+    },
+    {
+      .width = 1280,
+      .height = 720,
+      .refresh_rate = 60.0,
+    },
+    {
+      .width = 1024,
+      .height = 768,
+      .refresh_rate = 60.0,
+    },
+  },
+  .n_modes = 4,
+  .outputs = {
+     {
+      .crtc = 0,
+      .modes = { 0, 1, 2, 3 },
+      .n_modes = 4,
+      .preferred_mode = 0,
+      .possible_crtcs = { 0, 1 },
+      .n_possible_crtcs = 2,
+      .width_mm = 344,
+      .height_mm = 194,
+      .serial = "output-management-0",
+    },
+     {
+      .crtc = 1,
+      .modes = { 3 },
+      .n_modes = 1,
+      .preferred_mode = 3,
+      .possible_crtcs = { 0, 1 },
+      .n_possible_crtcs = 2,
+      .width_mm = 220,
+      .height_mm = 124,
+      .serial = "output-management-1",
+    },
+  },
+  .n_outputs = 2,
+  .crtcs = {
+    {
+      .current_mode = 0
+    },
+    {
+      .current_mode = 3
+    },
+  },
+  .n_crtcs = 2
+};
+
+static MetaMonitorManager *
+get_monitor_manager (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+
+  return meta_backend_get_monitor_manager (backend);
+}
+
+static void
+setup_monitors (int n_outputs)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MonitorTestCaseSetup test_case_setup = base_monitor_setup;
+  MetaMonitorTestSetup *test_setup;
+
+  test_case_setup.n_outputs = n_outputs;
+  test_setup = meta_create_monitor_test_setup (backend, &test_case_setup,
+                                               MONITOR_TEST_FLAG_NO_STORED);
+  meta_monitor_manager_test_emulate_hotplug (
+    META_MONITOR_MANAGER_TEST (get_monitor_manager ()), test_setup);
+}
+
+static MetaMonitor *
+get_monitor (int i)
+{
+  GList *monitors = meta_monitor_manager_get_monitors (get_monitor_manager ());
+
+  g_assert_cmpuint (g_list_length (monitors), >, i);
+  return g_list_nth_data (monitors, i);
+}
+
+static void
+assert_monitor (int                     i,
+                int                     width,
+                int                     height,
+                MetaCrtcRefreshRateMode refresh_rate_mode,
+                int                     x,
+                int                     y,
+                MtkMonitorTransform     transform)
+{
+  MetaMonitor *monitor = get_monitor (i);
+  MetaLogicalMonitor *logical_monitor;
+  MetaMonitorMode *mode;
+  const MetaMonitorModeSpec *spec;
+  MtkRectangle layout;
+
+  logical_monitor = meta_monitor_get_logical_monitor (monitor);
+  g_assert_nonnull (logical_monitor);
+  mode = meta_monitor_get_current_mode (monitor);
+  g_assert_nonnull (mode);
+  spec = meta_monitor_mode_get_spec (mode);
+  g_assert_cmpint (spec->width, ==, width);
+  g_assert_cmpint (spec->height, ==, height);
+  g_assert_cmpint (spec->refresh_rate_mode, ==, refresh_rate_mode);
+
+  layout = meta_logical_monitor_get_layout (logical_monitor);
+  g_assert_cmpint (layout.x, ==, x);
+  g_assert_cmpint (layout.y, ==, y);
+  g_assert_cmpint (logical_monitor->transform, ==, transform);
+}
+
+static void
+wait_for_client (int sequence)
+{
+  meta_wayland_test_driver_wait_for_sync_point (test_driver, sequence);
+}
+
+static void
+release (int sequence)
+{
+  meta_wayland_test_driver_emit_sync_event (test_driver, sequence);
+}
+
+static void
+output_management_apply (void)
+{
+  MetaMonitorManager *monitor_manager = get_monitor_manager ();
+  MetaWaylandTestClient *client;
+
+  setup_monitors (2);
+  assert_monitor (0, 1920, 1080, META_CRTC_REFRESH_RATE_MODE_FIXED, 0, 0,
+                  MTK_MONITOR_TRANSFORM_NORMAL);
+  assert_monitor (1, 1024, 768, META_CRTC_REFRESH_RATE_MODE_FIXED, 1920, 0,
+                  MTK_MONITOR_TRANSFORM_NORMAL);
+
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "output-management",
+                                                   "apply",
+                                                   NULL);
+  wait_for_client (0);
+  release (0);
+
+  /* test: verified only */
+  wait_for_client (1);
+  assert_monitor (0, 1920, 1080, META_CRTC_REFRESH_RATE_MODE_FIXED, 0, 0,
+                  MTK_MONITOR_TRANSFORM_NORMAL);
+  assert_monitor (1, 1024, 768, META_CRTC_REFRESH_RATE_MODE_FIXED, 1920, 0,
+                  MTK_MONITOR_TRANSFORM_NORMAL);
+  release (1);
+
+  /* apply: mode of the first monitor and position of the second */
+  wait_for_client (2);
+  assert_monitor (0, 1280, 720, META_CRTC_REFRESH_RATE_MODE_FIXED, 0, 0,
+                  MTK_MONITOR_TRANSFORM_NORMAL);
+  assert_monitor (1, 1024, 768, META_CRTC_REFRESH_RATE_MODE_FIXED, 1280, 0,
+                  MTK_MONITOR_TRANSFORM_NORMAL);
+  release (2);
+
+  /* adaptive sync: the variable refresh rate mode */
+  wait_for_client (3);
+  assert_monitor (0, 1920, 1080, META_CRTC_REFRESH_RATE_MODE_VARIABLE, 0, 0,
+                  MTK_MONITOR_TRANSFORM_NORMAL);
+  assert_monitor (1, 1024, 768, META_CRTC_REFRESH_RATE_MODE_FIXED, 1920, 0,
+                  MTK_MONITOR_TRANSFORM_NORMAL);
+  release (3);
+
+  /* three refused configurations changed nothing */
+  wait_for_client (4);
+  assert_monitor (0, 1920, 1080, META_CRTC_REFRESH_RATE_MODE_VARIABLE, 0, 0,
+                  MTK_MONITOR_TRANSFORM_NORMAL);
+  assert_monitor (1, 1024, 768, META_CRTC_REFRESH_RATE_MODE_FIXED, 1920, 0,
+                  MTK_MONITOR_TRANSFORM_NORMAL);
+  release (4);
+
+  /* rotated second monitor below the first, adaptive sync off */
+  wait_for_client (5);
+  assert_monitor (0, 1920, 1080, META_CRTC_REFRESH_RATE_MODE_FIXED, 0, 0,
+                  MTK_MONITOR_TRANSFORM_NORMAL);
+  assert_monitor (1, 1024, 768, META_CRTC_REFRESH_RATE_MODE_FIXED, 0, 1080,
+                  MTK_MONITOR_TRANSFORM_90);
+  release (5);
+
+  /* mirrored: one logical monitor with both monitors */
+  wait_for_client (6);
+  assert_monitor (0, 1024, 768, META_CRTC_REFRESH_RATE_MODE_FIXED, 0, 0,
+                  MTK_MONITOR_TRANSFORM_NORMAL);
+  assert_monitor (1, 1024, 768, META_CRTC_REFRESH_RATE_MODE_FIXED, 0, 0,
+                  MTK_MONITOR_TRANSFORM_NORMAL);
+  g_assert_cmpuint (g_list_length (monitor_manager->logical_monitors), ==, 1);
+  g_assert_true (meta_monitor_get_logical_monitor (get_monitor (0)) ==
+                 meta_monitor_get_logical_monitor (get_monitor (1)));
+  release (6);
+
+  /* disabled second monitor */
+  wait_for_client (7);
+  g_assert_null (meta_monitor_get_logical_monitor (get_monitor (1)));
+  g_assert_false (meta_monitor_is_active (get_monitor (1)));
+  g_assert_cmpuint (g_list_length (monitor_manager->logical_monitors), ==, 1);
+  release (7);
+
+  /* re-enabled; then unplug it under a pending configuration */
+  wait_for_client (8);
+  assert_monitor (1, 1024, 768, META_CRTC_REFRESH_RATE_MODE_FIXED, 1024, 0,
+                  MTK_MONITOR_TRANSFORM_NORMAL);
+  setup_monitors (1);
+  release (8);
+
+  wait_for_client (9);
+  g_assert_cmpuint (g_list_length (meta_monitor_manager_get_monitors (monitor_manager)),
+                    ==, 1);
+  release (9);
+
+  meta_wayland_test_client_finish (client);
+}
+
+typedef struct _MonitorState
+{
+  MetaMonitorModeSpec spec;
+  MtkRectangle layout;
+  MtkMonitorTransform transform;
+} MonitorState;
+
+static void
+get_monitor_state (int           i,
+                   MonitorState *state)
+{
+  MetaMonitor *monitor = get_monitor (i);
+  MetaLogicalMonitor *logical_monitor =
+    meta_monitor_get_logical_monitor (monitor);
+
+  g_assert_nonnull (logical_monitor);
+  memset (state, 0, sizeof (*state));
+  state->spec = *meta_monitor_mode_get_spec (meta_monitor_get_current_mode (monitor));
+  state->layout = meta_logical_monitor_get_layout (logical_monitor);
+  state->transform = logical_monitor->transform;
+}
+
+static void
+run_protocol_error_client (const char *name)
+{
+  MetaWaylandTestClient *client;
+  MonitorState before[2], after[2];
+  int i;
+
+  setup_monitors (2);
+  for (i = 0; i < 2; i++)
+    get_monitor_state (i, &before[i]);
+
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "output-management",
+                                                   name,
+                                                   NULL);
+  g_test_expect_message ("libmutter", G_LOG_LEVEL_WARNING,
+                         "WL: error in client communication*");
+  meta_wayland_test_client_finish (client);
+  g_test_assert_expected_messages ();
+
+  /* Nothing was applied. */
+  for (i = 0; i < 2; i++)
+    {
+      get_monitor_state (i, &after[i]);
+      g_assert_cmpmem (&before[i], sizeof (MonitorState),
+                       &after[i], sizeof (MonitorState));
+    }
+}
+
+static void
+output_management_already_set (void)
+{
+  run_protocol_error_client ("already-set");
+}
+
+static void
+output_management_unconfigured_head (void)
+{
+  run_protocol_error_client ("unconfigured-head");
+}
+
+static void
+on_before_tests (MetaContext *context)
+{
+  MetaWaylandCompositor *compositor =
+    meta_context_get_wayland_compositor (context);
+
+  test_driver = meta_wayland_test_driver_new (compositor);
+}
+
+static void
+on_after_tests (MetaContext *context)
+{
+  g_clear_object (&test_driver);
+}
+
+static void
+init_tests (void)
+{
+  g_test_add_func ("/wayland/output-management/apply",
+                   output_management_apply);
+  g_test_add_func ("/wayland/output-management/already-set",
+                   output_management_already_set);
+  g_test_add_func ("/wayland/output-management/unconfigured-head",
+                   output_management_unconfigured_head);
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_autoptr (MetaContext) context = NULL;
+
+  context = meta_create_test_context (META_CONTEXT_TEST_TYPE_TEST,
+                                      META_CONTEXT_TEST_FLAG_NO_X11 |
+                                      META_CONTEXT_TEST_FLAG_TEST_CLIENT);
+  g_assert_true (meta_context_configure (context, &argc, &argv, NULL));
+
+  test_context = context;
+
+  init_tests ();
+
+  g_signal_connect (context, "before-tests",
+                    G_CALLBACK (on_before_tests), NULL);
+  g_signal_connect (context, "after-tests",
+                    G_CALLBACK (on_after_tests), NULL);
+
+  return meta_context_test_run_tests (META_CONTEXT_TEST (context),
+                                      META_TEST_RUN_FLAG_NONE);
+}
