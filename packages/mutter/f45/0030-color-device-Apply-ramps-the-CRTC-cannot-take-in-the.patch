+  /* Ramp the compositor applies in its final blit (see
+   * clutter_stage_view_set_gamma_lut()) when the CRTC has no gamma LUT and
+   * the ramp is not something the CTM can represent: a nonlinear client
+   * ramp, an ICC VCGT, or night light on an output without a CTM. */
+  MetaGammaLut *shader_gamma_lut;
+  /* Whether the CTM was last programmed to something else than identity. */
