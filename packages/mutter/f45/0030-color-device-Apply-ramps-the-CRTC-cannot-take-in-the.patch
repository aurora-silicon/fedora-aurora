diff --git a/src/backends/meta-renderer-view.c b/src/backends/meta-renderer-view.c
index 113d8fb..5046d1f 100644
--- a/src/backends/meta-renderer-view.c
+++ b/src/backends/meta-renderer-view.c
@@ -32,8 +32,10 @@
 
 #include "backends/meta-renderer-view.h"
 
+#include "backends/meta-backend-private.h"
 #include "backends/meta-color-device.h"
 #include "backends/meta-crtc.h"
+#include "backends/meta-gpu.h"
 #include "backends/meta-renderer.h"
 #include "clutter/clutter-mutter.h"
 #include "core/boxes-private.h"
@@ -57,6 +59,7 @@ typedef struct _MetaRendererViewPrivate
   MetaBackend *backend;
   MetaCrtc *crtc;
   MetaColorDevice *color_device;
+  gboolean inhibits_hw_cursor;
 } MetaRendererViewPrivate;
 
 G_DEFINE_TYPE_WITH_PRIVATE (MetaRendererView, meta_renderer_view,
@@ -119,6 +122,84 @@ on_color_state_changed (MetaColorDevice  *color_device,
   set_color_states (view);
 }
 
+static void
+set_hw_cursor_inhibited (MetaRendererView *view,
+                         gboolean          inhibit)
+{
+  MetaRendererViewPrivate *priv =
+    meta_renderer_view_get_instance_private (view);
+
+  if (priv->inhibits_hw_cursor == inhibit)
+    return;
+
+  priv->inhibits_hw_cursor = inhibit;
+  if (inhibit)
+    meta_backend_inhibit_hw_cursor (priv->backend);
+  else
+    meta_backend_uninhibit_hw_cursor (priv->backend);
+}
+
+static void
+set_shader_gamma (MetaRendererView *view)
+{
+  ClutterStageView *clutter_stage_view = CLUTTER_STAGE_VIEW (view);
+  MetaRendererViewPrivate *priv =
+    meta_renderer_view_get_instance_private (view);
+  const MetaGammaLut *lut;
+
+  lut = meta_color_device_get_shader_gamma_lut (priv->color_device);
+
+  meta_topic (META_DEBUG_RENDER, "Shader gamma ramp for view %s: %s",
+              clutter_stage_view_get_name (clutter_stage_view),
+              lut ? "set" : "none");
+
+  if (lut)
+    {
+      clutter_stage_view_set_gamma_lut (clutter_stage_view, lut->size,
+                                        lut->red, lut->green, lut->blue);
+    }
+  else
+    {
+      clutter_stage_view_set_gamma_lut (clutter_stage_view, 0,
+                                        NULL, NULL, NULL);
+    }
+
+  /* A cursor on a hardware plane would skip the ramp; a CRTC gamma LUT
+   * covers every plane, the final blit only covers what the stage paints. */
+  set_hw_cursor_inhibited (view, lut != NULL);
+}
+
+/* While monitors are rebuilt, the color devices update before the views
+ * are replaced, and the old views' CRTCs may already be gone. Only compare
+ * pointers, never dereference. */
+static gboolean
+is_crtc_current (MetaRendererView *view)
+{
+  MetaRendererViewPrivate *priv =
+    meta_renderer_view_get_instance_private (view);
+  GList *l;
+
+  for (l = meta_backend_get_gpus (priv->backend); l; l = l->next)
+    {
+      if (g_list_find (meta_gpu_get_crtcs (l->data), priv->crtc))
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+static void
+on_shader_gamma_changed (MetaColorDevice  *color_device,
+                         MetaRendererView *view)
+{
+  /* A stale view is about to be replaced; the new one picks the ramp up
+   * when it is constructed. */
+  if (!is_crtc_current (view))
+    return;
+
+  set_shader_gamma (view);
+}
+
 static void
 meta_renderer_view_get_property (GObject    *object,
                                  guint       prop_id,
@@ -193,6 +274,16 @@ meta_renderer_view_constructed (GObject *object)
     }
 
   G_OBJECT_CLASS (meta_renderer_view_parent_class)->constructed (object);
+
+  if (priv->color_device != NULL)
+    {
+      set_shader_gamma (view);
+
+      g_signal_connect_object (priv->color_device, "shader-gamma-changed",
+                               G_CALLBACK (on_shader_gamma_changed),
+                               view,
+                               G_CONNECT_DEFAULT);
+    }
 }
 
 static void
@@ -202,6 +293,7 @@ meta_renderer_view_dispose (GObject *object)
   MetaRendererViewPrivate *priv =
     meta_renderer_view_get_instance_private (view);
 
