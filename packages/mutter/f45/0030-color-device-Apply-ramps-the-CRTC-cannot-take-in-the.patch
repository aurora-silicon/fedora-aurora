   for (l = meta_backend_get_gpus (manager->backend); l; l = l->next)
     {
       MetaGpu *gpu = l->data;
-      GList *l_crtc;
 
-      for (l_crtc = meta_gpu_get_crtcs (gpu); l_crtc; l_crtc = l_crtc->next)
+      /* Every CRTC can do night light: through its gamma LUT, its CTM, or
+       * the compositor's final blit when it has neither (see
