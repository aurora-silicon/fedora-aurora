+static MetaColorDevice *
+setup_vx239_calibrated (gboolean disable_gamma_lut,
+                        gboolean enable_ctm)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  MetaColorManager *color_manager =
+    meta_backend_get_color_manager (backend);
+  MonitorTestCaseSetup test_case_setup = base_monitor_setup;
+  MetaMonitorTestSetup *test_setup;
+  MetaColorDevice *color_device;
+  MetaMonitor *monitor;
+  const char *profile_id = VX239_ICC_PROFILE_ID;
+  const char *color_profiles[1];
+
+  test_case_setup.outputs[0].edid_info = ANCOR_VX239_EDID;
+  test_case_setup.outputs[0].has_edid_info = TRUE;
+  test_case_setup.crtcs[0].disable_gamma_lut = disable_gamma_lut;
+  test_case_setup.crtcs[0].enable_ctm = enable_ctm;
+  test_setup = meta_create_monitor_test_setup (backend, &test_case_setup,
+                                               MONITOR_TEST_FLAG_NO_STORED);
+  meta_monitor_manager_test_emulate_hotplug (
+    META_MONITOR_MANAGER_TEST (monitor_manager), test_setup);
+
+  monitor = meta_monitor_manager_get_monitors (monitor_manager)->data;
+  color_device = meta_color_manager_get_color_device (color_manager, monitor);
+  g_assert_nonnull (color_device);
+  while (!meta_color_device_is_ready (color_device))
+    g_main_context_iteration (NULL, TRUE);
+
+  color_profiles[0] = profile_id;
+  set_colord_device_profiles (meta_color_device_get_id (color_device),
+                              color_profiles, G_N_ELEMENTS (color_profiles));
+  wait_for_profile_assigned (color_device, profile_id);
+
+  return color_device;
+}
+
+static MetaGammaLut *
+copy_crtc_gamma (MetaColorDevice *color_device)
+{
+  MetaMonitor *monitor = meta_color_device_get_monitor (color_device);
+  MetaOutput *output = meta_monitor_get_main_output (monitor);
+  MetaCrtcTest *crtc_test =
+    META_CRTC_TEST (meta_output_get_assigned_crtc (output));
+
+  return meta_gamma_lut_new (crtc_test->gamma.size,
+                             crtc_test->gamma.red,
+                             crtc_test->gamma.green,
+                             crtc_test->gamma.blue);
+}
+
+static void
+wait_for_shader_gamma (MetaColorDevice    *color_device,
+                       const MetaGammaLut *expected)
+{
+  while (TRUE)
+    {
+      const MetaGammaLut *lut =
+        meta_color_device_get_shader_gamma_lut (color_device);
+
+      if (lut && meta_gamma_lut_equal (lut, expected))
+        break;
+
+      g_main_context_iteration (NULL, TRUE);
+    }
+}
+
+static void
+assert_ctm_identity_or_unset (MetaColorDevice *color_device)
+{
+  MetaMonitor *monitor = meta_color_device_get_monitor (color_device);
+  MetaOutput *output = meta_monitor_get_main_output (monitor);
+  MetaCrtcTest *crtc_test =
+    META_CRTC_TEST (meta_output_get_assigned_crtc (output));
+  g_autoptr (MetaCtm) identity = NULL;
+
+  if (!crtc_test->ctm)
+    return;
+
+  identity = meta_ctm_new_from_rgb_scales (1.0f, 1.0f, 1.0f);
+  g_assert_cmpmem (crtc_test->ctm->matrix, sizeof (crtc_test->ctm->matrix),
+                   identity->matrix, sizeof (identity->matrix));
+}
+
+/*
+ * An ICC profile with a VCGT on a CRTC without a gamma LUT (only a CTM, like
+ * the Apple DCP): the calibration curves, with night light on top, reach the
+ * screen exactly as a gamma LUT would have applied them.
+ */
+static void
+meta_test_color_management_night_light_calibrated_shader (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaColorDevice *color_device;
+  g_autoptr (MetaGammaLut) gamma_lut_off = NULL;
+  g_autoptr (MetaGammaLut) gamma_lut_on = NULL;
+  ClutterActor *pattern;
+  const char *profile_id = VX239_ICC_PROFILE_ID;
+  const char *path;
+
+  path = g_test_get_filename (G_TEST_DIST,
+                              "icc-profiles", "vx239-calibrated.icc",
+                              NULL);
+  add_colord_system_profile (profile_id, path);
+
+  /* Reference: what a CRTC gamma LUT gets, night light off and at 3305K. */
+  set_night_light_temperature (6500);
+  set_night_light_active (FALSE);
+  color_device = setup_vx239_calibrated (FALSE, FALSE);
+  gamma_lut_off = copy_crtc_gamma (color_device);
+  g_assert_cmpuint (gamma_lut_off->size, ==, 256);
+
+  set_night_light_temperature (3305);
+  set_night_light_active (TRUE);
+  wait_for_device_calibration_changed (color_device);
+  gamma_lut_on = copy_crtc_gamma (color_device);
+  g_assert_false (meta_gamma_lut_equal (gamma_lut_on, gamma_lut_off));
+
+  /* The same monitor on a CRTC with only a CTM. */
+  color_device = setup_vx239_calibrated (TRUE, TRUE);
+  pattern = meta_gamma_test_add_pattern (backend);
+
+  wait_for_shader_gamma (color_device, gamma_lut_on);
+  assert_ctm_identity_or_unset (color_device);
+  g_assert_true (clutter_stage_view_has_gamma_lut (
+    meta_gamma_test_get_view (backend)));
+  meta_gamma_test_assert_view (backend, gamma_lut_on, "vcgt-night-light-3305");
+
+  set_night_light_temperature (6500);
+  set_night_light_active (FALSE);
+  wait_for_shader_gamma (color_device, gamma_lut_off);
+  assert_ctm_identity_or_unset (color_device);
+  meta_gamma_test_assert_view (backend, gamma_lut_off, "vcgt-calibration");
+
+  clutter_actor_destroy (pattern);
+}
+
 static MetaMonitorTestSetup *
 create_stage_view_test_setup (MetaBackend *backend)
 {
@@ -1908,6 +2048,8 @@ init_tests (void)
                   meta_test_color_management_ctm_scale_clamping);
   add_color_test ("/color-management/night-light/supported",
                   meta_test_color_management_night_light_supported);
+  add_color_test ("/color-management/night-light/calibrated-shader",
+                  meta_test_color_management_night_light_calibrated_shader);
 }
 
