+static MetaGammaLut *
+create_curve_ramp (void)
+{
+  MetaGammaLut *lut = meta_gamma_lut_new_sized (GAMMA_SIZE);
+  int64_t n = GAMMA_SIZE - 1;
+  int i;
+
+  for (i = 0; i < GAMMA_SIZE; i++)
+    {
+      int64_t j = n - i;
+
+      lut->red[i] = (uint16_t) ((i * (int64_t) i * 65535) / (n * n));
+      lut->green[i] = (uint16_t) (65535 - (j * j * 65535) / (n * n));
+      lut->blue[i] = (uint16_t) (6554 + (i * (int64_t) 45874) / n);
+    }
+
+  return lut;
