+#include "config.h"
+
+#include "tests/meta-gamma-test-utils.h"
+
+#include <cairo.h>
+#include <math.h>
+#include <stdio.h>
+
+#include "backends/meta-backend-private.h"
+#include "backends/meta-monitor-private.h"
+#include "backends/meta-renderer.h"
+#include "clutter/clutter-mutter.h"
+
+#define N_LEVELS 256
+
+static void
+pattern_input (int      band,
+               int      v,
+               uint8_t  rgb[3])
+{
+  switch (band)
+    {
+    case 0:
+      rgb[0] = rgb[1] = rgb[2] = (uint8_t) v;
+      break;
+    case 1:
+      rgb[0] = (uint8_t) v; rgb[1] = 0; rgb[2] = 0;
+      break;
+    case 2:
+      rgb[0] = 0; rgb[1] = (uint8_t) v; rgb[2] = 0;
+      break;
+    case 3:
+      rgb[0] = 0; rgb[1] = 0; rgb[2] = (uint8_t) v;
+      break;
+    default:
+      rgb[0] = (uint8_t) v;
+      rgb[1] = (uint8_t) (255 - v);
+      rgb[2] = (uint8_t) ((v * 3) % 256);
+      break;
+    }
+}
+
+ClutterStageView *
+meta_gamma_test_get_view (MetaBackend *backend)
+{
+  MetaRenderer *renderer = meta_backend_get_renderer (backend);
+  GList *views = meta_renderer_get_views (renderer);
+
+  g_assert_cmpuint (g_list_length (views), ==, 1);
+  return CLUTTER_STAGE_VIEW (views->data);
+}
+
+ClutterActor *
+meta_gamma_test_add_pattern (MetaBackend *backend)
+{
+  ClutterActor *stage = meta_backend_get_stage (backend);
+  ClutterStageView *view = meta_gamma_test_get_view (backend);
+  ClutterActor *pattern;
+  MtkRectangle layout;
+  float column_width, band_height;
+  int band, v;
+
+  clutter_stage_view_get_layout (view, &layout);
+  column_width = layout.width / (float) N_LEVELS;
+  band_height = layout.height / (float) META_GAMMA_TEST_N_BANDS;
+  g_assert_cmpfloat (column_width, ==, floorf (column_width));
+  g_assert_cmpfloat (column_width, >=, 1.0f);
+
+  pattern = clutter_actor_new ();
+  clutter_actor_set_position (pattern, layout.x, layout.y);
+  clutter_actor_set_size (pattern, layout.width, layout.height);
+
+  for (band = 0; band < META_GAMMA_TEST_N_BANDS; band++)
+    {
+      for (v = 0; v < N_LEVELS; v++)
+        {
+          ClutterActor *column = clutter_actor_new ();
+          uint8_t rgb[3];
+          CoglColor color;
+
+          pattern_input (band, v, rgb);
+          cogl_color_init_from_4f (&color,
+                                   rgb[0] / 255.0f,
+                                   rgb[1] / 255.0f,
+                                   rgb[2] / 255.0f,
+                                   1.0f);
+          clutter_actor_set_background_color (column, &color);
+          clutter_actor_set_position (column,
+                                      v * column_width,
+                                      floorf (band * band_height));
+          clutter_actor_set_size (column, column_width,
+                                  floorf ((band + 1) * band_height) -
+                                  floorf (band * band_height));
+          clutter_actor_add_child (pattern, column);
+        }
+    }
+
+  clutter_actor_add_child (stage, pattern);
+  return pattern;
+}
+
+static uint8_t
+expected_value (const MetaGammaLut *lut,
+                int                 channel,
+                uint8_t             input)
+{
+  const uint16_t *ramp;
+  double pos, frac, value;
+  size_t index0, index1;
+
+  if (!lut)
+    return input;
+
+  ramp = channel == 0 ? lut->red : channel == 1 ? lut->green : lut->blue;
+  pos = input / 255.0 * (double) (lut->size - 1);
+  index0 = (size_t) floor (pos);
+  index1 = MIN (index0 + 1, lut->size - 1);
+  frac = pos - (double) index0;
+  value = (ramp[index0] * (1.0 - frac) + ramp[index1] * frac) / 65535.0;
+
+  return (uint8_t) lround (CLAMP (value, 0.0, 1.0) * 255.0);
+}
+
+typedef struct
+{
+  ClutterStageView *view;
+  gboolean painted;
+} PaintData;
+
+static void
+on_after_paint (ClutterStage     *stage,
+                ClutterStageView *view,
+                ClutterFrame     *frame,
+                PaintData        *data)
+{
+  if (view == data->view)
+    data->painted = TRUE;
+}
+
+/* The final blit runs after the stage paint watchers, so read the onscreen
+ * framebuffer once the whole frame is done. */
+static uint8_t *
+read_onscreen (MetaBackend      *backend,
+               ClutterStageView *view,
+               int              *width,
+               int              *height)
+{
+  ClutterActor *stage = meta_backend_get_stage (backend);
+  CoglFramebuffer *onscreen = clutter_stage_view_get_onscreen (view);
+  PaintData data = { .view = view };
+  uint8_t *pixels;
+  gulong handler_id;
+
+  handler_id = g_signal_connect (stage, "after-paint",
+                                 G_CALLBACK (on_after_paint), &data);
+  clutter_stage_view_add_redraw_clip (view, NULL);
+  clutter_stage_view_schedule_update (view);
+  while (!data.painted)
+    g_main_context_iteration (NULL, TRUE);
+  g_signal_handler_disconnect (stage, handler_id);
+
+  *width = cogl_framebuffer_get_width (onscreen);
+  *height = cogl_framebuffer_get_height (onscreen);
+  pixels = g_malloc0 ((size_t) *width * *height * 4);
+  g_assert_true (cogl_framebuffer_read_pixels (onscreen, 0, 0,
+                                               *width, *height,
+                                               COGL_PIXEL_FORMAT_RGBA_8888,
+                                               pixels));
+  return pixels;
+}
+
+static void
+write_png (const char    *path,
+           const uint8_t *pixels,
+           int            width,
+           int            height)
+{
+  cairo_surface_t *surface;
+  uint8_t *data;
+  int stride, x, y;
+
+  surface = cairo_image_surface_create (CAIRO_FORMAT_RGB24, width, height);
+  data = cairo_image_surface_get_data (surface);
+  stride = cairo_image_surface_get_stride (surface);
+  for (y = 0; y < height; y++)
+    {
+      for (x = 0; x < width; x++)
+        {
+          const uint8_t *src = &pixels[(y * width + x) * 4];
+          uint32_t *dst = (uint32_t *) (data + y * stride) + x;
+
+          *dst = 0xff000000u | (src[0] << 16) | (src[1] << 8) | src[2];
+        }
+    }
+  cairo_surface_mark_dirty (surface);
+  g_assert_cmpint (cairo_surface_write_to_png (surface, path), ==,
+                   CAIRO_STATUS_SUCCESS);
+  cairo_surface_destroy (surface);
+}
+
+MetaGammaTestResult
+meta_gamma_test_check_view (MetaBackend        *backend,
+                            const MetaGammaLut *lut,
+                            const char         *name)
+{
+  ClutterStageView *view = meta_gamma_test_get_view (backend);
+  MetaGammaTestResult result = { 0 };
+  const char *dump_dir = g_getenv ("MUTTER_GAMMA_TEST_DUMP_DIR");
+  g_autofree uint8_t *pixels = NULL;
+  g_autoptr (GString) table = NULL;
+  int width, height, column_width, band_height;
+  int band, v, c;
+
+  pixels = read_onscreen (backend, view, &width, &height);
+  column_width = width / N_LEVELS;
+  band_height = height / META_GAMMA_TEST_N_BANDS;
+
+  if (dump_dir)
+    table = g_string_new ("# band input_rgb expected_rgb readback_rgb\n");
+
+  for (band = 0; band < META_GAMMA_TEST_N_BANDS; band++)
+    {
+      for (v = 0; v < N_LEVELS; v++)
+        {
+          /* Sample the middle of the column and of the band. */
+          int x = v * column_width + column_width / 2;
+          int y = band * band_height + band_height / 2;
+          const uint8_t *pixel = &pixels[(y * width + x) * 4];
+          uint8_t input[3], expected[3];
+          gboolean mismatched = FALSE;
+
+          pattern_input (band, v, input);
+          for (c = 0; c < 3; c++)
+            {
+              int diff;
+
+              expected[c] = expected_value (lut, c, input[c]);
+              diff = abs ((int) pixel[c] - (int) expected[c]);
+              result.max_diff = MAX (result.max_diff, diff);
+              if (diff)
+                mismatched = TRUE;
+            }
+
+          result.n_pixels++;
+          if (mismatched)
+            result.n_mismatched++;
+
+          if (table)
+            {
+              g_string_append_printf (table,
+                                      "%d %3d,%3d,%3d %3d,%3d,%3d %3d,%3d,%3d%s\n",
+                                      band,
+                                      input[0], input[1], input[2],
+                                      expected[0], expected[1], expected[2],
+                                      pixel[0], pixel[1], pixel[2],
+                                      mismatched ? " MISMATCH" : "");
+            }
+        }
+    }
+
+  g_test_message ("%s: %d/%d samples exact, max diff %d (%s)",
+                  name, result.n_pixels - result.n_mismatched,
+                  result.n_pixels, result.max_diff,
+                  lut ? "ramp" : "identity");
+
+  if (dump_dir)
+    {
+      g_autofree char *png_path = NULL;
+      g_autofree char *txt_path = NULL;
+      g_autofree char *base = NULL;
+
+      g_mkdir_with_parents (dump_dir, 0755);
+      base = g_build_filename (dump_dir, name, NULL);
+      png_path = g_strdup_printf ("%s.png", base);
+      txt_path = g_strdup_printf ("%s.txt", base);
+      write_png (png_path, pixels, width, height);
+      g_string_append_printf (table,
+                              "# %s: %d/%d samples exact, max diff %d\n",
+                              name, result.n_pixels - result.n_mismatched,
+                              result.n_pixels, result.max_diff);
+      g_assert_true (g_file_set_contents (txt_path, table->str, -1, NULL));
+    }
+
+  return result;
+}
+
+void
+meta_gamma_test_assert_view (MetaBackend        *backend,
+                             const MetaGammaLut *lut,
+                             const char         *name)
+{
+  MetaGammaTestResult result;
+
+  result = meta_gamma_test_check_view (backend, lut, name);
+  g_assert_cmpint (result.n_pixels, ==, 256 * META_GAMMA_TEST_N_BANDS);
+  g_assert_cmpint (result.n_mismatched, ==, 0);
+}
