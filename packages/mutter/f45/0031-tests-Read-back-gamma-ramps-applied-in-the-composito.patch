+/* Must match create_curve_ramp() and create_linear_ramp() in
+ * wayland-gamma-control-tests.c. A curved ramp (power 2 red, inverse
+ * power 2 green, offset blue) and a pure per channel scale. */
+static uint16_t
+curve_value (int channel,
+             int i,
+             int size)
+{
+  int64_t n = size - 1;
+  int64_t j = n - i;
+
+  switch (channel)
+    {
+    case 0:
+      return (uint16_t) ((i * (int64_t) i * 65535) / (n * n));
+    case 1:
+      return (uint16_t) (65535 - (j * j * 65535) / (n * n));
+    default:
+      return (uint16_t) (6554 + (i * (int64_t) 45874) / n);
+    }
+}
+
+static uint16_t
+linear_value (int channel,
+              int i,
+              int size)
+{
+  static const int64_t white[] = { 65535, 54297, 42479 };
+
+  return (uint16_t) ((i * white[channel] + (size - 1) / 2) / (size - 1));
+}
+
+static int
+create_table_fd (uint32_t   size,
+                 uint16_t (*value) (int channel, int i, int size))
+{
+  g_autofree uint16_t *table = NULL;
+  size_t table_size = size * 3 * sizeof (uint16_t);
+  uint32_t i;
+  int c;
+  int fd;
+
+  table = g_malloc0 (table_size);
+  for (c = 0; c < 3; c++)
+    {
+      for (i = 0; i < size; i++)
+        table[c * size + i] = value (c, (int) i, (int) size);
+    }
+
+  fd = create_anonymous_file (table_size);
+  g_assert_cmpint (fd, >=, 0);
+  g_assert_cmpint (write (fd, table, table_size), ==, (ssize_t) table_size);
+  return fd;
+}
