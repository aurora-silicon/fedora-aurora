 GList * meta_kms_device_get_connectors (MetaKmsDevice *device);
 
diff --git a/src/backends/native/meta-kms-impl-device-atomic.c b/src/backends/native/meta-kms-impl-device-atomic.c
index 8c8da83..7f460b6 100644
--- a/src/backends/native/meta-kms-impl-device-atomic.c
+++ b/src/backends/native/meta-kms-impl-device-atomic.c
@@ -1084,6 +1084,8 @@ commit_flags_string (uint32_t commit_flags)
     commit_flag_strings[i++] = "ATOMIC_ALLOW_MODESET";
   if (commit_flags & DRM_MODE_PAGE_FLIP_EVENT)
     commit_flag_strings[i++] = "PAGE_FLIP_EVENT";
+  if (commit_flags & DRM_MODE_PAGE_FLIP_ASYNC)
+    commit_flag_strings[i++] = "PAGE_FLIP_ASYNC";
   if (commit_flags & DRM_MODE_ATOMIC_TEST_ONLY)
     commit_flag_strings[i++] = "TEST_ONLY";
 
@@ -1198,6 +1200,8 @@ meta_kms_impl_device_atomic_process_update (MetaKmsImplDevice *impl_device,
   g_autoptr (GArray) blob_ids = NULL;
   int fd;
   uint32_t commit_flags = 0;
+  gboolean async_flip = FALSE;
+  MetaKmsFeedback *feedback;
   int ret;
 
   blob_ids = g_array_new (FALSE, TRUE, sizeof (uint32_t));
@@ -1280,12 +1284,42 @@ meta_kms_impl_device_atomic_process_update (MetaKmsImplDevice *impl_device,
   if (flags & META_KMS_UPDATE_FLAG_TEST_ONLY)
     commit_flags |= DRM_MODE_ATOMIC_TEST_ONLY;
 
+  if (meta_kms_update_get_async_flip (update) &&
+      !(flags & META_KMS_UPDATE_FLAG_TEST_ONLY))
+    {
+      MetaKmsDeviceCaps *caps = meta_kms_impl_device_get_caps (impl_device);
+      const char *reason = NULL;
+
+      if (!caps->atomic_async_page_flip)
+        reason = "driver does not support atomic async page flips";
+      else if (meta_kms_update_can_flip_async (update, &reason))
+        async_flip = TRUE;
+
+      if (async_flip)
+        commit_flags |= DRM_MODE_PAGE_FLIP_ASYNC;
+      else
+        meta_topic (META_DEBUG_KMS,
+                    "[atomic] Not flipping asynchronously: %s", reason);
+    }
+
   meta_topic (META_DEBUG_KMS,
               "[atomic] Committing update flags: %s",
               commit_flags_string (commit_flags));
 
   fd = meta_kms_impl_device_get_fd (impl_device);
   ret = drmModeAtomicCommit (fd, req, commit_flags, impl_device);
+  if (ret < 0 && async_flip)
+    {
+      /* The driver may refuse an asynchronous flip it cannot do right now
+       * (e.g. a buffer with a different modifier); flip synchronously.
+       */
+      meta_topic (META_DEBUG_KMS,
+                  "[atomic] Async page flip refused (%s), committing "
+                  "synchronously", g_strerror (-ret));
+      async_flip = FALSE;
+      commit_flags &= ~DRM_MODE_PAGE_FLIP_ASYNC;
+      ret = drmModeAtomicCommit (fd, req, commit_flags, impl_device);
+    }
   if (ret < 0)
     {
       g_set_error (&error, G_IO_ERROR, g_io_error_from_errno (-ret),
@@ -1306,7 +1340,9 @@ meta_kms_impl_device_atomic_process_update (MetaKmsImplDevice *impl_device,
 
   release_blob_ids (impl_device, blob_ids);
 
-  return meta_kms_feedback_new_passed (NULL);
+  feedback = meta_kms_feedback_new_passed (NULL);
+  meta_kms_feedback_set_async_flip (feedback, async_flip);
+  return feedback;
 
 err:
   meta_topic (META_DEBUG_KMS, "[atomic] KMS update failed: %s", error->message);
diff --git a/src/backends/native/meta-kms-impl-device-simple.c b/src/backends/native/meta-kms-impl-device-simple.c
index ae843d0..47608c5 100644
--- a/src/backends/native/meta-kms-impl-device-simple.c
+++ b/src/backends/native/meta-kms-impl-device-simple.c
@@ -65,6 +65,9 @@ struct _MetaKmsImplDeviceSimple
   GList *posted_page_flip_datas;
 
   GHashTable *cached_mode_sets;
+
