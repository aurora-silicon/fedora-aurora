diff --git a/src/backends/native/meta-kms-device.c b/src/backends/native/meta-kms-device.c
index acf0b45..018927f 100644
--- a/src/backends/native/meta-kms-device.c
+++ b/src/backends/native/meta-kms-device.c
@@ -128,6 +128,15 @@ meta_kms_device_prefers_shadow_buffer (MetaKmsDevice *device)
   return device->caps.prefers_shadow_buffer;
 }
 
+gboolean
+meta_kms_device_supports_async_page_flip (MetaKmsDevice *device)
+{
+  if (META_IS_KMS_IMPL_DEVICE_ATOMIC (device->impl_device))
+    return device->caps.atomic_async_page_flip;
+  else
+    return device->caps.async_page_flip;
+}
+
 gboolean
 meta_kms_device_uses_monotonic_clock (MetaKmsDevice *device)
 {
