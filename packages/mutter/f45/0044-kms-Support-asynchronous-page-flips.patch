   int sync_fd;
 
   int64_t target_presentation_time_us;
+
+  gboolean async_flip;
 };
 
 void
@@ -1158,6 +1160,11 @@ meta_kms_update_merge_from (MetaKmsUpdate *update,
   update->target_presentation_time_us =
     MAX (update->target_presentation_time_us,
          other_update->target_presentation_time_us);
+
+  /* Whether the merged update can still flip asynchronously is checked when
+   * it is committed (meta_kms_update_can_flip_async()).
+   */
+  update->async_flip |= other_update->async_flip;
 }
 
 gboolean
@@ -1264,3 +1271,102 @@ meta_kms_update_is_empty (MetaKmsUpdate *update)
           !update->crtc_updates &&
           !update->crtc_color_updates);
 }
+
+/**
+ * meta_kms_update_set_async_flip:
+ * @update: a #MetaKmsUpdate
+ * @async_flip: whether to page flip without waiting for vertical blank
+ *
+ * Asks for the update to be committed with an asynchronous (tearing) page
+ * flip, right away instead of at the deadline before the next vertical
+ * blank. The device falls back to a synchronous flip when the driver cannot
+ * flip asynchronously, when the update changes more than the primary plane
+ * buffers, or when the driver refuses the asynchronous flip.
+ */
+void
+meta_kms_update_set_async_flip (MetaKmsUpdate *update,
+                                gboolean       async_flip)
+{
+  update->async_flip = async_flip;
+}
+
+gboolean
+meta_kms_update_get_async_flip (MetaKmsUpdate *update)
+{
+  return update->async_flip;
+}
+
+/*
+ * Atomic asynchronous page flips may only change the buffers of primary
+ * planes; anything else (mode sets, connector or CRTC properties, color
+ * updates, cursor or overlay planes) needs a synchronous commit.
+ */
+gboolean
+meta_kms_update_can_flip_async (MetaKmsUpdate  *update,
+                                const char    **reason)
+{
+  GList *l;
+
+  if (update->mode_sets || update->needs_modeset)
+    {
+      *reason = "mode set";
+      return FALSE;
+    }
+
+  if (update->connector_updates)
+    {
+      *reason = "connector update";
+      return FALSE;
+    }
+
+  if (update->crtc_updates)
+    {
+      *reason = "CRTC update";
+      return FALSE;
+    }
+
+  if (update->crtc_color_updates)
+    {
+      *reason = "CRTC color update";
+      return FALSE;
+    }
+
+  if (!update->plane_assignments)
+    {
+      *reason = "no plane assignment";
+      return FALSE;
+    }
+
+  for (l = update->plane_assignments; l; l = l->next)
+    {
+      MetaKmsPlaneAssignment *plane_assignment = l->data;
+
+      if (meta_kms_plane_get_plane_type (plane_assignment->plane) !=
+          META_KMS_PLANE_TYPE_PRIMARY)
+        {
+          *reason = "non-primary plane update";
+          return FALSE;
+        }
+
+      if (!plane_assignment->buffer)
+        {
+          *reason = "primary plane disabled";
+          return FALSE;
+        }
+    }
+
+  return TRUE;
+}
+
+gboolean
+meta_kms_feedback_is_async_flip (const MetaKmsFeedback *feedback)
+{
+  return feedback->async_flip;
+}
+
+void
+meta_kms_feedback_set_async_flip (MetaKmsFeedback *feedback,
+                                  gboolean         async_flip)
+{
+  feedback->async_flip = async_flip;
+}
