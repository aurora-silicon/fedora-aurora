+  gboolean flipped_async;
 };
 
 static GInitableIface *initable_parent_iface;
@@ -1141,18 +1144,59 @@ dispatch_page_flip (MetaKmsImplDevice    *impl_device,
   fd = meta_kms_impl_device_get_fd (impl_device);
   fb_id = meta_drm_buffer_get_fb_id (plane_assignment->buffer);
 
-  meta_topic (META_DEBUG_KMS,
-              "[simple] Page flipping CRTC %u (%s) with %u, data: %p",
-              meta_kms_crtc_get_id (crtc),
-              meta_kms_impl_device_get_path (impl_device),
-              fb_id,
-              page_flip_data);
+  ret = -EINVAL;
+  if (meta_kms_update_get_async_flip (update) &&
+      !meta_kms_update_get_mode_sets (update))
+    {
+      MetaKmsDeviceCaps *caps = meta_kms_impl_device_get_caps (impl_device);
 
-  ret = drmModePageFlip (fd,
-                         meta_kms_crtc_get_id (crtc),
-                         fb_id,
-                         DRM_MODE_PAGE_FLIP_EVENT,
-                         page_flip_data);
+      if (caps->async_page_flip)
+        {
+          meta_topic (META_DEBUG_KMS,
+                      "[simple] Page flipping CRTC %u (%s) asynchronously "
+                      "with %u, data: %p",
+                      meta_kms_crtc_get_id (crtc),
+                      meta_kms_impl_device_get_path (impl_device),
+                      fb_id,
+                      page_flip_data);
+
+          ret = drmModePageFlip (fd,
+                                 meta_kms_crtc_get_id (crtc),
+                                 fb_id,
+                                 DRM_MODE_PAGE_FLIP_EVENT |
+                                 DRM_MODE_PAGE_FLIP_ASYNC,
+                                 page_flip_data);
+          if (ret == 0)
+            impl_device_simple->flipped_async = TRUE;
+          else
+            meta_topic (META_DEBUG_KMS,
+                        "[simple] Async page flip refused (%s), flipping "
+                        "synchronously",
+                        g_strerror (-ret));
+        }
+      else
+        {
+          meta_topic (META_DEBUG_KMS,
+                      "[simple] Not flipping asynchronously: driver does not "
+                      "support async page flips");
+        }
+    }
+
+  if (!impl_device_simple->flipped_async)
+    {
+      meta_topic (META_DEBUG_KMS,
+                  "[simple] Page flipping CRTC %u (%s) with %u, data: %p",
+                  meta_kms_crtc_get_id (crtc),
+                  meta_kms_impl_device_get_path (impl_device),
+                  fb_id,
+                  page_flip_data);
+
+      ret = drmModePageFlip (fd,
+                             meta_kms_crtc_get_id (crtc),
+                             fb_id,
+                             DRM_MODE_PAGE_FLIP_EVENT,
+                             page_flip_data);
+    }
 
   if (ret == -EBUSY)
     {
@@ -1664,9 +1708,12 @@ meta_kms_impl_device_simple_process_update (MetaKmsImplDevice *impl_device,
                                             MetaKmsUpdate     *update,
                                             MetaKmsUpdateFlag  flags)
 {
+  MetaKmsImplDeviceSimple *impl_device_simple =
+    META_KMS_IMPL_DEVICE_SIMPLE (impl_device);
   GError *error = NULL;
   GList *failed_planes = NULL;
   g_autoptr (GArray) blob_ids = NULL;
+  MetaKmsFeedback *feedback;
 
   blob_ids = g_array_new (FALSE, TRUE, sizeof (uint32_t));
 
@@ -1710,13 +1757,17 @@ meta_kms_impl_device_simple_process_update (MetaKmsImplDevice *impl_device,
   if (!process_plane_assignments (impl_device, update, &failed_planes, &error))
     goto err;
 
+  impl_device_simple->flipped_async = FALSE;
   if (!maybe_dispatch_page_flips (impl_device, update, &failed_planes, flags,
                                   &error))
     goto err;
 
   release_blob_ids (impl_device, blob_ids);
 
-  return meta_kms_feedback_new_passed (failed_planes);
+  feedback = meta_kms_feedback_new_passed (failed_planes);
+  meta_kms_feedback_set_async_flip (feedback, impl_device_simple->flipped_async);
+  impl_device_simple->flipped_async = FALSE;
+  return feedback;
 
 err:
   release_blob_ids (impl_device, blob_ids);
