+++ b/src/backends/native/meta-kms-impl-device.c
@@ -576,6 +576,7 @@ init_caps (MetaKmsImplDevice *impl_device)
   uint64_t prefer_shadow;
   uint64_t uses_monotonic_clock;
   uint64_t addfb2_modifiers;
+  uint64_t async_page_flip;
 
   fd = meta_device_file_get_fd (priv->device_file);
   if (drmGetCap (fd, DRM_CAP_CURSOR_WIDTH, &cursor_width) == 0 &&
@@ -603,6 +604,21 @@ init_caps (MetaKmsImplDevice *impl_device)
     {
       priv->caps.addfb2_modifiers = (addfb2_modifiers != 0);
     }
+
+  if (drmGetCap (fd, DRM_CAP_ASYNC_PAGE_FLIP, &async_page_flip) == 0)
+    priv->caps.async_page_flip = (async_page_flip != 0);
+
+#ifndef DRM_CAP_ATOMIC_ASYNC_PAGE_FLIP
+#define DRM_CAP_ATOMIC_ASYNC_PAGE_FLIP 0x15
+#endif
+  if (drmGetCap (fd, DRM_CAP_ATOMIC_ASYNC_PAGE_FLIP, &async_page_flip) == 0)
+    priv->caps.atomic_async_page_flip = (async_page_flip != 0);
+
+  meta_topic (META_DEBUG_KMS,
+              "Device '%s' async page flips: legacy %s, atomic %s",
+              priv->path,
+              priv->caps.async_page_flip ? "yes" : "no",
+              priv->caps.atomic_async_page_flip ? "yes" : "no");
 }
 
 static void
@@ -2052,8 +2068,12 @@ meta_kms_impl_device_update_ready (MetaThreadImpl  *impl,
 
   latch_crtc = g_steal_pointer (&crtc_frame->submitted_update.latch_crtc);
 
+  /* An asynchronous flip is committed as soon as it is ready, not at the
+   * deadline before the next vertical blank.
