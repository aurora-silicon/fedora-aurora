+
+/*
+ * xdg-decoration-unstable-v1: lets a client negotiate server-side
+ * decorations for its xdg_toplevel.
+ *
+ * The effective mode follows the "decoration-mode" key of
+ * org.gnome.mutter.wayland: "client-preference" (the default) honours the
+ * mode the client asks for, and picks server-side decorations when the
+ * client has no preference; "server-side" and "client-side" force the
+ * mode for every client that binds the protocol. Clients that never create
+ * a decoration object keep drawing their own decorations.
+ *
+ * The mode is part of the toplevel's MetaWaylandWindowConfiguration, so it
+ * goes out with, and takes effect on the ack of, a regular configure. The
+ * titlebar and borders themselves are drawn by MetaWindowDecoration.
+ */
+
+#include "config.h"
+
+#include "wayland/meta-wayland-xdg-decoration.h"
+
+#include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-surface-private.h"
+#include "wayland/meta-wayland-versions.h"
+#include "wayland/meta-window-wayland.h"
+
+#include "xdg-decoration-unstable-v1-server-protocol.h"
+
+#define DECORATION_SCHEMA "org.gnome.mutter.wayland"
+#define DECORATION_MODE_KEY "decoration-mode"
+
+typedef enum _MetaDecorationPolicy
+{
+  META_DECORATION_POLICY_CLIENT_PREFERENCE,
+  META_DECORATION_POLICY_SERVER_SIDE,
+  META_DECORATION_POLICY_CLIENT_SIDE,
+} MetaDecorationPolicy;
+
+typedef struct _MetaWaylandXdgDecorationManager
+{
+  MetaWaylandCompositor *compositor;
+  GSettings *settings;
+  MetaDecorationPolicy policy;
+  GList *decorations;
+} MetaWaylandXdgDecorationManager;
+
+typedef struct _MetaWaylandXdgToplevelDecoration
+{
+  MetaWaylandXdgDecorationManager *manager;
+  struct wl_resource *resource;
+  MetaWaylandXdgToplevel *xdg_toplevel;
+
+  /* 0 when the client has no preference. */
+  uint32_t requested_mode;
+
+  gboolean configure_sent;
+  uint32_t sent_mode;
+} MetaWaylandXdgToplevelDecoration;
+
+static GQuark quark_decoration;
+
+static MetaWaylandXdgToplevelDecoration *
+decoration_from_xdg_toplevel (MetaWaylandXdgToplevel *xdg_toplevel)
+{
+  return g_object_get_qdata (G_OBJECT (xdg_toplevel), quark_decoration);
+}
+
+static MetaWaylandXdgToplevelDecoration *
+decoration_from_surface (MetaWaylandSurface *surface)
+{
+  if (!surface || !META_IS_WAYLAND_XDG_TOPLEVEL (surface->role))
+    return NULL;
+
+  return decoration_from_xdg_toplevel (META_WAYLAND_XDG_TOPLEVEL (surface->role));
+}
+
+static uint32_t
+get_effective_mode (MetaWaylandXdgToplevelDecoration *decoration)
+{
+  switch (decoration->manager->policy)
+    {
+    case META_DECORATION_POLICY_SERVER_SIDE:
+      return ZXDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE;
+    case META_DECORATION_POLICY_CLIENT_SIDE:
+      return ZXDG_TOPLEVEL_DECORATION_V1_MODE_CLIENT_SIDE;
+    case META_DECORATION_POLICY_CLIENT_PREFERENCE:
+      break;
+    }
+
+  if (decoration->requested_mode == ZXDG_TOPLEVEL_DECORATION_V1_MODE_CLIENT_SIDE)
+    return ZXDG_TOPLEVEL_DECORATION_V1_MODE_CLIENT_SIDE;
+
+  return ZXDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE;
+}
+
+gboolean
+meta_wayland_xdg_decoration_has_decoration (MetaWaylandSurface *surface)
+{
+  return decoration_from_surface (surface) != NULL;
+}
+
+gboolean
+meta_wayland_xdg_decoration_wants_server_side (MetaWaylandSurface *surface)
+{
+  MetaWaylandXdgToplevelDecoration *decoration =
+    decoration_from_surface (surface);
+
+  if (!decoration)
+    return FALSE;
+
+  return get_effective_mode (decoration) ==
+         ZXDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE;
+}
+
+void
+meta_wayland_xdg_decoration_send_configure (MetaWaylandXdgToplevel *xdg_toplevel,
+                                            gboolean                server_side)
+{
+  MetaWaylandXdgToplevelDecoration *decoration =
+    decoration_from_xdg_toplevel (xdg_toplevel);
+  uint32_t mode;
+
+  if (!decoration)
+    return;
+
+  mode = server_side ? ZXDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE
+                     : ZXDG_TOPLEVEL_DECORATION_V1_MODE_CLIENT_SIDE;
+
+  if (decoration->configure_sent && decoration->sent_mode == mode)
+    return;
+
+  zxdg_toplevel_decoration_v1_send_configure (decoration->resource, mode);
+  decoration->configure_sent = TRUE;
+  decoration->sent_mode = mode;
+}
+
+static void
+on_xdg_toplevel_finalized (MetaWaylandXdgToplevelDecoration *decoration)
+{
+  decoration->xdg_toplevel = NULL;
+}
+
+static void
+decoration_detach (MetaWaylandXdgToplevelDecoration *decoration)
+{
+  if (!decoration->xdg_toplevel)
+    return;
+
+  g_object_steal_qdata (G_OBJECT (decoration->xdg_toplevel),
+                        quark_decoration);
+  decoration->xdg_toplevel = NULL;
+}
+
+void
+meta_wayland_xdg_decoration_toplevel_destroyed (MetaWaylandXdgToplevel *xdg_toplevel)
+{
+  MetaWaylandXdgToplevelDecoration *decoration =
+    decoration_from_xdg_toplevel (xdg_toplevel);
+
+  if (decoration)
+    decoration_detach (decoration);
+}
+
+static MetaWindowWayland *
+decoration_get_window (MetaWaylandXdgToplevelDecoration *decoration)
+{
+  MetaWaylandSurface *surface;
+  MetaWindow *window;
+
+  if (!decoration->xdg_toplevel)
+    return NULL;
+
+  surface =
+    meta_wayland_surface_role_get_surface (META_WAYLAND_SURFACE_ROLE (decoration->xdg_toplevel));
+  window = meta_wayland_surface_get_window (surface);
+  if (!window || !META_IS_WINDOW_WAYLAND (window))
+    return NULL;
+
+  return META_WINDOW_WAYLAND (window);
+}
+
+static void
+decoration_update (MetaWaylandXdgToplevelDecoration *decoration,
+                   gboolean                          respond)
+{
+  MetaWindowWayland *wl_window;
+
+  wl_window = decoration_get_window (decoration);
+  if (!wl_window)
+    return;
+
+  /* set_mode and unset_mode are always answered with a configure, even if
+   * the effective mode did not change. */
+  if (respond)
+    decoration->configure_sent = FALSE;
+
+  meta_window_wayland_update_decoration_mode (wl_window, respond);
+}
+
+static gboolean
+decoration_check_orphaned (MetaWaylandXdgToplevelDecoration *decoration)
+{
+  if (decoration->xdg_toplevel)
+    return FALSE;
+
+  wl_resource_post_error (decoration->resource,
+                          ZXDG_TOPLEVEL_DECORATION_V1_ERROR_ORPHANED,
+                          "xdg_toplevel was destroyed before its decoration");
+  return TRUE;
+}
+
+static void
+toplevel_decoration_destroy (struct wl_client   *client,
+                             struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+toplevel_decoration_set_mode (struct wl_client   *client,
+                              struct wl_resource *resource,
+                              uint32_t            mode)
+{
+  MetaWaylandXdgToplevelDecoration *decoration =
+    wl_resource_get_user_data (resource);
+
+  if (decoration_check_orphaned (decoration))
+    return;
+
+  switch (mode)
+    {
+    case ZXDG_TOPLEVEL_DECORATION_V1_MODE_CLIENT_SIDE:
+    case ZXDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE:
+      break;
+    default:
+      wl_resource_post_error (resource,
+                              ZXDG_TOPLEVEL_DECORATION_V1_ERROR_INVALID_MODE,
+                              "Invalid decoration mode %u", mode);
+      return;
+    }
+
+  decoration->requested_mode = mode;
+  decoration_update (decoration, TRUE);
+}
+
+static void
+toplevel_decoration_unset_mode (struct wl_client   *client,
+                                struct wl_resource *resource)
+{
+  MetaWaylandXdgToplevelDecoration *decoration =
+    wl_resource_get_user_data (resource);
+
+  if (decoration_check_orphaned (decoration))
+    return;
+
+  decoration->requested_mode = 0;
+  decoration_update (decoration, TRUE);
+}
+
+static const struct zxdg_toplevel_decoration_v1_interface toplevel_decoration_interface = {
+  toplevel_decoration_destroy,
+  toplevel_decoration_set_mode,
+  toplevel_decoration_unset_mode,
+};
+
+static void
+toplevel_decoration_destructor (struct wl_resource *resource)
+{
+  MetaWaylandXdgToplevelDecoration *decoration =
+    wl_resource_get_user_data (resource);
+  MetaWaylandXdgDecorationManager *manager = decoration->manager;
+
+  /* The window switches back to client-side decorations with its next
+   * commit (see meta_window_wayland_finish_move_resize()). */
+  decoration_detach (decoration);
+  manager->decorations = g_list_remove (manager->decorations, decoration);
+  g_free (decoration);
+}
+
+static void
+decoration_manager_destroy (struct wl_client   *client,
+                            struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+decoration_manager_get_toplevel_decoration (struct wl_client   *client,
+                                            struct wl_resource *resource,
+                                            uint32_t            id,
+                                            struct wl_resource *toplevel_resource)
+{
+  MetaWaylandXdgDecorationManager *manager =
+    wl_resource_get_user_data (resource);
+  MetaWaylandXdgToplevel *xdg_toplevel =
+    wl_resource_get_user_data (toplevel_resource);
+  MetaWaylandSurface *surface;
+  MetaWaylandXdgToplevelDecoration *decoration;
+
+  surface =
+    meta_wayland_surface_role_get_surface (META_WAYLAND_SURFACE_ROLE (xdg_toplevel));
+
+  if (decoration_from_xdg_toplevel (xdg_toplevel))
+    {
+      wl_resource_post_error (resource,
+                              ZXDG_TOPLEVEL_DECORATION_V1_ERROR_ALREADY_CONSTRUCTED,
+                              "xdg_toplevel already has a decoration object");
+      return;
+    }
+
+  if (wl_resource_get_version (resource) < 2 &&
+      meta_wayland_surface_get_buffer (surface))
+    {
+      wl_resource_post_error (resource,
+                              ZXDG_TOPLEVEL_DECORATION_V1_ERROR_UNCONFIGURED_BUFFER,
+                              "xdg_toplevel has a buffer attached");
+      return;
+    }
+
+  decoration = g_new0 (MetaWaylandXdgToplevelDecoration, 1);
+  decoration->manager = manager;
+  decoration->xdg_toplevel = xdg_toplevel;
+  decoration->resource =
+    wl_resource_create (client, &zxdg_toplevel_decoration_v1_interface,
+                        wl_resource_get_version (resource), id);
+  wl_resource_set_implementation (decoration->resource,
+                                  &toplevel_decoration_interface,
+                                  decoration,
+                                  toplevel_decoration_destructor);
+
+  /* The role object can be finalized before the decoration resource is
+   * destroyed, e.g. while a client disconnects. */
+  g_object_set_qdata_full (G_OBJECT (xdg_toplevel), quark_decoration,
+                           decoration,
+                           (GDestroyNotify) on_xdg_toplevel_finalized);
+  manager->decorations = g_list_prepend (manager->decorations, decoration);
+
+  /* A toplevel that was already configured learns its mode with a new
+   * configure; otherwise the initial configure carries it. */
+  decoration_update (decoration, TRUE);
+}
+
+static const struct zxdg_decoration_manager_v1_interface decoration_manager_interface = {
+  decoration_manager_destroy,
+  decoration_manager_get_toplevel_decoration,
+};
+
+static void
+bind_decoration_manager (struct wl_client *client,
+                         void             *data,
+                         uint32_t          version,
+                         uint32_t          id)
+{
+  MetaWaylandXdgDecorationManager *manager = data;
+  struct wl_resource *resource;
+
+  resource = wl_resource_create (client, &zxdg_decoration_manager_v1_interface,
+                                 version, id);
+  wl_resource_set_implementation (resource, &decoration_manager_interface,
+                                  manager, NULL);
+}
+
+static void
+update_policy (MetaWaylandXdgDecorationManager *manager)
+{
+  g_autofree char *mode = NULL;
+
+  manager->policy = META_DECORATION_POLICY_CLIENT_PREFERENCE;
+  if (!manager->settings)
+    return;
+
+  mode = g_settings_get_string (manager->settings, DECORATION_MODE_KEY);
+  if (g_strcmp0 (mode, "server-side") == 0)
+    manager->policy = META_DECORATION_POLICY_SERVER_SIDE;
+  else if (g_strcmp0 (mode, "client-side") == 0)
+    manager->policy = META_DECORATION_POLICY_CLIENT_SIDE;
+}
+
+static void
+on_decoration_mode_changed (GSettings                       *settings,
+                            const char                      *key,
+                            MetaWaylandXdgDecorationManager *manager)
+{
+  GList *l;
+
+  update_policy (manager);
+
+  for (l = manager->decorations; l; l = l->next)
+    decoration_update (l->data, FALSE);
+}
+
+static void
+decoration_manager_free (MetaWaylandXdgDecorationManager *manager)
+{
+  g_clear_object (&manager->settings);
+  g_free (manager);
+}
+
+void
+meta_wayland_xdg_decoration_init (MetaWaylandCompositor *compositor)
+{
+  MetaWaylandXdgDecorationManager *manager;
+  GSettingsSchemaSource *schema_source;
+  g_autoptr (GSettingsSchema) schema = NULL;
+
+  quark_decoration = g_quark_from_static_string ("-meta-wayland-xdg-decoration");
+
+  manager = g_new0 (MetaWaylandXdgDecorationManager, 1);
+  manager->compositor = compositor;
+
+  schema_source = g_settings_schema_source_get_default ();
+  if (schema_source)
+    schema = g_settings_schema_source_lookup (schema_source,
+                                              DECORATION_SCHEMA, TRUE);
+  if (schema && g_settings_schema_has_key (schema, DECORATION_MODE_KEY))
+    {
+      manager->settings = g_settings_new (DECORATION_SCHEMA);
+      g_signal_connect (manager->settings, "changed::" DECORATION_MODE_KEY,
+                        G_CALLBACK (on_decoration_mode_changed), manager);
+    }
+  update_policy (manager);
+
+  if (wl_global_create (compositor->wayland_display,
+                        &zxdg_decoration_manager_v1_interface,
+                        META_ZXDG_DECORATION_MANAGER_V1_VERSION,
+                        manager, bind_decoration_manager) == NULL)
+    g_error ("Failed to register a global xdg-decoration object");
+
+  g_object_set_data_full (G_OBJECT (compositor), "-meta-wayland-xdg-decoration",
+                          manager,
+                          (GDestroyNotify) decoration_manager_free);
+}
