+/**
+ * meta_window_wayland_get_decoration_borders:
+ * @window: a #MetaWindow
+ * @config: (nullable): the window config to compute the borders for, or
+ *   %NULL for the current one
+ * @borders: (out): the server-side decoration around the window geometry
+ *
+ * Gets the size of the titlebar and borders Mutter draws around the window
+ * geometry of a server-side decorated window in the state of @config, in
+ * the same coordinate space as the frame rect. This does not check whether
+ * the window is server-side decorated.
+ */
+void
+meta_window_wayland_get_decoration_borders (MetaWindow       *window,
+                                            MetaWindowConfig *config,
+                                            MetaFrameBorder  *borders)
+{
+  int geometry_scale;
+
+  if (!config)
+    config = window->config;
+
+  *borders = (MetaFrameBorder) { 0 };
+
+  if (meta_window_config_get_is_fullscreen (config))
+    return;
+
+  geometry_scale = meta_window_wayland_get_geometry_scale (window);
+
+  borders->top = META_WINDOW_DECORATION_TITLEBAR_HEIGHT * geometry_scale;
+  if (meta_window_config_is_floating (config))
+    {
+      borders->left = META_WINDOW_DECORATION_BORDER_WIDTH * geometry_scale;
+      borders->right = META_WINDOW_DECORATION_BORDER_WIDTH * geometry_scale;
+      borders->bottom = META_WINDOW_DECORATION_BORDER_WIDTH * geometry_scale;
+    }
+}
+
+/**
+ * meta_window_wayland_get_geometry_offset:
+ * @window: a #MetaWindow
+ * @x: (out): horizontal offset
+ * @y: (out): vertical offset
+ *
+ * Gets the offset of the client's window geometry from the frame rect,
+ * which is the server-side decoration's left border and titlebar, or 0
+ * for windows without server-side decorations.
+ */
+void
+meta_window_wayland_get_geometry_offset (MetaWindow *window,
+                                         int        *x,
+                                         int        *y)
+{
+  MetaWindowWayland *wl_window;
+  MetaFrameBorder borders;
+
+  *x = *y = 0;
+
+  if (!META_IS_WINDOW_WAYLAND (window))
+    return;
+
+  wl_window = META_WINDOW_WAYLAND (window);
+  if (!wl_window->is_server_side_decorated)
+    return;
+
+  meta_window_wayland_get_decoration_borders (window,
+                                              wl_window->last_acked_configuration ?
+                                              wl_window->last_acked_configuration->config :
+                                              NULL,
+                                              &borders);
+  *x = borders.left;
+  *y = borders.top;
+}
+
+/**
+ * meta_window_wayland_update_decoration_mode:
+ * @wl_window: a #MetaWindowWayland
+ *
+ * @force: whether to send a configuration even if the mode did not change
+ *
+ * Sends a new configuration if the decoration mode the client should use
+ * differs from the last one sent, e.g. after the policy changed, or
+ * always when @force is set, as for a set_mode request on an already
+ * configured toplevel.
+ */
+void
+meta_window_wayland_update_decoration_mode (MetaWindowWayland *wl_window,
+                                            gboolean           force)
+{
+  MetaWindow *window = META_WINDOW (wl_window);
+  MetaWaylandWindowConfiguration *last_sent_configuration =
+    wl_window->last_sent_configuration;
+  MtkRectangle frame_rect;
+
+  if (!last_sent_configuration || window->unmanaging)
+    return;
+
+  if (!force &&
+      last_sent_configuration->is_server_side_decorated ==
+      meta_wayland_xdg_decoration_wants_server_side (wl_window->surface))
+    return;
+
+  frame_rect = meta_window_config_get_rect (window->config);
+  meta_window_move_resize (window,
+                           (META_MOVE_RESIZE_RESIZE_ACTION |
+                            META_MOVE_RESIZE_WAYLAND_FORCE_CONFIGURE),
+                           frame_rect);
+}
