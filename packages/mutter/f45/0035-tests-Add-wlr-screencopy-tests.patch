+
+static MetaContext *test_context;
+static MetaWaylandTestDriver *test_driver;
+
+/* Must match OUTPUT_WIDTH and OUTPUT_HEIGHT in the test client. */
+static MonitorTestCaseSetup monitor_setup = {
+  .modes = {
+    {
+      .width = 1024,
+      .height = 768,
+      .refresh_rate = 60.0
+    }
+  },
+  .n_modes = 1,
+  .outputs = {
+     {
