+      .modes = { 0 },
+      .n_modes = 1,
+      .preferred_mode = 0,
+      .possible_crtcs = { 0 },
+      .n_possible_crtcs = 1,
+      .width_mm = 222,
+      .height_mm = 125,
+      .serial = "screencopy",
+    },
+  },
+  .n_outputs = 1,
+  .crtcs = {
+    {
+      .current_mode = 0
+    },
+  },
+  .n_crtcs = 1
+};
+
+static void
+setup_monitor (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  MetaMonitorTestSetup *test_setup;
+
+  test_setup = meta_create_monitor_test_setup (backend, &monitor_setup,
+                                               MONITOR_TEST_FLAG_NO_STORED);
+  meta_monitor_manager_test_emulate_hotplug (
+    META_MONITOR_MANAGER_TEST (monitor_manager), test_setup);
+}
+
+static void
+set_allow_screen_capture (gboolean allow)
+{
+  g_autoptr (GSettings) settings = g_settings_new ("org.gnome.mutter.wayland");
+
+  g_settings_set_boolean (settings, "allow-screen-capture", allow);
+}
+
+static void
+screencopy_capture (void)
+{
+  MetaWaylandTestClient *client;
+
+  setup_monitor ();
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "screencopy",
+                                                   "capture",
+                                                   NULL);
+  meta_wayland_test_driver_wait_for_sync_point (test_driver, 0);
+  meta_wayland_test_driver_emit_sync_event (test_driver, 0);
+  meta_wayland_test_client_finish (client);
+}
+
+static void
+screencopy_invalid_buffer (void)
+{
+  MetaWaylandTestClient *client;
+
+  setup_monitor ();
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "screencopy",
+                                                   "invalid-buffer",
+                                                   NULL);
+  g_test_expect_message ("libmutter", G_LOG_LEVEL_WARNING,
+                         "WL: error in client communication*");
+  meta_wayland_test_client_finish (client);
+  g_test_assert_expected_messages ();
+}
+
+static void
+screencopy_gate (void)
+{
+  MetaWaylandTestClient *client;
+
+  setup_monitor ();
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "screencopy",
+                                                   "gate",
+                                                   NULL);
+  meta_wayland_test_driver_wait_for_sync_point (test_driver, 0);
+  set_allow_screen_capture (FALSE);
+  meta_wayland_test_driver_emit_sync_event (test_driver, 0);
+
+  meta_wayland_test_driver_wait_for_sync_point (test_driver, 1);
+  set_allow_screen_capture (TRUE);
+  meta_wayland_test_driver_emit_sync_event (test_driver, 1);
+
+  meta_wayland_test_client_finish (client);
+}
+
+static void
+screencopy_denied (void)
+{
+  MetaWaylandTestClient *client;
+
+  setup_monitor ();
+  set_allow_screen_capture (FALSE);
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "screencopy",
+                                                   "denied",
+                                                   NULL);
+  meta_wayland_test_client_finish (client);
+  set_allow_screen_capture (TRUE);
+}
+
+static void
+on_before_tests (MetaContext *context)
+{
+  MetaWaylandCompositor *compositor =
+    meta_context_get_wayland_compositor (context);
+
+  test_driver = meta_wayland_test_driver_new (compositor);
+}
+
+static void
+on_after_tests (MetaContext *context)
+{
+  g_clear_object (&test_driver);
+}
+
+static void
+init_tests (void)
+{
+  g_test_add_func ("/wayland/screencopy/capture",
+                   screencopy_capture);
+  g_test_add_func ("/wayland/screencopy/invalid-buffer",
+                   screencopy_invalid_buffer);
+  g_test_add_func ("/wayland/screencopy/gate",
+                   screencopy_gate);
+  g_test_add_func ("/wayland/screencopy/denied",
+                   screencopy_denied);
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_autoptr (MetaContext) context = NULL;
+
+  context = meta_create_test_context (META_CONTEXT_TEST_TYPE_TEST,
+                                      META_CONTEXT_TEST_FLAG_NO_X11 |
+                                      META_CONTEXT_TEST_FLAG_TEST_CLIENT);
+  g_assert_true (meta_context_configure (context, &argc, &argv, NULL));
+
+  test_context = context;
+
+  init_tests ();
+
+  g_signal_connect (context, "before-tests",
+                    G_CALLBACK (on_before_tests), NULL);
+  g_signal_connect (context, "after-tests",
+                    G_CALLBACK (on_after_tests), NULL);
+
+  return meta_context_test_run_tests (META_CONTEXT_TEST (context),
+                                      META_TEST_RUN_FLAG_NONE);
+}
