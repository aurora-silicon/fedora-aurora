@@ -292,7 +296,10 @@ meta_wayland_input_attach_event_handler (MetaWaylandInput                *input,
   handler->grabbing = grab;
   handler->user_data = user_data;
   wl_list_init (&handler->link);
-  wl_list_insert (&input->event_handler_list, &handler->link);
+  if (input->pinned_handler)
+    wl_list_insert (&input->pinned_handler->link, &handler->link);
+  else
+    wl_list_insert (&input->event_handler_list, &handler->link);
 
   if (grab && !input->grab)
     {
@@ -318,6 +325,24 @@ meta_wayland_input_attach_event_handler (MetaWaylandInput                *input,
   return handler;
 }
 
+/* Attach a grabbing handler that stays the current handler until it is
+ * detached: handlers attached later (popup grabs, drags) go below it. */
+MetaWaylandEventHandler *
+meta_wayland_input_attach_pinned_event_handler (MetaWaylandInput                *input,
+                                                const MetaWaylandEventInterface *iface,
+                                                gpointer                         user_data)
+{
+  MetaWaylandEventHandler *handler;
+
+  g_return_val_if_fail (!input->pinned_handler, NULL);
+
+  handler = meta_wayland_input_attach_event_handler (input, iface, TRUE,
+                                                     user_data);
+  input->pinned_handler = handler;
+
+  return handler;
+}
+
 static gboolean
 should_be_grabbed (MetaWaylandInput *input)
 {
@@ -339,6 +364,9 @@ meta_wayland_input_detach_event_handler (MetaWaylandInput        *input,
   handler_change = meta_wayland_input_is_current_handler (input, handler);
   wl_list_remove (&handler->link);
 
+  if (input->pinned_handler == handler)
+    input->pinned_handler = NULL;
+
   if (handler_change && !wl_list_empty (&input->event_handler_list))
     meta_wayland_input_invalidate_all_focus (input);
 
