diff --git a/src/core/keybindings.c b/src/core/keybindings.c
index aa0ff5d..21574d3 100644
--- a/src/core/keybindings.c
+++ b/src/core/keybindings.c
@@ -1672,6 +1672,49 @@ process_key_event (MetaDisplay     *display,
   return process_event (display, window, event);
 }
 
+static void handle_switch_vt (MetaDisplay        *display,
+                              MetaWindow         *window,
+                              const ClutterEvent *event,
+                              MetaKeyBinding     *binding,
+                              gpointer            user_data);
+
+/* While the session is locked (ext-session-lock-v1) only keyboard layout
+ * switching and VT switching stay active; every other binding, the overlay
+ * key and locate-pointer are left to the lock client. VT switching keeps
+ * the other sessions (and a way to recover a session whose lock client
+ * died) reachable.
+ */
+gboolean
+meta_keybindings_process_locked_event (MetaDisplay        *display,
+                                       const ClutterEvent *event)
+{
+  MetaKeyBindingManager *keys = &display->key_binding_manager;
+  ClutterEvent *key_event = (ClutterEvent *) event;
+  xkb_keycode_t keycode;
+  MetaResolvedKeyCombo resolved_combo = { &keycode, 1 };
+  MetaKeyBinding *binding;
+
+  if (clutter_event_type (event) != CLUTTER_KEY_PRESS &&
+      clutter_event_type (event) != CLUTTER_KEY_RELEASE)
+    return FALSE;
+
+  keys->overlay_key_only_pressed = FALSE;
+  keys->locate_pointer_key_only_pressed = FALSE;
+
+  if (process_iso_next_group (display, key_event))
+    return TRUE;
+
+  keycode = (xkb_keycode_t) clutter_event_get_key_code (event);
+  resolved_combo.mask = mask_from_event_params (keys,
+                                                get_modifiers (key_event));
+  binding = get_keybinding (keys, &resolved_combo);
+  if (!binding || !binding->handler ||
+      binding->handler->func != handle_switch_vt)
+    return FALSE;
+
+  return process_event (display, NULL, key_event);
+}
+
 /* Handle a key event. May be called recursively: some key events cause
  * grabs to be ended and then need to be processed again in their own
  * right. This cannot cause infinite recursion because we never call
