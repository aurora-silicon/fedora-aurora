 #include "backends/native/meta-backend-native.h"
 
@@ -186,6 +187,25 @@ meta_display_handle_event (MetaDisplay        *display,
       meta_wayland_text_input_update (wayland_text_input, event))
     return CLUTTER_EVENT_STOP;
 
+  /* While an ext-session-lock-v1 client holds the session, input goes to
+   * the lock surfaces only: no window management, focus changes or
+   * keybindings (except VT switching and layout switching).
+   */
+  if (wayland_compositor &&
+      meta_wayland_compositor_is_session_locked (wayland_compositor) &&
+      event_type != CLUTTER_DEVICE_ADDED &&
+      event_type != CLUTTER_DEVICE_REMOVED)
+    {
+      meta_wayland_compositor_update (wayland_compositor, event);
+      handle_idletime_for_event (display, event);
+
+      if (meta_keybindings_process_locked_event (display, event))
+        return CLUTTER_EVENT_STOP;
+
+      meta_wayland_compositor_handle_event (wayland_compositor, event);
+      return CLUTTER_EVENT_STOP;
+    }
+
   if (event_type == CLUTTER_MOTION &&
       !clutter_event_get_device_tool (event))
     meta_display_handle_sticky_mouse_focus_event (display, event);
