diff --git a/src/wayland/meta-wayland-session-lock.c b/src/wayland/meta-wayland-session-lock.c
new file mode 100644
index 0000000..9d68d1e
--- /dev/null
+++ b/src/wayland/meta-wayland-session-lock.c
@@ -0,0 +1,1553 @@
