+
+#include "wlr-foreign-toplevel-management-unstable-v1-client-protocol.h"
+#include "wlr-screencopy-unstable-v1-client-protocol.h"
+
+/* Must match wayland-session-lock-tests.c */
+#define NORMAL_COLOR 0xffff0000
+#define OTHER_NORMAL_COLOR 0xff00ff00
+
+#define SYNC_SPY_READY 40
+#define SYNC_SPY_ROUND_DONE 41
+#define SYNC_SPY_MARKED 42
+#define SYNC_SPY_LOGGED 43
+#define SYNC_APP_SHOWN 60
+#define SYNC_APP_DONE 61
+#define SYNC_FT_LISTED 70
+#define SYNC_FT_LATE_BOUND 71
+#define SYNC_FT_REQUESTED 72
+#define SYNC_FT_LOGGED 73
+#define SYNC_FT_LATE_READY 74
+
+#define EVENT_PHASE_LOCKED 500
+#define EVENT_PHASE_UNLOCKING 501
+#define EVENT_SPY_EXIT 502
+#define EVENT_SPY_ROUND 503
+#define EVENT_SPY_MARK 504
+#define EVENT_SPY_LOG 505
+#define EVENT_APP_RETITLE 600
+#define EVENT_APP_NEW_WINDOW 601
+#define EVENT_APP_CLOSE_EXTRA 602
+#define EVENT_APP_ANIMATE 603
+#define EVENT_APP_EXIT 604
+#define EVENT_FT_BIND 700
+#define EVENT_FT_REQUEST 701
+#define EVENT_FT_EXIT 702
+
+#define ANIMATION_FRAMES 30
+
+typedef enum _Phase
+{
+  PHASE_UNLOCKED,
+  PHASE_LOCKED,
+  PHASE_UNLOCKING,
+} Phase;
+
+static const char * const phase_names[] = { "U", "L", "X" };
+
+static WaylandDisplay *display;
+static struct wl_registry *registry;
+static FILE *log_file;
+static Phase phase = PHASE_UNLOCKED;
+static GHashTable *commands;
+
+static void
+on_command (WaylandDisplay *wayland_display,
+            uint32_t        serial,
+            gpointer        user_data)
+{
+  if (serial == EVENT_PHASE_LOCKED)
+    phase = PHASE_LOCKED;
+  else if (serial == EVENT_PHASE_UNLOCKING)
+    phase = PHASE_UNLOCKING;
+  else
+    g_hash_table_add (commands, GUINT_TO_POINTER (serial));
+}
+
+static gboolean
+take_command (uint32_t command)
+{
+  return g_hash_table_remove (commands, GUINT_TO_POINTER (command));
+}
+
+static void
+sync_point (uint32_t sequence)
+{
+  test_driver_sync_point (display->test_driver, sequence, NULL);
+  wl_display_flush (display->display);
+}
+
+/*
+ * wlr-screencopy
+ */
+
+typedef struct _Output Output;
+
+typedef enum _FrameKind
+{
+  FRAME_DAMAGE,
+  FRAME_COPY,
+  FRAME_REGION,
+  FRAME_CURSOR,
+} FrameKind;
+
+static const char * const kind_names[] = { "damage", "copy", "region", "cursor" };
+
+typedef struct _Frame
+{
+  Output *output;
+  FrameKind kind;
+  struct zwlr_screencopy_frame_v1 *frame;
+  uint32_t format;
+  int width, height, stride;
+  gboolean buffer_done;
+  gboolean copied;
+  struct wl_buffer *buffer;
+  uint32_t *data;
+  size_t size;
+  int n_damage;
+  gboolean full_damage;
+} Frame;
+
+struct _Output
+{
+  uint32_t name;
+  int index;
+  struct wl_output *wl_output;
+  Frame *damage_frame;
+  int n_round_frames;
+  gboolean dumped[3];
+};
+
+static struct zwlr_screencopy_manager_v1 *screencopy_manager;
+static GList *outputs;
+static int next_output_index;
+static int n_frames_pending;
+static int n_damage_frames_since_mark;
+static gboolean round_pending;
+
+static void start_damage_frame (Output *output);
+
+static void
+maybe_dump (Frame          *f,
+            const uint32_t *pixels)
+{
+  const char *dir = g_getenv ("MUTTER_SESSION_LOCK_DUMP_DIR");
+  g_autofree char *path = NULL;
+  FILE *ppm;
+  int x, y;
+
+  if (!dir || !f->output || f->kind != FRAME_COPY || f->output->dumped[phase])
+    return;
+
+  f->output->dumped[phase] = TRUE;
+  path = g_strdup_printf ("%s/screencopy-client-%s-output%d.ppm", dir,
+                          phase == PHASE_LOCKED ? "locked" :
+                          phase == PHASE_UNLOCKED ? "unlocked" : "unlocking",
+                          f->output->index);
+  ppm = fopen (path, "w");
+  g_assert_nonnull (ppm);
+  fprintf (ppm, "P6\n%d %d\n255\n", f->width, f->height);
+  for (y = 0; y < f->height; y++)
+    {
+      for (x = 0; x < f->width; x++)
+        {
+          uint32_t p = pixels[y * (f->stride / 4) + x];
+          uint8_t rgb[3] = { (p >> 16) & 0xff, (p >> 8) & 0xff, p & 0xff };
+
+          fwrite (rgb, 1, 3, ppm);
+        }
+    }
+  fclose (ppm);
+}
+
+static void
+log_frame (Frame *f)
+{
+  int64_t red = 0, green = 0, blue = 0, black = 0, other = 0;
+  int x, y;
+
+  for (y = 0; y < f->height; y++)
+    {
+      for (x = 0; x < f->width; x++)
+        {
+          uint32_t p = f->data[y * (f->stride / 4) + x] & 0xffffff;
+
+          if (p == 0xff0000)
+            red++;
+          else if (p == 0x00ff00)
+            green++;
+          else if (p == 0x0000ff)
+            blue++;
+          else if (p == 0)
+            black++;
+          else
+            other++;
+        }
+    }
+
+  maybe_dump (f, f->data);
+
+  fprintf (log_file,
+           "frame phase=%s kind=%s output=%d size=%dx%d red=%" G_GINT64_FORMAT
+           " green=%" G_GINT64_FORMAT " blue=%" G_GINT64_FORMAT
+           " black=%" G_GINT64_FORMAT " other=%" G_GINT64_FORMAT
+           " damage=%d full_damage=%d\n",
+           phase_names[phase], kind_names[f->kind],
+           f->output ? f->output->index : -1,
+           f->width, f->height, red, green, blue, black, other,
+           f->n_damage, f->full_damage);
+  fflush (log_file);
+}
+
+static void
+frame_free (Frame *f)
+{
+  zwlr_screencopy_frame_v1_destroy (f->frame);
+  if (f->buffer)
+    {
+      wl_buffer_destroy (f->buffer);
+      munmap (f->data, f->size);
+    }
+  g_free (f);
+}
+
+static void
+frame_finished (Frame *f)
+{
+  Output *output = f->output;
+
+  if (f->kind == FRAME_DAMAGE)
+    {
+      if (output && output->damage_frame == f)
+        output->damage_frame = NULL;
+      frame_free (f);
+      if (output)
+        start_damage_frame (output);
+      return;
+    }
+
+  n_frames_pending--;
+  frame_free (f);
+  if (round_pending && n_frames_pending == 0)
+    {
+      round_pending = FALSE;
+      sync_point (SYNC_SPY_ROUND_DONE);
+    }
+}
+
+static void
+handle_frame_buffer (void                            *user_data,
+                     struct zwlr_screencopy_frame_v1 *frame,
+                     uint32_t                         format,
+                     uint32_t                         width,
+                     uint32_t                         height,
+                     uint32_t                         stride)
+{
+  Frame *f = user_data;
+
+  f->format = format;
+  f->width = width;
+  f->height = height;
+  f->stride = stride;
+}
+
+static void
+handle_frame_flags (void                            *user_data,
+                    struct zwlr_screencopy_frame_v1 *frame,
+                    uint32_t                         flags)
+{
+}
+
+static void
+handle_frame_ready (void                            *user_data,
+                    struct zwlr_screencopy_frame_v1 *frame,
+                    uint32_t                         tv_sec_hi,
+                    uint32_t                         tv_sec_lo,
+                    uint32_t                         tv_nsec)
+{
+  Frame *f = user_data;
+
+  log_frame (f);
+  if (f->kind == FRAME_DAMAGE)
+    n_damage_frames_since_mark++;
+  frame_finished (f);
+}
+
+static void
+handle_frame_failed (void                            *user_data,
+                     struct zwlr_screencopy_frame_v1 *frame)
+{
+  Frame *f = user_data;
+
+  fprintf (log_file, "failed phase=%s kind=%s output=%d\n",
+           phase_names[phase], kind_names[f->kind],
+           f->output ? f->output->index : -1);
+  fflush (log_file);
+  /* A failed damage frame (its output went away) is not restarted. */
+  if (f->kind == FRAME_DAMAGE && f->output)
+    {
+      f->output->damage_frame = NULL;
+      f->output = NULL;
+    }
+  frame_finished (f);
+}
+
+static void
+handle_frame_damage (void                            *user_data,
+                     struct zwlr_screencopy_frame_v1 *frame,
+                     uint32_t                         x,
+                     uint32_t                         y,
+                     uint32_t                         width,
+                     uint32_t                         height)
+{
+  Frame *f = user_data;
+
+  f->n_damage++;
+  if (x == 0 && y == 0 && (int) width == f->width && (int) height == f->height)
+    f->full_damage = TRUE;
+}
+
+static void
+handle_frame_linux_dmabuf (void                            *user_data,
+                           struct zwlr_screencopy_frame_v1 *frame,
+                           uint32_t                         format,
+                           uint32_t                         width,
+                           uint32_t                         height)
+{
+}
+
+static void
+handle_frame_buffer_done (void                            *user_data,
+                          struct zwlr_screencopy_frame_v1 *frame)
+{
+  Frame *f = user_data;
+  struct wl_shm_pool *pool;
+  int fd;
+
+  g_assert_cmpuint (f->format, ==, WL_SHM_FORMAT_XRGB8888);
+  f->buffer_done = TRUE;
+  f->size = (size_t) f->stride * f->height;
+  fd = create_anonymous_file (f->size);
+  g_assert_cmpint (fd, >=, 0);
+  f->data = mmap (NULL, f->size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+  g_assert_true (f->data != MAP_FAILED);
+  /* Not a color the classification knows: an unwritten buffer shows as
+   * "other". */
+  memset (f->data, 0x5a, f->size);
+  pool = wl_shm_create_pool (display->shm, fd, f->size);
+  f->buffer = wl_shm_pool_create_buffer (pool, 0, f->width, f->height,
+                                         f->stride, f->format);
+  wl_shm_pool_destroy (pool);
+  close (fd);
+
+  if (f->kind == FRAME_DAMAGE)
+    zwlr_screencopy_frame_v1_copy_with_damage (f->frame, f->buffer);
+  else
+    zwlr_screencopy_frame_v1_copy (f->frame, f->buffer);
+  f->copied = TRUE;
+}
+
+static const struct zwlr_screencopy_frame_v1_listener frame_listener = {
+  handle_frame_buffer,
+  handle_frame_flags,
+  handle_frame_ready,
+  handle_frame_failed,
+  handle_frame_damage,
+  handle_frame_linux_dmabuf,
+  handle_frame_buffer_done,
+};
+
+static Frame *
+capture (Output    *output,
+         FrameKind  kind)
+{
+  Frame *f = g_new0 (Frame, 1);
+
+  f->output = output;
+  f->kind = kind;
+  if (kind == FRAME_REGION)
+    {
+      f->frame =
+        zwlr_screencopy_manager_v1_capture_output_region (screencopy_manager,
+                                                          0,
+                                                          output->wl_output,
+                                                          100, 100, 300, 200);
+    }
+  else
+    {
+      f->frame =
+        zwlr_screencopy_manager_v1_capture_output (screencopy_manager,
+                                                   kind == FRAME_CURSOR,
+                                                   output->wl_output);
+    }
+  zwlr_screencopy_frame_v1_add_listener (f->frame, &frame_listener, f);
+  return f;
+}
+
+static void
+start_damage_frame (Output *output)
+{
+  if (output->damage_frame)
+    return;
+
+  output->damage_frame = capture (output, FRAME_DAMAGE);
+}
+
+static void
+start_round (void)
+{
+  GList *l;
+
+  round_pending = TRUE;
+  for (l = outputs; l; l = l->next)
+    {
+      Output *output = l->data;
+
+      capture (output, FRAME_COPY);
+      capture (output, FRAME_REGION);
+      capture (output, FRAME_CURSOR);
+      n_frames_pending += 3;
+    }
+
+  if (n_frames_pending == 0)
+    {
+      round_pending = FALSE;
+      sync_point (SYNC_SPY_ROUND_DONE);
+    }
+}
+
+static void
+add_output (uint32_t name)
+{
+  Output *output = g_new0 (Output, 1);
+
+  output->name = name;
+  output->index = next_output_index++;
+  output->wl_output = wl_registry_bind (registry, name, &wl_output_interface,
+                                        3);
+  outputs = g_list_append (outputs, output);
+
+  fprintf (log_file, "output phase=%s output=%d\n", phase_names[phase],
+           output->index);
+  fflush (log_file);
+
+  /* An output that shows up is captured right away. */
+  if (screencopy_manager)
+    {
+      start_damage_frame (output);
+      capture (output, FRAME_COPY);
+      n_frames_pending++;
+    }
+}
+
+static void
+remove_output (uint32_t name)
+{
+  GList *l;
+
+  for (l = outputs; l; l = l->next)
+    {
+      Output *output = l->data;
+
+      if (output->name != name)
+        continue;
+
+      /* Frames in flight still point at it; it is not freed. */
+      fprintf (log_file, "output-removed phase=%s output=%d\n",
+               phase_names[phase], output->index);
+      fflush (log_file);
+      if (output->damage_frame)
+        output->damage_frame->output = NULL;
+      output->damage_frame = NULL;
+      outputs = g_list_delete_link (outputs, l);
+      wl_output_release (output->wl_output);
+      output->wl_output = NULL;
+      return;
+    }
+}
+
+/*
+ * wlr-foreign-toplevel-management
+ */
+
+typedef struct _Toplevel
+{
+  int id;
+  struct zwlr_foreign_toplevel_handle_v1 *handle;
+  char *title;
+  gboolean closed;
+} Toplevel;
+
+static struct zwlr_foreign_toplevel_manager_v1 *ft_manager;
+static uint32_t ft_manager_name;
+static GList *toplevels;
+static int next_toplevel_id;
+static int n_done;
+
+static void
+log_ft (Toplevel   *toplevel,
+        const char *event,
+        const char *detail)
+{
+  fprintf (log_file, "ft phase=%s event=%s id=%d%s%s\n", phase_names[phase],
+           event, toplevel ? toplevel->id : -1,
+           detail ? " " : "", detail ? detail : "");
+  fflush (log_file);
+}
+
+static void
+handle_title (void                                   *data,
+              struct zwlr_foreign_toplevel_handle_v1 *handle,
+              const char                             *title)
+{
+  Toplevel *toplevel = data;
+  g_autofree char *detail = g_strdup_printf ("title=%s", title);
+
+  g_set_str (&toplevel->title, title);
+  log_ft (toplevel, "title", detail);
+}
+
+static void
+handle_app_id (void                                   *data,
+               struct zwlr_foreign_toplevel_handle_v1 *handle,
+               const char                             *app_id)
+{
+  log_ft (data, "app_id", NULL);
+}
+
+static void
+handle_output_enter (void                                   *data,
+                     struct zwlr_foreign_toplevel_handle_v1 *handle,
+                     struct wl_output                       *output)
+{
+  log_ft (data, "output_enter", NULL);
+}
+
+static void
+handle_output_leave (void                                   *data,
+                     struct zwlr_foreign_toplevel_handle_v1 *handle,
+                     struct wl_output                       *output)
+{
+  log_ft (data, "output_leave", NULL);
+}
+
+static void
+handle_state (void                                   *data,
+              struct zwlr_foreign_toplevel_handle_v1 *handle,
+              struct wl_array                        *state)
+{
+  g_autoptr (GString) detail = g_string_new ("state=");
+  uint32_t *s;
+
+  wl_array_for_each (s, state)
+    g_string_append_printf (detail, "%u,", *s);
+  log_ft (data, "state", detail->str);
+}
+
+static void
+handle_done (void                                   *data,
+             struct zwlr_foreign_toplevel_handle_v1 *handle)
+{
+  n_done++;
+  log_ft (data, "done", NULL);
+}
+
+static void
+handle_closed (void                                   *data,
+               struct zwlr_foreign_toplevel_handle_v1 *handle)
+{
+  Toplevel *toplevel = data;
+
+  toplevel->closed = TRUE;
+  log_ft (toplevel, "closed", NULL);
+}
+
+static void
+handle_parent (void                                   *data,
+               struct zwlr_foreign_toplevel_handle_v1 *handle,
+               struct zwlr_foreign_toplevel_handle_v1 *parent)
+{
+  log_ft (data, "parent", NULL);
+}
+
+static const struct zwlr_foreign_toplevel_handle_v1_listener handle_listener = {
+  handle_title,
+  handle_app_id,
+  handle_output_enter,
+  handle_output_leave,
+  handle_state,
+  handle_done,
+  handle_closed,
+  handle_parent,
+};
+
+static void
+handle_toplevel (void                                    *data,
+                 struct zwlr_foreign_toplevel_manager_v1 *manager,
+                 struct zwlr_foreign_toplevel_handle_v1  *handle)
+{
+  Toplevel *toplevel = g_new0 (Toplevel, 1);
+
+  toplevel->id = next_toplevel_id++;
+  toplevel->handle = handle;
+  zwlr_foreign_toplevel_handle_v1_add_listener (handle, &handle_listener,
+                                                toplevel);
+  toplevels = g_list_append (toplevels, toplevel);
+  log_ft (toplevel, "toplevel", NULL);
+}
+
+static void
+handle_finished (void                                    *data,
+                 struct zwlr_foreign_toplevel_manager_v1 *manager)
+{
+  log_ft (NULL, "finished", NULL);
+}
+
+static const struct zwlr_foreign_toplevel_manager_v1_listener manager_listener = {
+  handle_toplevel,
+  handle_finished,
+};
+
+static void
+bind_ft_manager (void)
+{
+  g_assert_cmpuint (ft_manager_name, !=, 0);
+  ft_manager = wl_registry_bind (registry, ft_manager_name,
+                                 &zwlr_foreign_toplevel_manager_v1_interface,
+                                 3);
+  zwlr_foreign_toplevel_manager_v1_add_listener (ft_manager,
+                                                 &manager_listener, NULL);
+  log_ft (NULL, "bound", NULL);
+}
+
+static void
+send_ft_requests (void)
+{
+  GList *l;
+
+  for (l = toplevels; l; l = l->next)
+    {
+      Toplevel *toplevel = l->data;
+
+      if (toplevel->closed)
+        continue;
+
+      zwlr_foreign_toplevel_handle_v1_set_minimized (toplevel->handle);
+      zwlr_foreign_toplevel_handle_v1_unset_fullscreen (toplevel->handle);
+      zwlr_foreign_toplevel_handle_v1_activate (toplevel->handle,
+                                                display->wl_seat);
+      zwlr_foreign_toplevel_handle_v1_close (toplevel->handle);
+      log_ft (toplevel, "requested", NULL);
+    }
+}
+
+/*
+ * Registry
+ */
+
+static gboolean bind_outputs;
+
+static void
+handle_registry_global (void               *user_data,
+                        struct wl_registry *wl_registry,
+                        uint32_t            name,
+                        const char         *interface,
+                        uint32_t            version)
+{
+  if (strcmp (interface, zwlr_screencopy_manager_v1_interface.name) == 0)
+    {
+      screencopy_manager =
+        wl_registry_bind (wl_registry, name,
+                          &zwlr_screencopy_manager_v1_interface, 3);
+    }
+  else if (strcmp (interface,
+                   zwlr_foreign_toplevel_manager_v1_interface.name) == 0)
+    {
+      ft_manager_name = name;
+    }
+  else if (bind_outputs && strcmp (interface, wl_output_interface.name) == 0)
+    {
+      add_output (name);
+    }
+}
+
+static void
+handle_registry_global_remove (void               *user_data,
+                               struct wl_registry *wl_registry,
+                               uint32_t            name)
+{
+  remove_output (name);
+}
+
+static const struct wl_registry_listener registry_listener = {
+  handle_registry_global,
+  handle_registry_global_remove,
+};
+
+static void
+connect_display (gboolean with_outputs)
+{
+  display = wayland_display_new (WAYLAND_DISPLAY_CAPABILITY_TEST_DRIVER);
+  commands = g_hash_table_new (NULL, NULL);
+  g_signal_connect (display, "sync-event", G_CALLBACK (on_command), NULL);
+  bind_outputs = with_outputs;
+  registry = wl_display_get_registry (display->display);
+  wl_registry_add_listener (registry, &registry_listener, NULL);
+  wl_display_roundtrip (display->display);
+}
+
+static int
+run_screencopy (void)
+{
+  GList *l;
+
+  connect_display (TRUE);
+  g_assert_nonnull (screencopy_manager);
+  g_assert_nonnull (outputs);
+
+  for (l = outputs; l; l = l->next)
+    {
+      start_damage_frame (l->data);
+      capture (l->data, FRAME_COPY);
+      n_frames_pending++;
+    }
+  round_pending = TRUE;
+  while (round_pending)
+    wayland_display_dispatch (display);
+  sync_point (SYNC_SPY_READY);
+
+  while (!take_command (EVENT_SPY_EXIT))
+    {
+      wayland_display_dispatch (display);
+
+      if (take_command (EVENT_SPY_ROUND))
+        start_round ();
+      if (take_command (EVENT_SPY_MARK))
+        {
+          fprintf (log_file, "mark phase=%s damage_frames=%d\n",
+                   phase_names[phase], n_damage_frames_since_mark);
+          fflush (log_file);
+          n_damage_frames_since_mark = 0;
+          sync_point (SYNC_SPY_MARKED);
+        }
+    }
+
+  return EXIT_SUCCESS;
+}
+
+static int
+run_ft (gboolean late)
+{
+  connect_display (FALSE);
+
+  if (!late)
+    {
+      bind_ft_manager ();
+      while (n_done == 0)
+        wayland_display_dispatch (display);
+      wl_display_roundtrip (display->display);
+      sync_point (SYNC_FT_LISTED);
+    }
+  else
+    {
+      sync_point (SYNC_FT_LATE_READY);
+    }
+
+  while (!take_command (EVENT_FT_EXIT))
+    {
+      wayland_display_dispatch (display);
+
+      if (take_command (EVENT_FT_BIND) && late && !ft_manager)
+        {
+          bind_ft_manager ();
+          wl_display_roundtrip (display->display);
+          wl_display_roundtrip (display->display);
+          sync_point (SYNC_FT_LATE_BOUND);
+        }
+      if (take_command (EVENT_FT_REQUEST) && !late)
+        {
+          send_ft_requests ();
+          wl_display_roundtrip (display->display);
+          sync_point (SYNC_FT_REQUESTED);
+        }
+      if (take_command (EVENT_SPY_LOG))
+        {
+          wl_display_roundtrip (display->display);
+          fprintf (log_file, "ft phase=%s event=log toplevels=%u\n",
+                   phase_names[phase], g_list_length (toplevels));
+          fflush (log_file);
+          sync_point (late ? SYNC_FT_LOGGED + 10 : SYNC_FT_LOGGED);
+        }
+    }
+
+  return EXIT_SUCCESS;
+}
+
+static int
+run_app (void)
+{
+  WaylandSurface *surface;
+  WaylandSurface *extra;
+  WaylandSurface *new_window = NULL;
+
+  connect_display (FALSE);
+
+  surface = wayland_surface_new (display, "normal", 100, 100, NORMAL_COLOR);
+  xdg_toplevel_set_fullscreen (surface->xdg_toplevel, NULL);
+  wl_surface_commit (surface->wl_surface);
+  wait_for_window_shown (display, surface->wl_surface);
+  wait_for_effects_completed (display, surface->wl_surface);
+
+  /* Closed while locked. */
+  extra = wayland_surface_new (display, "extra", 100, 100, NORMAL_COLOR);
+  wl_surface_commit (extra->wl_surface);
+  wait_for_window_shown (display, extra->wl_surface);
+  wait_for_effects_completed (display, extra->wl_surface);
+
+  sync_point (SYNC_APP_SHOWN);
+
+  while (!take_command (EVENT_APP_EXIT))
+    {
+      wayland_display_dispatch (display);
+
+      if (take_command (EVENT_APP_RETITLE))
+        {
+          xdg_toplevel_set_title (surface->xdg_toplevel, "secret-title");
+          wl_surface_commit (surface->wl_surface);
+          wl_display_roundtrip (display->display);
+          sync_point (SYNC_APP_DONE);
+        }
+      if (take_command (EVENT_APP_NEW_WINDOW))
+        {
+          new_window = wayland_surface_new (display, "new-while-locked",
+                                            100, 100, NORMAL_COLOR);
+          wl_surface_commit (new_window->wl_surface);
+          /* Not waiting for it to be shown: behind the lock it is not
+           * painted. */
+          wait_for_window_configured (display, new_window);
+          wl_display_roundtrip (display->display);
+          sync_point (SYNC_APP_DONE);
+        }
+      if (take_command (EVENT_APP_CLOSE_EXTRA))
+        {
+          g_clear_object (&extra);
+          wl_display_roundtrip (display->display);
+          sync_point (SYNC_APP_DONE);
+        }
+      if (take_command (EVENT_APP_ANIMATE))
+        {
+          int i;
+
+          /* Not paced by frame callbacks: a covered window may not get
+           * them. */
+          for (i = 0; i < ANIMATION_FRAMES; i++)
+            {
+              draw_surface (display, surface->wl_surface,
+                            surface->width, surface->height,
+                            i % 2 ? NORMAL_COLOR : OTHER_NORMAL_COLOR);
+              wl_surface_commit (surface->wl_surface);
+              wl_display_roundtrip (display->display);
+              g_usleep (10000);
+            }
+          draw_surface (display, surface->wl_surface,
+                        surface->width, surface->height, NORMAL_COLOR);
+          wl_surface_commit (surface->wl_surface);
+          wl_display_roundtrip (display->display);
+          sync_point (SYNC_APP_DONE);
+        }
+    }
+
+  g_clear_object (&new_window);
+  g_clear_object (&extra);
+  g_object_unref (surface);
+  return EXIT_SUCCESS;
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  const char *mode;
+  int ret;
+
+  g_assert_cmpint (argc, >=, 2);
+  mode = argv[1];
+
+  if (argc >= 3)
+    {
+      log_file = fopen (argv[2], "w");
+      g_assert_nonnull (log_file);
+    }
+
+  /* A client started while locked can't get the phase event. */
+  if (argc >= 4 && g_strcmp0 (argv[3], "locked") == 0)
+    phase = PHASE_LOCKED;
+
+  if (g_strcmp0 (mode, "screencopy") == 0)
+    ret = run_screencopy ();
+  else if (g_strcmp0 (mode, "ft") == 0)
+    ret = run_ft (FALSE);
+  else if (g_strcmp0 (mode, "ft-late") == 0)
+    ret = run_ft (TRUE);
+  else if (g_strcmp0 (mode, "app") == 0)
+    ret = run_app ();
+  else
+    g_error ("Unknown mode %s", mode);
+
+  if (log_file)
+    fclose (log_file);
+  return ret;
+}
