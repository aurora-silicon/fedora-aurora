+typedef struct _ShellActor
+{
+  ClutterActor *actor;
+  int n_events;
+} ShellActor;
+
+static gboolean
+on_shell_actor_event (ClutterActor *actor,
+                      ClutterEvent *event,
+                      ShellActor   *shell_actor)
+{
+  ClutterEventType type = clutter_event_type (event);
+
+  if (type == CLUTTER_KEY_PRESS || type == CLUTTER_KEY_RELEASE ||
+      type == CLUTTER_BUTTON_PRESS || type == CLUTTER_BUTTON_RELEASE)
+    shell_actor->n_events++;
+
+  return CLUTTER_EVENT_STOP;
+}
+
+/* A green full stage actor, like a shell modal dialog or the overview. */
+static void
+shell_actor_init (ShellActor *shell_actor)
+{
+  ClutterActor *stage = meta_backend_get_stage (get_backend ());
+  CoglColor green;
+
+  shell_actor->actor = clutter_actor_new ();
+  cogl_color_init_from_4f (&green, 0.0f, 1.0f, 0.0f, 1.0f);
+  clutter_actor_set_background_color (shell_actor->actor, &green);
+  clutter_actor_set_size (shell_actor->actor, MONITOR_WIDTH, MONITOR_HEIGHT);
+  clutter_actor_set_reactive (shell_actor->actor, TRUE);
+  g_signal_connect (shell_actor->actor, "event",
+                    G_CALLBACK (on_shell_actor_event), shell_actor);
+  clutter_actor_add_child (stage, shell_actor->actor);
+}
+
+static void
+on_overlay_key (MetaDisplay *display,
+                int         *n_overlay_key)
+{
+  (*n_overlay_key)++;
+}
+
+static void
+press_key (ClutterVirtualInputDevice *keyboard,
+           uint32_t                   key,
+           gboolean                   pressed)
+{
+  clutter_virtual_input_device_notify_key (keyboard, CLUTTER_CURRENT_TIME, key,
+                                           pressed ?
+                                           CLUTTER_KEY_STATE_PRESSED :
+                                           CLUTTER_KEY_STATE_RELEASED);
+  meta_flush_input (test_context);
+  while (g_main_context_iteration (NULL, FALSE))
+    ;
+}
+
+static void
+tap_key (ClutterVirtualInputDevice *keyboard,
+         uint32_t                   key)
+{
+  press_key (keyboard, key, TRUE);
+  press_key (keyboard, key, FALSE);
+}
+
+/* While locked, shell code raises a full screen actor over everything,
+ * grabs the stage and gives it the key focus, and hotkeys are pressed: the
+ * actor is never painted, gets no event, and the lock surface keeps the
+ * keyboard and the pointer. */
+static void
+session_lock_shell_grab (void)
+{
+  ClutterSeat *seat =
+    clutter_backend_get_default_seat (
+      meta_backend_get_clutter_backend (get_backend ()));
+  MetaDisplay *display = meta_context_get_display (test_context);
+  ClutterActor *stage = meta_backend_get_stage (get_backend ());
+  g_autoptr (ClutterVirtualInputDevice) pointer = NULL;
+  g_autoptr (ClutterVirtualInputDevice) keyboard = NULL;
+  g_autoptr (ClutterGrab) grab = NULL;
+  ShellActor added = { 0 }, raised = { 0 };
+  MetaWaylandTestClient *app;
+  MetaWaylandTestClient *lock;
+  MetaWaylandSurface *app_surface;
+  MetaWindow *focus_window;
+  int n_overlay_key = 0;
+
+  set_monitors (&one_monitor);
+  pointer = clutter_seat_create_virtual_device (seat, CLUTTER_POINTER_DEVICE);
+  keyboard = clutter_seat_create_virtual_device (seat, CLUTTER_KEYBOARD_DEVICE);
+  meta_flush_input (test_context);
+  g_signal_connect (display, "overlay-key", G_CALLBACK (on_overlay_key),
+                    &n_overlay_key);
+
+  app = start_app ();
+  meta_window_focus (meta_find_window_from_title (test_context, "normal"),
+                     META_CURRENT_TIME);
+  move_pointer (pointer, 500, 400);
+  app_surface = get_keyboard_focus ();
+  g_assert_nonnull (app_surface);
+  focus_window = meta_display_get_focus_window (display);
+
+  /* Control: unlocked, the overlay key works. */
+  tap_key (keyboard, KEY_LEFTMETA);
+  g_assert_cmpint (n_overlay_key, ==, 1);
+  n_overlay_key = 0;
+
+  lock = lock_session ("lock-keys");
+  wait_for_sync (SYNC_KEY_FOCUS);
+  g_assert_true (is_lock_surface (get_keyboard_focus ()));
+
+  /* Added above the lock, then an existing child raised above it. */
+  shell_actor_init (&raised);
+  shell_actor_init (&added);
+  clutter_actor_set_child_above_sibling (stage, raised.actor, NULL);
+  dump_views ("shell-grab-1-raised");
+  assert_view_all (0, "blue");
+
+  clutter_stage_set_key_focus (CLUTTER_STAGE (stage), raised.actor);
+  grab = clutter_stage_grab (CLUTTER_STAGE (stage), raised.actor);
+  while (g_main_context_iteration (NULL, FALSE))
+    ;
+  g_assert_true (is_lock_surface (get_keyboard_focus ()));
+
+  tap_key (keyboard, KEY_A);
+  g_assert_true (wait_for_sync_timeout (SYNC_KEY_BASE + KEY_A, 5000));
+  g_assert_true (is_lock_surface (get_keyboard_focus ()));
+
+  move_pointer (pointer, 300, 200);
+  g_assert_true (is_lock_surface (get_pointer_focus ()));
+  clutter_virtual_input_device_notify_button (pointer, CLUTTER_CURRENT_TIME,
+                                              CLUTTER_BUTTON_PRIMARY,
+                                              CLUTTER_BUTTON_STATE_PRESSED);
+  clutter_virtual_input_device_notify_button (pointer, CLUTTER_CURRENT_TIME,
+                                              CLUTTER_BUTTON_PRIMARY,
+                                              CLUTTER_BUTTON_STATE_RELEASED);
+  meta_flush_input (test_context);
+  while (g_main_context_iteration (NULL, FALSE))
+    ;
+  g_assert_true (is_lock_surface (get_pointer_focus ()));
+
+  /* Hotkeys: the overlay key and the window switcher do nothing, the keys
+   * go to the lock surface. */
+  tap_key (keyboard, KEY_LEFTMETA);
+  press_key (keyboard, KEY_LEFTALT, TRUE);
+  tap_key (keyboard, KEY_TAB);
+  press_key (keyboard, KEY_LEFTALT, FALSE);
+  g_assert_true (wait_for_sync_timeout (SYNC_KEY_BASE + KEY_TAB, 5000));
+  g_assert_cmpint (n_overlay_key, ==, 0);
+  g_assert_true (meta_display_get_focus_window (display) == focus_window);
+  g_assert_true (is_lock_surface (get_keyboard_focus ()));
+
+  g_assert_cmpint (added.n_events, ==, 0);
+  g_assert_cmpint (raised.n_events, ==, 0);
+
+  dump_views ("shell-grab-2-grabbed");
+  assert_view_all (0, "blue");
+  assert_no_leaks ();
+
+  clutter_grab_dismiss (grab);
+  g_clear_pointer (&added.actor, clutter_actor_destroy);
+  g_clear_pointer (&raised.actor, clutter_actor_destroy);
+
+  unlock_session (lock);
+  g_assert_true (get_keyboard_focus () == app_surface);
+
+  g_signal_handlers_disconnect_by_func (display, on_overlay_key,
+                                        &n_overlay_key);
+  assert_no_leaks ();
+  stop_app (app);
+}
