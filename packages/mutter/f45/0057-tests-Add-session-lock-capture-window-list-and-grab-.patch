+typedef struct _WindowCapture
+{
+  int64_t red;
+  int64_t visible; /* any non transparent pixel */
+} WindowCapture;
+
+static WindowCapture
+count_pixels (const uint8_t *data,
+              int            width,
+              int            height,
+              int            stride,
+              gboolean       argb_native)
+{
+  WindowCapture capture = { 0 };
+  int x, y;
+
+  for (y = 0; y < height; y++)
+    {
+      for (x = 0; x < width; x++)
+        {
+          const uint8_t *p = data + y * stride + x * 4;
+          uint8_t r, g, b, a;
+
+          if (argb_native)
+            {
+              uint32_t v = *(const uint32_t *) p;
+
+              a = v >> 24;
+              r = v >> 16;
+              g = v >> 8;
+              b = v;
+            }
+          else
+            {
+              r = p[0];
+              g = p[1];
+              b = p[2];
+              a = p[3];
+            }
+
+          if (r == 0xff && g == 0 && b == 0)
+            capture.red++;
+          if (a || r || g || b)
+            capture.visible++;
+        }
+    }
+
+  return capture;
+}
+
+/* Everything a window screen cast or a window screenshot can get. */
+static void
+capture_window (MetaWindowActor *window_actor,
+                WindowCapture   *out)
+{
+  MetaScreenCastWindow *screen_cast_window =
+    META_SCREEN_CAST_WINDOW (window_actor);
+  ClutterBackend *clutter_backend =
+    meta_backend_get_clutter_backend (get_backend ());
+  CoglContext *cogl_context =
+    clutter_backend_get_cogl_context (clutter_backend);
+  g_autoptr (GError) error = NULL;
+  g_autoptr (ClutterContent) content = NULL;
+  g_autoptr (CoglBitmap) bitmap = NULL;
+  g_autoptr (CoglOffscreen) offscreen = NULL;
+  g_autoptr (CoglTexture) texture = NULL;
+  g_autofree uint8_t *data = NULL;
+  CoglTexture *content_texture;
+  MtkRectangle bounds;
+  uint8_t *bitmap_data;
+  int width, height;
+
+  /* A window stream's buffer path */
+  meta_screen_cast_window_get_buffer_bounds (screen_cast_window, &bounds);
+  g_assert_cmpint (bounds.width, >, 0);
+  data = g_malloc ((size_t) bounds.width * bounds.height * 4);
+  memset (data, 0xff, (size_t) bounds.width * bounds.height * 4);
+  meta_screen_cast_window_capture_into (screen_cast_window, &bounds, data);
+  out[0] = count_pixels (data, bounds.width, bounds.height, bounds.width * 4,
+                         TRUE);
+
+  /* A window stream's dma-buf path */
+  texture = cogl_texture_2d_new_with_size (cogl_context,
+                                           bounds.width, bounds.height);
+  offscreen = cogl_offscreen_new_with_texture (texture);
+  g_assert_true (cogl_framebuffer_allocate (COGL_FRAMEBUFFER (offscreen),
+                                            NULL));
+  g_assert_true (meta_screen_cast_window_blit_to_framebuffer (
+    screen_cast_window, &bounds, COGL_FRAMEBUFFER (offscreen)));
+  memset (data, 0xff, (size_t) bounds.width * bounds.height * 4);
+  g_assert_true (cogl_framebuffer_read_pixels (COGL_FRAMEBUFFER (offscreen),
+                                               0, 0,
+                                               bounds.width, bounds.height,
+                                               COGL_PIXEL_FORMAT_RGBA_8888_PRE,
+                                               data));
+  out[1] = count_pixels (data, bounds.width, bounds.height, bounds.width * 4,
+                         FALSE);
+
+  /* Window screenshots */
+  content = meta_window_actor_paint_to_content (window_actor, NULL, &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (content);
+  content_texture = clutter_texture_content_get_texture (
+    CLUTTER_TEXTURE_CONTENT (content));
+  width = cogl_texture_get_width (content_texture);
+  height = cogl_texture_get_height (content_texture);
+  g_clear_pointer (&data, g_free);
+  data = g_malloc0 ((size_t) width * height * 4);
+  cogl_texture_get_data (content_texture, COGL_PIXEL_FORMAT_RGBA_8888_PRE,
+                         width * 4, data);
+  out[2] = count_pixels (data, width, height, width * 4, FALSE);
+
+  bitmap = meta_window_actor_paint_to_bitmap (window_actor, NULL,
+                                              COGL_PIXEL_FORMAT_ARGB32_NATIVE);
+  g_assert_nonnull (bitmap);
+  bitmap_data = cogl_bitmap_map (bitmap, COGL_BUFFER_ACCESS_READ, 0, NULL);
+  g_assert_nonnull (bitmap_data);
+  out[3] = count_pixels (bitmap_data,
+                         cogl_bitmap_get_width (bitmap),
+                         cogl_bitmap_get_height (bitmap),
+                         cogl_bitmap_get_rowstride (bitmap),
+                         TRUE);
+  cogl_bitmap_unmap (bitmap);
+}
+
+static void
+on_window_damaged (MetaWindowActor *window_actor,
+                   int             *n_damaged)
+{
+  (*n_damaged)++;
+}
+
+/* A window that is being screen cast while the session gets locked: its
+ * streams and screenshots get only transparent images while locked, a
+ * frame is recorded at the lock (and the unlock), and the window
+ * changing behind the lock records nothing. */
+static void
+session_lock_window_capture (void)
+{
+  static const char * const paths[] = {
+    "capture_into", "blit_to_framebuffer", "paint_to_content", "paint_to_bitmap",
+  };
+  MetaWaylandTestClient *app;
+  MetaWaylandTestClient *lock;
+  MetaWindow *window;
+  MetaWindowActor *window_actor;
+  WindowCapture before[4], locked[4], after[4];
+  int n_damaged = 0;
+  int damaged_at_lock, damaged_while_locked, damaged_at_unlock;
+  int i;
+
+  set_monitors (&one_monitor);
+  app = start_app ();
+  window = meta_find_window_from_title (test_context, "normal");
+  window_actor = meta_window_actor_from_window (window);
+  g_assert_nonnull (window_actor);
+  meta_screen_cast_window_inc_usage (META_SCREEN_CAST_WINDOW (window_actor));
+  g_signal_connect (window_actor, "damaged",
+                    G_CALLBACK (on_window_damaged), &n_damaged);
+
+  capture_window (window_actor, before);
+
+  n_damaged = 0;
+  lock = lock_session ("lock");
+  damaged_at_lock = n_damaged;
+  capture_window (window_actor, locked);
+
+  n_damaged = 0;
+  command (EVENT_APP_ANIMATE, SYNC_APP_DONE);
+  repaint_all_views ();
+  damaged_while_locked = n_damaged;
+
+  n_damaged = 0;
+  unlock_session (lock);
+  damaged_at_unlock = n_damaged;
+  capture_window (window_actor, after);
+
+  for (i = 0; i < 4; i++)
+    {
+      g_debug ("%s: red before %" G_GINT64_FORMAT " locked %" G_GINT64_FORMAT
+               " (visible %" G_GINT64_FORMAT ") after %" G_GINT64_FORMAT,
+               paths[i], before[i].red, locked[i].red, locked[i].visible,
+               after[i].red);
+      g_assert_cmpint (before[i].red, >, 0);
+      g_assert_cmpint (locked[i].red, ==, 0);
+      g_assert_cmpint (locked[i].visible, ==, 0);
+      g_assert_cmpint (after[i].red, >, 0);
+    }
+  g_debug ("damaged: at lock %d, while locked %d, at unlock %d",
+           damaged_at_lock, damaged_while_locked, damaged_at_unlock);
+  g_assert_cmpint (damaged_at_lock, >=, 1);
+  g_assert_cmpint (damaged_while_locked, ==, 0);
+  g_assert_cmpint (damaged_at_unlock, >=, 1);
+
+  g_signal_handlers_disconnect_by_func (window_actor, on_window_damaged,
+                                        &n_damaged);
+  meta_screen_cast_window_dec_usage (META_SCREEN_CAST_WINDOW (window_actor));
+  assert_no_leaks ();
+  stop_app (app);
+}
