+static gboolean
+on_sync_timeout (gpointer user_data)
+{
+  gboolean *timed_out = user_data;
+
+  *timed_out = TRUE;
+  return G_SOURCE_REMOVE;
+}
+
+/* As wait_for_sync (), but gives up after timeout_ms. */
+static gboolean
+wait_for_sync_timeout (unsigned int sequence,
+                       unsigned int timeout_ms)
+{
+  gboolean timed_out = FALSE;
+  guint id;
+
+  id = g_timeout_add (timeout_ms, on_sync_timeout, &timed_out);
+  while (!timed_out &&
+         !g_hash_table_contains (sync_points, GUINT_TO_POINTER (sequence)))
+    g_main_context_iteration (NULL, TRUE);
+  if (!timed_out)
+    g_source_remove (id);
+
+  return g_hash_table_remove (sync_points, GUINT_TO_POINTER (sequence));
+}
+
+static void
+command (unsigned int event,
+         unsigned int reply)
+{
+  meta_wayland_test_driver_emit_sync_event (test_driver, event);
+  if (reply)
+    wait_for_sync (reply);
+}
+
+static MetaWaylandTestClient *
+start_app (void)
+{
+  MetaWaylandTestClient *client;
+
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "session-lock-spy",
+                                                   "app", NULL);
+  wait_for_sync (SYNC_APP_SHOWN);
+  repaint_all_views ();
+  assert_view_unlocked (0);
+  return client;
+}
+
+static void
+stop_app (MetaWaylandTestClient *client)
+{
+  command (EVENT_APP_EXIT, 0);
+  meta_wayland_test_client_finish (client);
+}
+
+/* Start a lock client; the spies are told about the lock as soon as the
+ * compositor holds it (before 'locked' is sent), then it is waited for. */
+static MetaWaylandTestClient *
+lock_session (const char *mode)
+{
+  MetaWaylandTestClient *lock;
+
+  n_locked_frames = n_leaked_frames = 0;
+  lock = meta_wayland_test_client_new_with_args (test_context,
+                                                 "session-lock", mode,
+                                                 NULL);
+  while (!meta_wayland_compositor_is_session_locked (get_wayland_compositor ()))
+    g_main_context_iteration (NULL, TRUE);
+  command (EVENT_PHASE_LOCKED, 0);
+  wait_for_sync (SYNC_LOCKED);
+  wait_for_sync (SYNC_DRAWN_BASE + 1);
+  return lock;
+}
+
+static void
+unlock_session (MetaWaylandTestClient *lock)
+{
+  command (EVENT_PHASE_UNLOCKING, 0);
+  meta_wayland_test_driver_emit_sync_event (test_driver, EVENT_UNLOCK);
+  wait_for_sync (SYNC_UNLOCKED);
+  meta_wayland_test_client_finish (lock);
+  g_assert_false (meta_wayland_compositor_is_session_locked (
+    get_wayland_compositor ()));
+}
+
+typedef struct _LogLine
+{
+  char *what;
+  GHashTable *fields;
+} LogLine;
+
+static void
+log_line_free (LogLine *line)
+{
+  g_free (line->what);
+  g_hash_table_unref (line->fields);
+  g_free (line);
+}
+
+static GPtrArray *
+read_log (const char *path)
+{
+  g_autofree char *contents = NULL;
+  g_auto (GStrv) lines = NULL;
+  GPtrArray *log = g_ptr_array_new_with_free_func ((GDestroyNotify) log_line_free);
+  int i;
+
+  g_assert_true (g_file_get_contents (path, &contents, NULL, NULL));
+  lines = g_strsplit (contents, "\n", -1);
+  for (i = 0; lines[i]; i++)
+    {
+      g_auto (GStrv) words = NULL;
+      LogLine *line;
+      int j;
+
+      if (!*lines[i])
+        continue;
+
+      words = g_strsplit (lines[i], " ", -1);
+      line = g_new0 (LogLine, 1);
+      line->what = g_strdup (words[0]);
+      line->fields = g_hash_table_new_full (g_str_hash, g_str_equal,
+                                            g_free, g_free);
+      for (j = 1; words[j]; j++)
+        {
+          char *eq = strchr (words[j], '=');
+
+          if (!eq)
+            continue;
+          g_hash_table_insert (line->fields,
+                               g_strndup (words[j], eq - words[j]),
+                               g_strdup (eq + 1));
+        }
+      g_ptr_array_add (log, line);
+    }
+
+  return log;
+}
+
+static const char *
+field (LogLine    *line,
+       const char *name)
+{
+  const char *value = g_hash_table_lookup (line->fields, name);
+
+  return value ? value : "";
+}
+
+static int64_t
+field_int (LogLine    *line,
+           const char *name)
+{
+  return g_ascii_strtoll (field (line, name), NULL, 10);
+}
+
+static gboolean
+is (LogLine    *line,
+    const char *what,
+    const char *phase)
+{
+  return g_str_equal (line->what, what) &&
+         (!phase || g_str_equal (field (line, "phase"), phase));
+}
+
+static char *
+make_log_path (const char *name)
+{
+  static char *dir = NULL;
+
+  if (!dir)
+    dir = g_dir_make_tmp ("session-lock-spy-XXXXXX", NULL);
+  g_assert_nonnull (dir);
+  return g_build_filename (dir, name, NULL);
+}
+
+typedef struct _CaptureStats
+{
+  int n_frames;
+  int n_leaks;
+  int n_full_blue;
+  int n_with_normal;
+} CaptureStats;
+
+/* Frames that arrived in @phase (on @output, or any if -1): the ones with
+ * pixels of the normal client (red, green) or of anything else than the
+ * blank and the lock surface are leaks. The pointer sprite is drawn only
+ * with overlay_cursor, and never a client's (the pointer focus is the lock
+ * surface), so those frames may have up to a pointer box of other pixels. */
+static CaptureStats
+count_frames (GPtrArray  *log,
+              const char *phase,
+              int         output)
+{
+  CaptureStats stats = { 0 };
+  unsigned int i;
+
+  for (i = 0; i < log->len; i++)
+    {
+      LogLine *line = g_ptr_array_index (log, i);
+      int64_t other_allowed = 0;
+      int64_t width, height;
+
+      if (!is (line, "frame", phase))
+        continue;
+      if (output >= 0 && field_int (line, "output") != output)
+        continue;
+
+      if (g_str_equal (field (line, "kind"), "cursor"))
+        other_allowed = 4 * CURSOR_BOX * CURSOR_BOX;
+
+      sscanf (field (line, "size"), "%" G_GINT64_FORMAT "x%" G_GINT64_FORMAT,
+              &width, &height);
+      stats.n_frames++;
+      if (field_int (line, "red") || field_int (line, "green"))
+        stats.n_with_normal++;
+      if (field_int (line, "red") || field_int (line, "green") ||
+          field_int (line, "other") > other_allowed)
+        {
+          stats.n_leaks++;
+          if (g_str_equal (phase, "L"))
+            g_warning ("capture client got normal content while locked: %s %s "
+                       "red %s green %s other %s",
+                       field (line, "kind"), field (line, "size"),
+                       field (line, "red"), field (line, "green"),
+                       field (line, "other"));
+        }
+      if (field_int (line, "blue") == width * height)
+        stats.n_full_blue++;
+    }
+
+  g_debug ("phase %s output %d: %d frames, %d leaks, %d all lock color, "
+           "%d with normal content",
+           phase, output, stats.n_frames, stats.n_leaks, stats.n_full_blue,
+           stats.n_with_normal);
+  return stats;
+}
+
+static void
+spy_round (void)
+{
+  command (EVENT_SPY_ROUND, SYNC_SPY_ROUND_DONE);
+}
+
+/* Damage frames the spy got since the last mark. */
+static int64_t
+spy_mark (const char *log_path)
+{
+  g_autoptr (GPtrArray) log = NULL;
+  LogLine *last = NULL;
+  unsigned int i;
+
+  command (EVENT_SPY_MARK, SYNC_SPY_MARKED);
+  log = read_log (log_path);
+  for (i = 0; i < log->len; i++)
+    {
+      LogLine *line = g_ptr_array_index (log, i);
+
+      if (is (line, "mark", NULL))
+        last = line;
+    }
+  g_assert_nonnull (last);
+  return field_int (last, "damage_frames");
+}
+
+/* A screen recorder (a copy_with_damage frame always in flight) and
+ * screenshot rounds (copy, region, overlay_cursor) while the session gets
+ * locked, stays locked with the window behind it animating, and gets
+ * unlocked: every frame that arrives while locked holds only the blank and
+ * the lock color, and the hidden window's damage completes no frame. */
+static void
+session_lock_screencopy (void)
+{
+  g_autofree char *log_path = make_log_path ("screencopy.log");
+  g_autoptr (GPtrArray) log = NULL;
+  MetaWaylandTestClient *app;
+  MetaWaylandTestClient *spy;
+  MetaWaylandTestClient *lock;
+  CaptureStats before, locked, after;
+  int64_t damage_unlocked, damage_locked;
+  int i;
+
+  set_monitors (&one_monitor);
+  app = start_app ();
+  spy = meta_wayland_test_client_new_with_args (test_context,
+                                                "session-lock-spy",
+                                                "screencopy", log_path,
+                                                NULL);
+  wait_for_sync (SYNC_SPY_READY);
+  spy_round ();
+
+  /* Control: unlocked, the animation completes damage frames. */
+  spy_mark (log_path);
+  command (EVENT_APP_ANIMATE, SYNC_APP_DONE);
+  damage_unlocked = spy_mark (log_path);
+
+  lock = lock_session ("lock");
+  repaint_all_views ();
+  dump_label = "screencopy-locked";
+  for (i = 0; i < 5; i++)
+    spy_round ();
+  dump_label = NULL;
+
+  spy_mark (log_path);
+  command (EVENT_APP_ANIMATE, SYNC_APP_DONE);
+  repaint_all_views ();
+  spy_round ();
+  damage_locked = spy_mark (log_path);
+
+  unlock_session (lock);
+  spy_round ();
+  command (EVENT_SPY_EXIT, 0);
+  meta_wayland_test_client_finish (spy);
+
+  log = read_log (log_path);
+  before = count_frames (log, "U", -1);
+  locked = count_frames (log, "L", -1);
+  after = count_frames (log, "X", -1);
+  g_debug ("damage frames during the animation: unlocked %" G_GINT64_FORMAT
+           ", locked %" G_GINT64_FORMAT, damage_unlocked, damage_locked);
+
+  /* The client sees the window when unlocked (it would see a leak). */
+  g_assert_cmpint (before.n_with_normal, >, 0);
+  g_assert_cmpint (after.n_with_normal, >, 0);
+  /* While locked: many frames, none with anything but the blank and the
+   * lock color (frames taken before the lock surface was painted are
+   * black). */
+  g_assert_cmpint (locked.n_frames, >=, 15);
+  g_assert_cmpint (locked.n_leaks, ==, 0);
+  g_assert_cmpint (locked.n_with_normal, ==, 0);
+  g_assert_cmpint (locked.n_full_blue, >=, 1);
+  g_assert_cmpint (damage_unlocked, >, 0);
+  g_assert_cmpint (damage_locked, ==, 0);
+
+  assert_no_leaks ();
+  stop_app (app);
+}
+
+/* An output plugged in while locked is captured by the client as soon as
+ * it shows up: black, then the lock color, never the content. */
+static void
+session_lock_screencopy_hotplug (void)
+{
+  g_autofree char *log_path = make_log_path ("screencopy-hotplug.log");
+  g_autoptr (GPtrArray) log = NULL;
+  MetaWaylandTestClient *app;
+  MetaWaylandTestClient *spy;
+  MetaWaylandTestClient *lock;
+  CaptureStats locked0, locked1;
+  gboolean new_output_seen = FALSE;
+  unsigned int i;
+
+  set_monitors (&one_monitor);
+  app = start_app ();
+  spy = meta_wayland_test_client_new_with_args (test_context,
+                                                "session-lock-spy",
+                                                "screencopy", log_path,
+                                                NULL);
+  wait_for_sync (SYNC_SPY_READY);
+
+  lock = lock_session ("lock");
+  set_monitors (&two_monitors);
+  g_assert_cmpuint (g_list_length (get_views ()), ==, 2);
+  wait_for_sync (SYNC_DRAWN_BASE + 2);
+  for (i = 0; i < 3; i++)
+    spy_round ();
+  dump_views ("screencopy-hotplug");
+  assert_view_all (0, "blue");
+  assert_view_all (1, "blue");
+
+  set_monitors (&one_monitor);
+  wait_for_sync (SYNC_DRAWN_BASE + 1);
+  spy_round ();
+
+  unlock_session (lock);
+  command (EVENT_SPY_EXIT, 0);
+  meta_wayland_test_client_finish (spy);
+
+  log = read_log (log_path);
+  for (i = 0; i < log->len; i++)
+    {
+      LogLine *line = g_ptr_array_index (log, i);
+
+      if (is (line, "output", "L") && field_int (line, "output") == 1)
+        new_output_seen = TRUE;
+    }
+  g_assert_true (new_output_seen);
+  locked0 = count_frames (log, "L", 0);
+  locked1 = count_frames (log, "L", 1);
+  g_assert_cmpint (locked1.n_frames, >=, 4);
+  g_assert_cmpint (locked1.n_leaks, ==, 0);
+  g_assert_cmpint (locked1.n_full_blue, >=, 1);
+  g_assert_cmpint (locked0.n_leaks, ==, 0);
+  g_assert_cmpint (count_frames (log, "L", -1).n_leaks, ==, 0);
+
+  assert_no_leaks ();
+  stop_app (app);
+}
+
+static int
+count_ft_events (GPtrArray  *log,
+                 const char *phase,
+                 const char *event,
+                 const char *title)
+{
+  unsigned int i;
+  int n = 0;
+
+  for (i = 0; i < log->len; i++)
+    {
+      LogLine *line = g_ptr_array_index (log, i);
+
+      if (!is (line, "ft", phase))
+        continue;
+      if (event && !g_str_equal (field (line, "event"), event))
+        continue;
+      if (title && !g_str_equal (field (line, "title"), title))
+        continue;
+      n++;
+    }
+
+  return n;
+}
+
+static int64_t
+last_ft_listed (GPtrArray  *log,
+                const char *phase)
+{
+  int64_t n = -1;
+  unsigned int i;
+
+  for (i = 0; i < log->len; i++)
+    {
+      LogLine *line = g_ptr_array_index (log, i);
+
+      if (is (line, "ft", phase) && g_str_equal (field (line, "event"), "log"))
+        n = field_int (line, "toplevels");
+    }
+
+  return n;
+}
+
+/* A foreign toplevel client bound before the lock learns nothing new while
+ * locked (title change, new window, closed window), one bound while locked
+ * gets no list, and requests sent while locked do nothing; on unlock both
+ * are brought up to date. */
+static void
+session_lock_foreign_toplevel (void)
+{
+  g_autofree char *early_path = make_log_path ("ft-early.log");
+  g_autofree char *late_path = make_log_path ("ft-late.log");
+  g_autoptr (GPtrArray) early_log = NULL;
+  g_autoptr (GPtrArray) late_log = NULL;
+  MetaWaylandTestClient *app;
+  MetaWaylandTestClient *early;
+  MetaWaylandTestClient *late;
+  MetaWaylandTestClient *lock;
+  MetaWindow *normal_window;
+  MetaWindow *new_window;
+  MetaWindow *focus_window;
+  int n_events_locked;
+
+  set_monitors (&one_monitor);
+  app = start_app ();
+  normal_window = meta_find_window_from_title (test_context, "normal");
+  g_assert_nonnull (normal_window);
+  g_object_add_weak_pointer (G_OBJECT (normal_window),
+                             (gpointer *) &normal_window);
+  early = meta_wayland_test_client_new_with_args (test_context,
+                                                  "session-lock-spy",
+                                                  "ft", early_path, NULL);
+  wait_for_sync (SYNC_FT_LISTED);
+
+  lock = lock_session ("lock");
+
+  command (EVENT_APP_RETITLE, SYNC_APP_DONE);
+  command (EVENT_APP_NEW_WINDOW, SYNC_APP_DONE);
+  command (EVENT_APP_CLOSE_EXTRA, SYNC_APP_DONE);
+  while (!(new_window = meta_find_window_from_title (test_context,
+                                                     "new-while-locked")) ||
+         !new_window->mapped)
+    g_main_context_iteration (NULL, TRUE);
+  g_assert_null (meta_find_window_from_title (test_context, "extra"));
+
+  late = meta_wayland_test_client_new_with_args (test_context,
+                                                 "session-lock-spy",
+                                                 "ft-late", late_path,
+                                                 "locked", NULL);
+  wait_for_sync (SYNC_FT_LATE_READY);
+  command (EVENT_FT_BIND, SYNC_FT_LATE_BOUND);
+
+  /* minimize, unset_fullscreen, activate and close every handle. */
+  focus_window = meta_display_get_focus_window (
+    meta_context_get_display (test_context));
+  command (EVENT_FT_REQUEST, SYNC_FT_REQUESTED);
+  while (g_main_context_iteration (NULL, FALSE))
+    ;
+  g_assert_nonnull (normal_window);
+  g_assert_false (normal_window->minimized);
+  g_assert_true (meta_window_is_fullscreen (normal_window));
+  g_assert_false (new_window->minimized);
+  g_assert_true (meta_display_get_focus_window (
+    meta_context_get_display (test_context)) == focus_window);
+
+  meta_wayland_test_driver_emit_sync_event (test_driver, EVENT_SPY_LOG);
+  wait_for_sync (SYNC_FT_LOGGED);
+  wait_for_sync (SYNC_FT_LATE_LOGGED);
+
+  repaint_all_views ();
+  assert_view_all (0, "blue");
+
+  unlock_session (lock);
+  meta_wayland_test_driver_emit_sync_event (test_driver, EVENT_SPY_LOG);
+  wait_for_sync (SYNC_FT_LOGGED);
+  wait_for_sync (SYNC_FT_LATE_LOGGED);
+  command (EVENT_FT_EXIT, 0);
+  meta_wayland_test_client_finish (early);
+  meta_wayland_test_client_finish (late);
+
+  early_log = read_log (early_path);
+  late_log = read_log (late_path);
+
+  /* Before the lock: the windows were listed. */
+  g_assert_cmpint (count_ft_events (early_log, "U", "title", "normal"), ==, 1);
+  g_assert_cmpint (count_ft_events (early_log, "U", "title", "extra"), ==, 1);
+
+  /* While locked: no event at all, only what the client logged itself. */
+  n_events_locked = count_ft_events (early_log, "L", NULL, NULL) -
+                    count_ft_events (early_log, "L", "requested", NULL) -
+                    count_ft_events (early_log, "L", "log", NULL);
+  g_assert_cmpint (n_events_locked, ==, 0);
+  g_assert_cmpint (count_ft_events (early_log, "L", "requested", NULL), ==, 2);
+  g_assert_cmpint (last_ft_listed (early_log, "L"), ==, 2);
+  g_assert_cmpint (count_ft_events (late_log, "L", "toplevel", NULL), ==, 0);
+  g_assert_cmpint (count_ft_events (late_log, "L", NULL, NULL) -
+                   count_ft_events (late_log, "L", "bound", NULL) -
+                   count_ft_events (late_log, "L", "log", NULL), ==, 0);
+  g_assert_cmpint (last_ft_listed (late_log, "L"), ==, 0);
+
+  /* After unlock: the changes, in one batch. */
+  g_assert_cmpint (count_ft_events (early_log, "X", "title", "secret-title"), ==, 1);
+  g_assert_cmpint (count_ft_events (early_log, "X", "title", "new-while-locked"), ==, 1);
+  g_assert_cmpint (count_ft_events (early_log, "X", "closed", NULL), ==, 1);
+  g_assert_cmpint (count_ft_events (early_log, "X", "toplevel", NULL), ==, 1);
+  g_assert_cmpint (last_ft_listed (early_log, "X"), ==, 3);
+  g_assert_cmpint (count_ft_events (late_log, "X", "toplevel", NULL), ==, 2);
+  g_assert_cmpint (count_ft_events (late_log, "X", "title", "secret-title"), ==, 1);
+  g_assert_cmpint (count_ft_events (late_log, "X", "title", "new-while-locked"), ==, 1);
+  g_assert_cmpint (count_ft_events (late_log, "X", "title", "extra"), ==, 0);
+
+  g_assert_nonnull (normal_window);
+  g_assert_false (normal_window->minimized);
+  g_object_remove_weak_pointer (G_OBJECT (normal_window),
+                                (gpointer *) &normal_window);
+
+  assert_no_leaks ();
+  stop_app (app);
+}
