+/*
+ * Clients that try to get at what is behind a session lock, for
+ * wayland-session-lock-tests.c:
+ *
+ *  - "screencopy LOG": captures every output with wlr-screencopy, with a
+ *    copy_with_damage frame always in flight on each output (like a screen
+ *    recorder) and, on request, a round of copy, region copy and
+ *    overlay_cursor copy frames. Every frame it gets is classified pixel by
+ *    pixel and logged with the phase it arrived in.
+ *  - "ft LOG" / "ft-late LOG": a wlr-foreign-toplevel-management client,
+ *    bound at start or only when asked (while locked); logs every event with
+ *    its phase, and on request sends requests for every handle.
+ *  - "app": the content behind the lock: a fullscreen red toplevel that
+ *    changes its title, maps and closes other toplevels and animates when
+ *    asked.
+ *
+ * Phases come from sync events of the test, which arrive on the same
+ * connection as the protocol events: an event logged in phase "locked" was
+ * sent by the compositor after the test saw the session locked, and one
+ * logged before "unlocking" was sent before the test unlocked.
+ */
+
+#include "config.h"
