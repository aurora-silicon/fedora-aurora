+/*
+ * Capture, window list and grab hardening: clients and shell code that try
+ * to get at what is behind the lock (session-lock-spy test client).
+ */
+
+#define SYNC_KEY_FOCUS 30
+#define SYNC_KEY_BASE 1000
+#define SYNC_SPY_READY 40
+#define SYNC_SPY_ROUND_DONE 41
+#define SYNC_SPY_MARKED 42
+#define SYNC_APP_SHOWN 60
+#define SYNC_APP_DONE 61
+#define SYNC_FT_LISTED 70
+#define SYNC_FT_LATE_BOUND 71
+#define SYNC_FT_REQUESTED 72
+#define SYNC_FT_LOGGED 73
+#define SYNC_FT_LATE_READY 74
+#define SYNC_FT_LATE_LOGGED 83
+
+#define EVENT_PHASE_LOCKED 500
+#define EVENT_PHASE_UNLOCKING 501
+#define EVENT_SPY_EXIT 502
+#define EVENT_SPY_ROUND 503
+#define EVENT_SPY_MARK 504
+#define EVENT_SPY_LOG 505
+#define EVENT_APP_RETITLE 600
+#define EVENT_APP_NEW_WINDOW 601
+#define EVENT_APP_CLOSE_EXTRA 602
+#define EVENT_APP_ANIMATE 603
+#define EVENT_APP_EXIT 604
+#define EVENT_FT_BIND 700
+#define EVENT_FT_REQUEST 701
+#define EVENT_FT_EXIT 702
