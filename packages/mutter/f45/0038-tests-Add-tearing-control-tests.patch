+#include "config.h"
+
+#include <gio/gio.h>
+
+#include "backends/meta-backend-private.h"
+#include "clutter/clutter.h"
+#include "meta-test/meta-context-test.h"
+#include "tests/meta-test-utils.h"
+#include "tests/meta-wayland-test-driver.h"
+#include "tests/meta-wayland-test-utils.h"
+
+static MetaContext *test_context;
+static MetaWaylandTestDriver *test_driver;
+
+static ClutterStage *
+get_stage (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+
+  return CLUTTER_STAGE (meta_backend_get_stage (backend));
+}
+
+static ClutterFrameClock *
+get_frame_clock (void)
+{
+  GList *views = clutter_stage_peek_stage_views (get_stage ());
+
+  g_assert_cmpuint (g_list_length (views), ==, 1);
+  return clutter_stage_view_get_frame_clock (views->data);
+}
+
+static void
+repaint (void)
+{
+  ClutterStage *stage = get_stage ();
+
+  clutter_actor_queue_redraw (CLUTTER_ACTOR (stage));
+  meta_wait_for_paint (stage);
+}
+
+static void
+assert_tearing (gboolean expected)
+{
+  MetaWindow *window;
+
+  window = meta_find_window_from_title (test_context, "tearing-control");
+  g_assert_nonnull (window);
+  meta_wait_for_window_shown (window);
+  meta_wait_for_effects (window);
+
+  repaint ();
+  repaint ();
+
+  g_assert_cmpint (clutter_frame_clock_is_tearing (get_frame_clock ()), ==,
+                   expected);
+}
+
+static void
+set_policy (const char *policy)
+{
+  g_autoptr (GSettings) settings = g_settings_new ("org.gnome.mutter");
+
+  g_assert_true (g_settings_set_string (settings, "async-tearing", policy));
+}
+
+static void
+wait_for_client (int sequence)
+{
+  meta_wayland_test_driver_wait_for_sync_point (test_driver, sequence);
+}
+
+static void
+release (int sequence)
+{
+  meta_wayland_test_driver_emit_sync_event (test_driver, sequence);
+}
+
+static void
+tearing_control_basic (void)
+{
+  MetaWaylandTestClient *client;
+
+  set_policy ("fullscreen-only");
+  g_assert_false (clutter_frame_clock_is_tearing (get_frame_clock ()));
+
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "tearing-control",
+                                                   "basic",
+                                                   NULL);
+
+  /* fullscreen + async */
+  wait_for_client (0);
+  assert_tearing (TRUE);
+  release (0);
+
+  /* fullscreen + vsync */
+  wait_for_client (1);
+  assert_tearing (FALSE);
+  release (1);
+
+  /* fullscreen + async, policy off, always, back to fullscreen-only */
+  wait_for_client (2);
+  assert_tearing (TRUE);
+  set_policy ("off");
+  assert_tearing (FALSE);
+  set_policy ("always");
+  assert_tearing (TRUE);
+  set_policy ("fullscreen-only");
+  assert_tearing (TRUE);
+  release (2);
+
+  /* windowed + async */
+  wait_for_client (3);
+  assert_tearing (FALSE);
+  release (3);
+
+  /* fullscreen again + async */
+  wait_for_client (4);
+  assert_tearing (TRUE);
+  release (4);
+
+  /* object destroyed */
+  wait_for_client (5);
+  assert_tearing (FALSE);
+  release (5);
+
+  meta_wayland_test_client_finish (client);
+
+  repaint ();
+  g_assert_false (clutter_frame_clock_is_tearing (get_frame_clock ()));
+}
+
+static void
+tearing_control_duplicate (void)
+{
+  MetaWaylandTestClient *client;
+
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "tearing-control",
+                                                   "duplicate",
+                                                   NULL);
+  g_test_expect_message ("libmutter", G_LOG_LEVEL_WARNING,
+                         "WL: error in client communication*");
+  meta_wayland_test_client_finish (client);
+  g_test_assert_expected_messages ();
+}
+
+static void
+on_before_tests (MetaContext *context)
+{
+  MetaWaylandCompositor *compositor =
+    meta_context_get_wayland_compositor (context);
+
+  test_driver = meta_wayland_test_driver_new (compositor);
+}
+
+static void
+on_after_tests (MetaContext *context)
+{
+  g_clear_object (&test_driver);
+}
+
+static void
+init_tests (void)
+{
+  g_test_add_func ("/wayland/tearing-control/basic",
+                   tearing_control_basic);
+  g_test_add_func ("/wayland/tearing-control/duplicate",
+                   tearing_control_duplicate);
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_autoptr (MetaContext) context = NULL;
+
+  context = meta_create_test_context (META_CONTEXT_TEST_TYPE_TEST,
+                                      META_CONTEXT_TEST_FLAG_NO_X11 |
+                                      META_CONTEXT_TEST_FLAG_TEST_CLIENT);
+  g_assert_true (meta_context_configure (context, &argc, &argv, NULL));
+
+  test_context = context;
+
+  init_tests ();
+
+  g_signal_connect (context, "before-tests",
+                    G_CALLBACK (on_before_tests), NULL);
+  g_signal_connect (context, "after-tests",
+                    G_CALLBACK (on_after_tests), NULL);
+
+  return meta_context_test_run_tests (META_CONTEXT_TEST (context),
+                                      META_TEST_RUN_FLAG_NONE);
+}
