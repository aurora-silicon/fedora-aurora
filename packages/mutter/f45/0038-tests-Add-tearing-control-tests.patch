+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "config.h"
+
+#include <errno.h>
+#include <glib.h>
+#include <wayland-client.h>
+
+#include "wayland-test-client-utils.h"
+
+#include "tearing-control-v1-client-protocol.h"
+
+static struct wp_tearing_control_manager_v1 *tearing_control_manager;
+static struct wl_surface *surface;
+static struct xdg_surface *xdg_surface;
+static struct xdg_toplevel *xdg_toplevel;
+static int toplevel_width, toplevel_height;
+static gboolean waiting_for_configure;
+
+static void
+handle_registry_global (void               *user_data,
+                        struct wl_registry *registry,
+                        uint32_t            id,
+                        const char         *interface,
+                        uint32_t            version)
+{
+  if (strcmp (interface, wp_tearing_control_manager_v1_interface.name) == 0)
+    {
+      tearing_control_manager =
+        wl_registry_bind (registry, id,
+                          &wp_tearing_control_manager_v1_interface, 1);
+    }
+}
+
+static void
+handle_registry_global_remove (void               *user_data,
+                               struct wl_registry *registry,
+                               uint32_t            name)
+{
+}
+
+static const struct wl_registry_listener registry_listener = {
+  handle_registry_global,
+  handle_registry_global_remove
+};
+
+static void
+handle_xdg_toplevel_configure (void                *data,
+                               struct xdg_toplevel *toplevel,
+                               int32_t              width,
+                               int32_t              height,
+                               struct wl_array     *states)
+{
+  toplevel_width = width > 0 ? width : 300;
+  toplevel_height = height > 0 ? height : 200;
+}
+
+static void
+handle_xdg_toplevel_close (void                *data,
+                           struct xdg_toplevel *toplevel)
+{
+  g_assert_not_reached ();
+}
+
+static const struct xdg_toplevel_listener xdg_toplevel_listener = {
+  handle_xdg_toplevel_configure,
+  handle_xdg_toplevel_close,
+};
+
+static void
+handle_xdg_surface_configure (void               *data,
+                              struct xdg_surface *surface_xdg,
+                              uint32_t            serial)
+{
+  xdg_surface_ack_configure (surface_xdg, serial);
+  waiting_for_configure = FALSE;
+}
+
+static const struct xdg_surface_listener xdg_surface_listener = {
+  handle_xdg_surface_configure,
+};
+
+static void
+wait_for_configure (WaylandDisplay *display)
+{
+  waiting_for_configure = TRUE;
+  while (waiting_for_configure)
+    wayland_display_dispatch (display);
+}
+
+static void
+draw_and_commit (WaylandDisplay *display)
+{
+  draw_surface (display, surface, toplevel_width, toplevel_height, 0xff2050a0);
+  wl_surface_commit (surface);
+}
+
+static void
+sync_point (WaylandDisplay *display,
+            int             sequence)
+{
+  wl_display_roundtrip (display->display);
+  test_driver_sync_point (display->test_driver, sequence, NULL);
+  wait_for_sync_event (display, sequence);
+}
+
+static void
+create_toplevel (WaylandDisplay *display)
+{
+  surface = wl_compositor_create_surface (display->compositor);
+  xdg_surface = xdg_wm_base_get_xdg_surface (display->xdg_wm_base, surface);
+  xdg_surface_add_listener (xdg_surface, &xdg_surface_listener, NULL);
+  xdg_toplevel = xdg_surface_get_toplevel (xdg_surface);
+  xdg_toplevel_add_listener (xdg_toplevel, &xdg_toplevel_listener, NULL);
+  xdg_toplevel_set_title (xdg_toplevel, "tearing-control");
+  xdg_toplevel_set_fullscreen (xdg_toplevel, NULL);
+  wl_surface_commit (surface);
+  wait_for_configure (display);
+  draw_and_commit (display);
+}
+
+static void
+test_basic (WaylandDisplay *display)
+{
+  struct wp_tearing_control_v1 *tearing_control;
+
+  create_toplevel (display);
+
+  /* A fullscreen surface asking for async presentation tears. */
+  tearing_control =
+    wp_tearing_control_manager_v1_get_tearing_control (tearing_control_manager,
+                                                       surface);
+  wp_tearing_control_v1_set_presentation_hint (tearing_control,
+                                               WP_TEARING_CONTROL_V1_PRESENTATION_HINT_ASYNC);
+  draw_and_commit (display);
+  sync_point (display, 0);
+
+  /* Back to vsync. */
+  wp_tearing_control_v1_set_presentation_hint (tearing_control,
+                                               WP_TEARING_CONTROL_V1_PRESENTATION_HINT_VSYNC);
+  draw_and_commit (display);
+  sync_point (display, 1);
+
+  /* Async again; the compositor turns the policy off and on meanwhile. */
+  wp_tearing_control_v1_set_presentation_hint (tearing_control,
+                                               WP_TEARING_CONTROL_V1_PRESENTATION_HINT_ASYNC);
+  draw_and_commit (display);
+  sync_point (display, 2);
+
+  /* A windowed surface does not tear. */
+  xdg_toplevel_unset_fullscreen (xdg_toplevel);
+  wl_surface_commit (surface);
+  wait_for_configure (display);
+  draw_and_commit (display);
+  sync_point (display, 3);
+
+  xdg_toplevel_set_fullscreen (xdg_toplevel, NULL);
+  wl_surface_commit (surface);
+  wait_for_configure (display);
+  draw_and_commit (display);
+  sync_point (display, 4);
+
+  /* Destroying the object reverts to vsync on the next commit. */
+  wp_tearing_control_v1_destroy (tearing_control);
+  draw_and_commit (display);
+  sync_point (display, 5);
+
+  g_clear_pointer (&xdg_toplevel, xdg_toplevel_destroy);
+  g_clear_pointer (&xdg_surface, xdg_surface_destroy);
+  g_clear_pointer (&surface, wl_surface_destroy);
+}
+
+static void
+test_duplicate (WaylandDisplay *display)
+{
+  const struct wl_interface *interface = NULL;
+  uint32_t id;
+
+  surface = wl_compositor_create_surface (display->compositor);
+  wp_tearing_control_manager_v1_get_tearing_control (tearing_control_manager,
+                                                     surface);
+  wp_tearing_control_manager_v1_get_tearing_control (tearing_control_manager,
+                                                     surface);
+
+  g_assert_cmpint (wl_display_flush (display->display), >=, 0);
+
+  /* Only read from here on, so the error event is seen before a write to
+   * the closed connection could fail with EPIPE. */
+  while (wl_display_dispatch (display->display) != -1)
+    ;
+  g_assert_cmpint (wl_display_get_error (display->display), ==, EPROTO);
+  g_assert_cmpuint (wl_display_get_protocol_error (display->display,
+                                                   &interface, &id),
+                    ==,
+                    WP_TEARING_CONTROL_MANAGER_V1_ERROR_TEARING_CONTROL_EXISTS);
+  g_assert_true (interface == &wp_tearing_control_manager_v1_interface);
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_autoptr (WaylandDisplay) display = NULL;
+  struct wl_registry *registry;
+
+  display = wayland_display_new (WAYLAND_DISPLAY_CAPABILITY_TEST_DRIVER);
+  registry = wl_display_get_registry (display->display);
+  wl_registry_add_listener (registry, &registry_listener, NULL);
+  wl_display_roundtrip (display->display);
+  g_assert_nonnull (tearing_control_manager);
+
+  if (g_strcmp0 (argv[1], "basic") == 0)
+    test_basic (display);
+  else if (g_strcmp0 (argv[1], "duplicate") == 0)
+    test_duplicate (display);
+  else
+    g_assert_not_reached ();
+
+  return EXIT_SUCCESS;
+}
