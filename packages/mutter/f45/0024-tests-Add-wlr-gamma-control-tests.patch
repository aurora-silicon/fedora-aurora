+#include "config.h"
+
+#include "backends/meta-color-device.h"
+#include "backends/meta-color-manager-private.h"
+#include "backends/meta-crtc.h"
+#include "backends/meta-monitor-manager-private.h"
+#include "backends/meta-monitor-private.h"
+#include "backends/meta-output.h"
+#include "meta-test/meta-context-test.h"
+#include "tests/meta-crtc-test.h"
+#include "tests/meta-monitor-manager-test.h"
+#include "tests/meta-monitor-test-utils.h"
+#include "tests/meta-wayland-test-driver.h"
+#include "tests/meta-wayland-test-utils.h"
+
+#define GAMMA_SIZE 256
+
+static MetaContext *test_context;
+static MetaWaylandTestDriver *test_driver;
+
+static MonitorTestCaseSetup base_monitor_setup = {
+  .modes = {
+    {
+      .width = 1024,
+      .height = 768,
+      .refresh_rate = 60.0
+    }
+  },
+  .n_modes = 1,
+  .outputs = {
+     {
+      .crtc = 0,
+      .modes = { 0 },
+      .n_modes = 1,
+      .preferred_mode = 0,
+      .possible_crtcs = { 0 },
+      .n_possible_crtcs = 1,
+      .width_mm = 222,
+      .height_mm = 125,
+      .serial = "gamma-control",
+    },
+  },
+  .n_outputs = 1,
+  .crtcs = {
+    {
+      .current_mode = 0
+    },
+  },
+  .n_crtcs = 1
+};
+
+static GDBusProxy *
+get_gsd_color_mock_proxy (void)
+{
+  GDBusProxy *proxy;
+  g_autoptr (GError) error = NULL;
+
+  proxy =
+    g_dbus_proxy_new_for_bus_sync (G_BUS_TYPE_SESSION,
+                                   G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START |
+                                   G_DBUS_PROXY_FLAGS_DO_NOT_CONNECT_SIGNALS,
+                                   NULL,
+                                   "org.gnome.SettingsDaemon.Color",
+                                   "/org/gnome/SettingsDaemon/Color",
+                                   "org.freedesktop.DBus.Mock",
+                                   NULL, &error);
+  if (!proxy)
+    g_error ("Failed to find mocked gsd-color service, %s", error->message);
+
+  return proxy;
+}
+
+static void
+set_night_light_temperature (unsigned int temperature)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaColorManager *color_manager = meta_backend_get_color_manager (backend);
+  g_autoptr (GDBusProxy) proxy = NULL;
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GVariant) result = NULL;
+
+  proxy = get_gsd_color_mock_proxy ();
+  result = g_dbus_proxy_call_sync (proxy,
+                                   "SetTemperature",
+                                   g_variant_new ("(u)", temperature),
+                                   G_DBUS_CALL_FLAGS_NO_AUTO_START, -1, NULL,
+                                   &error);
+  if (!result)
+    g_error ("Failed to set gsd-color temperature: %s", error->message);
+
+  while (meta_color_manager_get_temperature (color_manager) != temperature)
+    g_main_context_iteration (NULL, TRUE);
+}
+
+static MetaMonitor *
+get_monitor (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  GList *monitors = meta_monitor_manager_get_monitors (monitor_manager);
+
+  g_assert_cmpuint (g_list_length (monitors), ==, 1);
+  return monitors->data;
+}
+
+static MetaCrtc *
+get_crtc (void)
+{
+  MetaOutput *output = meta_monitor_get_main_output (get_monitor ());
+
+  return meta_output_get_assigned_crtc (output);
+}
+
+static MetaColorDevice *
+get_color_device (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaColorManager *color_manager = meta_backend_get_color_manager (backend);
+
+  return meta_color_manager_get_color_device (color_manager, get_monitor ());
+}
+
+/* The gamma LUT the test CRTC was last programmed with. */
+static MetaGammaLut *
+get_crtc_lut (void)
+{
+  MetaCrtcTest *crtc_test = META_CRTC_TEST (get_crtc ());
+
+  return meta_gamma_lut_new (crtc_test->gamma.size,
+                             crtc_test->gamma.red,
+                             crtc_test->gamma.green,
+                             crtc_test->gamma.blue);
+}
+
+/* Must match ramp_value() in wayland-test-clients/gamma-control.c */
+static MetaGammaLut *
+create_client_ramp (int seed)
+{
+  MetaGammaLut *lut = meta_gamma_lut_new_sized (GAMMA_SIZE);
+  int i;
+
+  for (i = 0; i < GAMMA_SIZE; i++)
+    {
+      lut->red[i] = (uint16_t) MIN (65535, i * 257 + seed);
+      lut->green[i] = (uint16_t) (i * 181 + seed);
+      lut->blue[i] = (uint16_t) (65535 - i * 257);
+    }
+
+  return lut;
+}
+
+static void
+assert_crtc_lut_equals (const MetaGammaLut *expected)
+{
+  g_autoptr (MetaGammaLut) lut = get_crtc_lut ();
+
+  g_assert_cmpuint (lut->size, ==, expected->size);
+  if (!meta_gamma_lut_equal (lut, expected))
+    {
+      size_t i;
+
+      for (i = 0; i < lut->size; i++)
+        {
+          if (lut->red[i] != expected->red[i] ||
+              lut->green[i] != expected->green[i] ||
+              lut->blue[i] != expected->blue[i])
+            {
+              g_error ("CRTC gamma differs at %zu: (%hu, %hu, %hu), "
+                       "expected (%hu, %hu, %hu)",
+                       i, lut->red[i], lut->green[i], lut->blue[i],
+                       expected->red[i], expected->green[i],
+                       expected->blue[i]);
+            }
+        }
+    }
+}
+
+static void
+setup_monitor (gboolean disable_gamma_lut)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  MonitorTestCaseSetup test_case_setup = base_monitor_setup;
+  MetaMonitorTestSetup *test_setup;
+  MetaColorDevice *color_device;
+
+  test_case_setup.crtcs[0].disable_gamma_lut = disable_gamma_lut;
+  test_setup = meta_create_monitor_test_setup (backend, &test_case_setup,
+                                               MONITOR_TEST_FLAG_NO_STORED);
+  meta_monitor_manager_test_emulate_hotplug (
+    META_MONITOR_MANAGER_TEST (monitor_manager), test_setup);
+
+  color_device = get_color_device ();
+  g_assert_nonnull (color_device);
+  while (!meta_color_device_is_ready (color_device))
+    g_main_context_iteration (NULL, TRUE);
+}
+
+static void
+remove_monitors (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  MonitorTestCaseSetup test_case_setup = base_monitor_setup;
+  MetaMonitorTestSetup *test_setup;
+
+  test_case_setup.n_outputs = 0;
+  test_setup = meta_create_monitor_test_setup (backend, &test_case_setup,
+                                               MONITOR_TEST_FLAG_NO_STORED);
+  meta_monitor_manager_test_emulate_hotplug (
+    META_MONITOR_MANAGER_TEST (monitor_manager), test_setup);
+}
+
+static void
+wait_for_client (int sequence)
+{
+  meta_wayland_test_driver_wait_for_sync_point (test_driver, sequence);
+}
+
+static void
+release (int sequence)
+{
+  meta_wayland_test_driver_emit_sync_event (test_driver, sequence);
+}
+
+static void
+gamma_control_basic (void)
+{
+  MetaWaylandTestClient *client;
+  g_autoptr (MetaGammaLut) original = NULL;
+  g_autoptr (MetaGammaLut) ramp0 = create_client_ramp (0);
+  g_autoptr (MetaGammaLut) ramp7 = create_client_ramp (7);
+
+  setup_monitor (FALSE);
+  original = get_crtc_lut ();
+  g_assert_cmpuint (original->size, ==, GAMMA_SIZE);
+  g_assert_false (meta_gamma_lut_equal (original, ramp0));
+
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "gamma-control",
+                                                   "basic",
+                                                   NULL);
+  wait_for_client (0);
+  assert_crtc_lut_equals (ramp0);
+  g_assert_true (meta_color_device_has_gamma_override (get_color_device ()));
+  release (0);
+
+  wait_for_client (1);
+  assert_crtc_lut_equals (ramp7);
+  release (1);
+
+  wait_for_client (2);
+  assert_crtc_lut_equals (original);
+  g_assert_false (meta_color_device_has_gamma_override (get_color_device ()));
+  release (2);
+
+  meta_wayland_test_client_finish (client);
+}
+
+static void
+gamma_control_disconnect (void)
+{
+  MetaWaylandTestClient *client;
+  g_autoptr (MetaGammaLut) original = NULL;
+  g_autoptr (MetaGammaLut) ramp0 = create_client_ramp (0);
+
+  setup_monitor (FALSE);
+  original = get_crtc_lut ();
+
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "gamma-control",
+                                                   "disconnect",
+                                                   NULL);
+  wait_for_client (0);
+  assert_crtc_lut_equals (ramp0);
+  release (0);
+
+  meta_wayland_test_client_finish (client);
+
+  while (meta_color_device_has_gamma_override (get_color_device ()))
+    g_main_context_iteration (NULL, TRUE);
+  assert_crtc_lut_equals (original);
+}
+
+static void
+gamma_control_supersede (void)
+{
+  MetaWaylandTestClient *client;
+  g_autoptr (MetaGammaLut) original = NULL;
+  g_autoptr (MetaGammaLut) ramp0 = create_client_ramp (0);
+  g_autoptr (MetaGammaLut) ramp7 = create_client_ramp (7);
+
+  setup_monitor (FALSE);
+  original = get_crtc_lut ();
+
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "gamma-control",
+                                                   "supersede",
+                                                   NULL);
+  wait_for_client (0);
+  assert_crtc_lut_equals (ramp0);
+  release (0);
+
+  /* The second control took over; the output has its own ramp back until
+   * the new control sets one. */
+  wait_for_client (1);
+  assert_crtc_lut_equals (original);
+  g_assert_false (meta_color_device_has_gamma_override (get_color_device ()));
+  release (1);
+
+  /* The failed control's table (seed 3) was ignored. */
+  wait_for_client (2);
+  assert_crtc_lut_equals (ramp7);
+  release (2);
+
+  /* Destroying the failed control leaves the active one alone. */
+  wait_for_client (3);
+  assert_crtc_lut_equals (ramp7);
+  release (3);
+
+  wait_for_client (4);
+  assert_crtc_lut_equals (original);
+  release (4);
+
+  meta_wayland_test_client_finish (client);
+}
+
+static void
+gamma_control_bad_size (void)
+{
+  MetaWaylandTestClient *client;
+  g_autoptr (MetaGammaLut) original = NULL;
+
+  setup_monitor (FALSE);
+  original = get_crtc_lut ();
+
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "gamma-control",
+                                                   "bad-size",
+                                                   NULL);
+  g_test_expect_message ("libmutter", G_LOG_LEVEL_WARNING,
+                         "WL: error in client communication*");
+  meta_wayland_test_client_finish (client);
+  g_test_assert_expected_messages ();
+
+  g_assert_false (meta_color_device_has_gamma_override (get_color_device ()));
+  assert_crtc_lut_equals (original);
+}
+
+static void
+gamma_control_no_gamma (void)
+{
+  MetaWaylandTestClient *client;
+
+  setup_monitor (TRUE);
+  g_assert_cmpuint (meta_monitor_get_gamma_lut_size (get_monitor ()), ==, 0);
+
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "gamma-control",
+                                                   "no-gamma",
+                                                   NULL);
+  meta_wayland_test_client_finish (client);
+
+  g_assert_false (meta_color_device_has_gamma_override (get_color_device ()));
+}
+
+static void
+gamma_control_output_removed (void)
+{
+  MetaWaylandTestClient *client;
+  g_autoptr (MetaGammaLut) ramp0 = create_client_ramp (0);
+  g_autoptr (MetaColorDevice) color_device = NULL;
+
+  setup_monitor (FALSE);
+
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "gamma-control",
+                                                   "output-removed",
+                                                   NULL);
+  wait_for_client (0);
+  assert_crtc_lut_equals (ramp0);
+  color_device = g_object_ref (get_color_device ());
+  g_assert_true (meta_color_device_has_gamma_override (color_device));
+  remove_monitors ();
+  g_assert_false (meta_color_device_has_gamma_override (color_device));
+  release (0);
+
+  wait_for_client (1);
+  release (1);
+
+  wait_for_client (2);
+  release (2);
+
+  meta_wayland_test_client_finish (client);
+}
+
+static void
+gamma_control_night_light (void)
+{
+  MetaWaylandTestClient *client;
+  g_autoptr (MetaGammaLut) original = NULL;
+  g_autoptr (MetaGammaLut) night_light = NULL;
+  g_autoptr (MetaGammaLut) ramp0 = create_client_ramp (0);
+
+  setup_monitor (FALSE);
+  original = get_crtc_lut ();
+
+  /* The ramp night light programs at 3305K without a client. */
+  set_night_light_temperature (3305);
+  night_light = get_crtc_lut ();
+  g_assert_false (meta_gamma_lut_equal (night_light, original));
+  g_assert_cmpuint (night_light->blue[GAMMA_SIZE - 1], <,
+                    night_light->red[GAMMA_SIZE - 1]);
+  set_night_light_temperature (6500);
+  g_assert_false (meta_gamma_lut_equal (get_crtc_lut (), night_light));
+
+  client = meta_wayland_test_client_new_with_args (test_context,
+                                                   "gamma-control",
+                                                   "night-light",
+                                                   NULL);
+  wait_for_client (0);
+  assert_crtc_lut_equals (ramp0);
+  release (0);
+
+  /* Night light changing must not replace the client ramp. */
+  wait_for_client (1);
+  set_night_light_temperature (3305);
+  assert_crtc_lut_equals (ramp0);
+  release (1);
+
+  /* Once the client lets go, night light applies again. */
+  wait_for_client (2);
+  assert_crtc_lut_equals (night_light);
+  release (2);
+
+  meta_wayland_test_client_finish (client);
+
+  set_night_light_temperature (6500);
+}
+
+static void
+on_before_tests (MetaContext *context)
+{
+  MetaWaylandCompositor *compositor =
+    meta_context_get_wayland_compositor (context);
+  MetaBackend *backend = meta_context_get_backend (context);
+  MetaColorManager *color_manager = meta_backend_get_color_manager (backend);
+
+  test_driver = meta_wayland_test_driver_new (compositor);
+
+  while (!meta_color_manager_is_ready (color_manager))
+    g_main_context_iteration (NULL, TRUE);
+}
+
+static void
+on_after_tests (MetaContext *context)
+{
+  g_clear_object (&test_driver);
+}
+
+static void
+init_tests (void)
+{
+  g_test_add_func ("/wayland/gamma-control/basic",
+                   gamma_control_basic);
+  g_test_add_func ("/wayland/gamma-control/disconnect",
+                   gamma_control_disconnect);
+  g_test_add_func ("/wayland/gamma-control/supersede",
+                   gamma_control_supersede);
+  g_test_add_func ("/wayland/gamma-control/bad-size",
+                   gamma_control_bad_size);
+  g_test_add_func ("/wayland/gamma-control/no-gamma",
+                   gamma_control_no_gamma);
+  g_test_add_func ("/wayland/gamma-control/output-removed",
+                   gamma_control_output_removed);
+  g_test_add_func ("/wayland/gamma-control/night-light",
+                   gamma_control_night_light);
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_autoptr (MetaContext) context = NULL;
+
+  context = meta_create_test_context (META_CONTEXT_TEST_TYPE_TEST,
+                                      META_CONTEXT_TEST_FLAG_NO_X11 |
+                                      META_CONTEXT_TEST_FLAG_TEST_CLIENT);
+  g_assert_true (meta_context_configure (context, &argc, &argv, NULL));
+
+  test_context = context;
+
+  init_tests ();
+
+  g_signal_connect (context, "before-tests",
+                    G_CALLBACK (on_before_tests), NULL);
+  g_signal_connect (context, "after-tests",
+                    G_CALLBACK (on_after_tests), NULL);
+
+  return meta_context_test_run_tests (META_CONTEXT_TEST (context),
+                                      META_TEST_RUN_FLAG_NONE);
+}
