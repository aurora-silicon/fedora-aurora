+
+#define EXPECTED_GAMMA_SIZE 256
+
+typedef struct _GammaControl
+{
+  struct zwlr_gamma_control_v1 *control;
+  uint32_t gamma_size;
+  gboolean failed;
+} GammaControl;
+
+static struct zwlr_gamma_control_manager_v1 *gamma_control_manager;
+static struct wl_output *wl_output;
+
+static void
+handle_registry_global (void               *user_data,
+                        struct wl_registry *registry,
+                        uint32_t            id,
+                        const char         *interface,
+                        uint32_t            version)
+{
+  if (strcmp (interface, zwlr_gamma_control_manager_v1_interface.name) == 0)
+    {
+      gamma_control_manager =
+        wl_registry_bind (registry, id,
+                          &zwlr_gamma_control_manager_v1_interface, 1);
+    }
+  else if (strcmp (interface, wl_output_interface.name) == 0 && !wl_output)
+    {
+      wl_output = wl_registry_bind (registry, id, &wl_output_interface, 1);
+    }
+}
+
+static void
+handle_registry_global_remove (void               *user_data,
+                               struct wl_registry *registry,
+                               uint32_t            name)
+{
+}
+
+static const struct wl_registry_listener registry_listener = {
+  handle_registry_global,
+  handle_registry_global_remove
+};
+
+static void
+handle_gamma_size (void                          *user_data,
+                   struct zwlr_gamma_control_v1  *control,
+                   uint32_t                       size)
+{
+  GammaControl *gamma_control = user_data;
+
+  gamma_control->gamma_size = size;
+}
+
+static void
+handle_failed (void                         *user_data,
+               struct zwlr_gamma_control_v1 *control)
+{
+  GammaControl *gamma_control = user_data;
+
+  gamma_control->failed = TRUE;
+}
+
+static const struct zwlr_gamma_control_v1_listener gamma_control_listener = {
+  handle_gamma_size,
+  handle_failed,
+};
+
+static GammaControl *
+gamma_control_new (WaylandDisplay *display)
+{
+  GammaControl *gamma_control = g_new0 (GammaControl, 1);
+
+  gamma_control->control =
+    zwlr_gamma_control_manager_v1_get_gamma_control (gamma_control_manager,
+                                                     wl_output);
+  zwlr_gamma_control_v1_add_listener (gamma_control->control,
+                                      &gamma_control_listener,
+                                      gamma_control);
+  return gamma_control;
+}
+
+static void
+gamma_control_free (GammaControl *gamma_control)
+{
+  zwlr_gamma_control_v1_destroy (gamma_control->control);
+  g_free (gamma_control);
+}
+
+/* Must match the ramp wayland-gamma-control-tests.c expects. */
+static uint16_t
+ramp_value (int channel,
+            int i,
+            int seed)
+{
+  switch (channel)
+    {
+    case 0:
+      return (uint16_t) MIN (65535, i * 257 + seed);
+    case 1:
+      return (uint16_t) (i * 181 + seed);
+    default:
+      return (uint16_t) (65535 - i * 257);
+    }
+}
+
+static int
+create_ramp_fd (uint32_t size,
+                int      seed,
+                size_t   n_bytes)
+{
+  g_autofree uint16_t *table = NULL;
+  size_t table_size = size * 3 * sizeof (uint16_t);
+  int fd;
+  uint32_t i;
+  int c;
+
+  table = g_malloc0 (table_size);
+  for (c = 0; c < 3; c++)
+    {
+      for (i = 0; i < size; i++)
+        table[c * size + i] = ramp_value (c, i, seed);
+    }
+
+  fd = create_anonymous_file (n_bytes);
+  g_assert_cmpint (fd, >=, 0);
+  /* Write (not mmap) so the file offset ends up past the data, as with
+   * clients that write() their table; the compositor must read from 0. */
+  g_assert_cmpint (write (fd, table, MIN (n_bytes, table_size)), ==,
+                   (ssize_t) MIN (n_bytes, table_size));
+  return fd;
+}
+
+static void
+set_ramp (GammaControl *gamma_control,
+          int           seed)
+{
+  int fd;
+
+  fd = create_ramp_fd (gamma_control->gamma_size, seed,
+                       gamma_control->gamma_size * 3 * sizeof (uint16_t));
+  zwlr_gamma_control_v1_set_gamma (gamma_control->control, fd);
+  close (fd);
+}
+
+static void
+sync_point (WaylandDisplay *display,
+            int             sequence)
+{
+  wl_display_roundtrip (display->display);
+  test_driver_sync_point (display->test_driver, sequence, NULL);
+  wait_for_sync_event (display, sequence);
+}
+
+static void
+test_basic (WaylandDisplay *display)
+{
+  GammaControl *gamma_control;
+
+  gamma_control = gamma_control_new (display);
+  wl_display_roundtrip (display->display);
+  g_assert_false (gamma_control->failed);
+  g_assert_cmpuint (gamma_control->gamma_size, ==, EXPECTED_GAMMA_SIZE);
+
+  set_ramp (gamma_control, 0);
+  sync_point (display, 0);
+  g_assert_false (gamma_control->failed);
+
+  /* A second table replaces the first. */
+  set_ramp (gamma_control, 7);
+  sync_point (display, 1);
+  g_assert_false (gamma_control->failed);
+
+  gamma_control_free (gamma_control);
+  sync_point (display, 2);
+}
+
+static void
+test_disconnect (WaylandDisplay *display)
+{
+  GammaControl *gamma_control;
+
+  gamma_control = gamma_control_new (display);
+  wl_display_roundtrip (display->display);
+  g_assert_cmpuint (gamma_control->gamma_size, ==, EXPECTED_GAMMA_SIZE);
+
+  set_ramp (gamma_control, 0);
+  sync_point (display, 0);
+
+  /* Exit without destroying anything; the compositor must clean up. */
+}
+
+static void
+test_supersede (WaylandDisplay *display)
+{
+  GammaControl *first;
+  GammaControl *second;
+
+  first = gamma_control_new (display);
+  wl_display_roundtrip (display->display);
+  g_assert_cmpuint (first->gamma_size, ==, EXPECTED_GAMMA_SIZE);
+  set_ramp (first, 0);
+  sync_point (display, 0);
+
+  second = gamma_control_new (display);
+  wl_display_roundtrip (display->display);
+  g_assert_true (first->failed);
+  g_assert_false (second->failed);
+  g_assert_cmpuint (second->gamma_size, ==, EXPECTED_GAMMA_SIZE);
+  sync_point (display, 1);
+
+  /* Setting gamma on a failed control is ignored, not an error. */
+  set_ramp (first, 3);
+  set_ramp (second, 7);
+  sync_point (display, 2);
+  g_assert_false (second->failed);
+
+  gamma_control_free (first);
+  sync_point (display, 3);
+  g_assert_false (second->failed);
+
+  gamma_control_free (second);
+  sync_point (display, 4);
+}
+
+static void
+test_bad_size (WaylandDisplay *display)
+{
+  GammaControl *gamma_control;
+  const struct wl_interface *interface;
+  uint32_t object_id;
+  int fd;
+
+  gamma_control = gamma_control_new (display);
+  wl_display_roundtrip (display->display);
+  g_assert_cmpuint (gamma_control->gamma_size, ==, EXPECTED_GAMMA_SIZE);
+  object_id = wl_proxy_get_id ((struct wl_proxy *) gamma_control->control);
+
+  fd = create_ramp_fd (gamma_control->gamma_size, 0,
+                       gamma_control->gamma_size * 2 * sizeof (uint16_t));
+  zwlr_gamma_control_v1_set_gamma (gamma_control->control, fd);
+  close (fd);
+  g_assert_cmpint (wl_display_flush (display->display), >=, 0);
+
+  /* Only read from here on, so the error event is seen before a write
+   * to the closed connection could fail with EPIPE. */
+  while (wl_display_dispatch (display->display) != -1)
+    ;
+  g_assert_cmpint (wl_display_get_error (display->display), ==, EPROTO);
+  g_assert_cmpuint (wl_display_get_protocol_error (display->display,
+                                                   &interface,
+                                                   &object_id),
+                    ==,
+                    ZWLR_GAMMA_CONTROL_V1_ERROR_INVALID_GAMMA);
+  g_assert_true (interface == &zwlr_gamma_control_v1_interface);
+}
+
+static void
+test_no_gamma (WaylandDisplay *display)
+{
+  GammaControl *gamma_control;
+
+  gamma_control = gamma_control_new (display);
+  wl_display_roundtrip (display->display);
+  g_assert_true (gamma_control->failed);
+  g_assert_cmpuint (gamma_control->gamma_size, ==, 0);
+
+  gamma_control_free (gamma_control);
+  wl_display_roundtrip (display->display);
+}
+
+static void
+test_output_removed (WaylandDisplay *display)
+{
+  GammaControl *gamma_control;
+
+  gamma_control = gamma_control_new (display);
+  wl_display_roundtrip (display->display);
+  g_assert_cmpuint (gamma_control->gamma_size, ==, EXPECTED_GAMMA_SIZE);
+  set_ramp (gamma_control, 0);
+  sync_point (display, 0);
+
+  /* The compositor unplugs the monitor here. */
+  sync_point (display, 1);
+  g_assert_true (gamma_control->failed);
+
+  /* Creating a control for the now inert wl_output fails at once. */
+  {
+    GammaControl *inert = gamma_control_new (display);
+
+    wl_display_roundtrip (display->display);
+    g_assert_true (inert->failed);
+    g_assert_cmpuint (inert->gamma_size, ==, 0);
+    gamma_control_free (inert);
+  }
+
+  set_ramp (gamma_control, 3);
+  gamma_control_free (gamma_control);
+  sync_point (display, 2);
+}
+
+static void
+test_night_light (WaylandDisplay *display)
+{
+  GammaControl *gamma_control;
+
+  gamma_control = gamma_control_new (display);
+  wl_display_roundtrip (display->display);
+  g_assert_cmpuint (gamma_control->gamma_size, ==, EXPECTED_GAMMA_SIZE);
+  set_ramp (gamma_control, 0);
+  sync_point (display, 0);
+
+  /* The compositor changes the night light temperature here. */
+  sync_point (display, 1);
+  g_assert_false (gamma_control->failed);
+
+  gamma_control_free (gamma_control);
+  sync_point (display, 2);
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_autoptr (WaylandDisplay) display = NULL;
+  struct wl_registry *registry;
+
+  g_assert_cmpint (argc, ==, 2);
+
+  display = wayland_display_new (WAYLAND_DISPLAY_CAPABILITY_TEST_DRIVER);
+  registry = wl_display_get_registry (display->display);
+  wl_registry_add_listener (registry, &registry_listener, NULL);
+  wl_display_roundtrip (display->display);
+  g_assert_nonnull (gamma_control_manager);
+  g_assert_nonnull (wl_output);
+
+  if (g_strcmp0 (argv[1], "basic") == 0)
+    test_basic (display);
+  else if (g_strcmp0 (argv[1], "disconnect") == 0)
+    test_disconnect (display);
+  else if (g_strcmp0 (argv[1], "supersede") == 0)
+    test_supersede (display);
+  else if (g_strcmp0 (argv[1], "bad-size") == 0)
+    test_bad_size (display);
+  else if (g_strcmp0 (argv[1], "no-gamma") == 0)
+    test_no_gamma (display);
+  else if (g_strcmp0 (argv[1], "output-removed") == 0)
+    test_output_removed (display);
+  else if (g_strcmp0 (argv[1], "night-light") == 0)
+    test_night_light (display);
+  else
+    g_error ("Unknown test '%s'", argv[1]);
+
+  return EXIT_SUCCESS;
+}
