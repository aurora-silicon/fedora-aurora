+++ b/src/compositor/meta-compositor-view-native.h
@@ -37,3 +37,6 @@ void meta_compositor_view_native_maybe_assign_scanout (MetaCompositorViewNative
 
 void meta_compositor_view_native_maybe_update_fullscreen_actor (MetaCompositorViewNative *view_native,
                                                                 MetaCompositor           *compositor);
+
+void meta_compositor_view_native_maybe_update_tearing (MetaCompositorViewNative *view_native,
+                                                       MetaCompositor           *compositor);
