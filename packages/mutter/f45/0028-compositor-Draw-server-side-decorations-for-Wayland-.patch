 }
 
+static void
+sync_decoration (MetaWindowActorWayland *self)
+{
+  MetaWindowActor *actor = META_WINDOW_ACTOR (self);
+  MetaWindow *window = meta_window_actor_get_meta_window (actor);
+  MetaFrameBorder borders;
+  MtkRectangle frame_rect;
+  float geometry_scale;
+
+  if (meta_window_wayland_is_server_side_decorated (META_WINDOW_WAYLAND (window)))
+    meta_window_wayland_get_decoration_borders (window, NULL, &borders);
+  else
+    borders = (MetaFrameBorder) { 0 };
+
+  if (borders.left == 0 && borders.right == 0 &&
+      borders.top == 0 && borders.bottom == 0)
+    {
+      if (self->decoration)
+        {
+          clutter_actor_destroy (CLUTTER_ACTOR (self->decoration));
+          self->decoration = NULL;
+        }
+      return;
+    }
+
+  if (!self->decoration)
+    {
+      self->decoration = meta_window_decoration_new (window);
+      clutter_actor_insert_child_below (CLUTTER_ACTOR (self),
+                                        CLUTTER_ACTOR (self->decoration),
+                                        CLUTTER_ACTOR (self->surface_container));
+    }
+
+  geometry_scale = (float) meta_window_actor_get_geometry_scale (actor);
+  frame_rect = meta_window_config_get_rect (window->config);
+  borders.left = (int16_t) (borders.left / geometry_scale);
+  borders.right = (int16_t) (borders.right / geometry_scale);
+  borders.top = (int16_t) (borders.top / geometry_scale);
+  borders.bottom = (int16_t) (borders.bottom / geometry_scale);
+
+  meta_window_decoration_set_geometry (self->decoration,
+                                       window->custom_frame_extents.left /
+                                       geometry_scale,
+                                       window->custom_frame_extents.top /
+                                       geometry_scale,
+                                       frame_rect.width / geometry_scale,
+                                       frame_rect.height / geometry_scale,
+                                       &borders,
+                                       meta_window_config_is_floating (window->config) &&
+                                       window->has_resize_func);
+}
+
 static gboolean
 do_sync_geometry (MetaWindowActorWayland *self)
 {
@@ -608,6 +664,8 @@ do_sync_geometry (MetaWindowActorWayland *self)
   if (!clutter_actor_is_mapped (CLUTTER_ACTOR (actor)))
     return FALSE;
 
+  sync_decoration (self);
+
   if (maybe_configure_black_background (self,
                                         &surfaces_width, &surfaces_height,
                                         &background_width, &background_height))
