+#pragma once
+
+#include <glib.h>
+
+#include "wayland/meta-wayland-types.h"
+
+typedef enum _MetaWaylandPresentationHint
+{
+  META_WAYLAND_PRESENTATION_HINT_VSYNC,
+  META_WAYLAND_PRESENTATION_HINT_ASYNC,
+} MetaWaylandPresentationHint;
+
+typedef enum _MetaTearingPolicy
+{
+  /* Never present with tearing. */
+  META_TEARING_POLICY_OFF,
+  /* Tear fullscreen windows whose surface is scanned out directly. */
+  META_TEARING_POLICY_FULLSCREEN_ONLY,
+  /* Tear any surface that covers a whole monitor, scanned out or not. */
+  META_TEARING_POLICY_ALWAYS,
+} MetaTearingPolicy;
+
+void meta_wayland_tearing_control_init (MetaWaylandCompositor *compositor);
+
+MetaTearingPolicy meta_wayland_tearing_control_get_policy (MetaWaylandCompositor *compositor);
+
+const char * meta_tearing_policy_to_string (MetaTearingPolicy policy);
