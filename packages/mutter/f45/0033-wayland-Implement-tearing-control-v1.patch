diff --git a/data/org.gnome.mutter.gschema.xml.in b/data/org.gnome.mutter.gschema.xml.in
index 40f6c2e..4fd66f4 100644
--- a/data/org.gnome.mutter.gschema.xml.in
+++ b/data/org.gnome.mutter.gschema.xml.in
@@ -132,6 +132,31 @@
       </description>
     </key>
 
+    <key name="async-tearing" type="s">
+      <choices>
+        <choice value="fullscreen-only"/>
+        <choice value="always"/>
+        <choice value="off"/>
+      </choices>
+      <default>"fullscreen-only"</default>
+      <summary>Present with tearing when a client asks for it</summary>
+      <description>
+        Wayland clients can mark a surface as fit for presentation with
+        tearing (wp_tearing_control_v1, used by Vulkan’s immediate present
+        mode). Such frames are then shown with asynchronous page flips as
+        soon as they are ready, instead of at the next vertical blank, which
+        removes the latency vertical sync adds.
+
+        “fullscreen-only” tears only fullscreen windows that cover a whole
+        monitor, are not obscured and are scanned out directly. “always”
+        tears any such surface that covers a whole monitor, also when it has
+        to be composited. “off” never tears.
+
+        Surfaces that do not ask for tearing are never affected, and monitors
+        whose display driver cannot flip asynchronously keep vertical sync.
+      </description>
+    </key>
+
     <child name="keybindings" schema="org.gnome.mutter.keybindings"/>
 
   </schema>
