diff --git a/src/wayland/meta-wayland-tearing-control.c b/src/wayland/meta-wayland-tearing-control.c
new file mode 100644
index 0000000..fa32cdb
--- /dev/null
+++ b/src/wayland/meta-wayland-tearing-control.c
@@ -0,0 +1,318 @@
+/*
+ * Copyright (C) 2026 Aurora Silicon
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * wp_tearing_control_v1: lets a client mark the content of a surface as
+ * suitable for presentation with tearing (asynchronous page flips). The
+ * hint is double-buffered surface state; whether it is honoured is up to
+ * the compositor view the surface ends up on (see
+ * meta-compositor-view-native.c) and the "async-tearing" setting.
+ */
+
+#include "config.h"
+
+#include "wayland/meta-wayland-tearing-control.h"
+
+#include <gio/gio.h>
+#include <wayland-server.h>
+
+#include "core/util-private.h"
+#include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-surface-private.h"
+#include "wayland/meta-wayland-versions.h"
+
+#include "tearing-control-v1-server-protocol.h"
+
+#define TEARING_SCHEMA "org.gnome.mutter"
+#define TEARING_POLICY_KEY "async-tearing"
+
+typedef struct _MetaWaylandTearingControlManager
+{
+  MetaWaylandCompositor *compositor;
+  GSettings *settings;
+  MetaTearingPolicy policy;
+} MetaWaylandTearingControlManager;
+
+typedef struct _MetaWaylandTearingControl
+{
+  struct wl_resource *resource;
+  MetaWaylandSurface *surface;
+  gulong destroy_handler_id;
+} MetaWaylandTearingControl;
+
+static GQuark quark_tearing_control_manager = 0;
+static GQuark quark_tearing_control = 0;
+
+const char *
+meta_tearing_policy_to_string (MetaTearingPolicy policy)
+{
+  switch (policy)
+    {
+    case META_TEARING_POLICY_OFF:
+      return "off";
+    case META_TEARING_POLICY_FULLSCREEN_ONLY:
+      return "fullscreen-only";
+    case META_TEARING_POLICY_ALWAYS:
+      return "always";
+    }
+
+  g_assert_not_reached ();
+}
+
+static void
+set_pending_hint (MetaWaylandSurface          *surface,
+                  MetaWaylandPresentationHint  hint)
+{
+  MetaWaylandSurfaceState *pending;
+
+  pending = meta_wayland_surface_get_pending_state (surface);
+  if (!pending)
+    return;
+
+  pending->has_new_presentation_hint = TRUE;
+  pending->presentation_hint = hint;
+}
+
+static void
+detach_surface (MetaWaylandTearingControl *tearing_control)
+{
+  MetaWaylandSurface *surface = tearing_control->surface;
+
+  if (!surface)
+    return;
+
+  g_clear_signal_handler (&tearing_control->destroy_handler_id, surface);
+  g_object_set_qdata (G_OBJECT (surface), quark_tearing_control, NULL);
+  tearing_control->surface = NULL;
+}
+
+static void
+tearing_control_destructor (struct wl_resource *resource)
+{
+  MetaWaylandTearingControl *tearing_control =
+    wl_resource_get_user_data (resource);
+
+  /* Destroying the object reverts the hint to vsync on the next commit. */
+  if (tearing_control->surface)
+    set_pending_hint (tearing_control->surface,
+                      META_WAYLAND_PRESENTATION_HINT_VSYNC);
+
+  detach_surface (tearing_control);
+  g_free (tearing_control);
+}
+
+static void
+tearing_control_set_presentation_hint (struct wl_client   *client,
+                                       struct wl_resource *resource,
+                                       uint32_t            hint)
+{
+  MetaWaylandTearingControl *tearing_control =
+    wl_resource_get_user_data (resource);
+  MetaWaylandPresentationHint presentation_hint;
+
+  /* Inert once the surface is gone. */
+  if (!tearing_control->surface)
+    return;
+
+  switch (hint)
+    {
+    case WP_TEARING_CONTROL_V1_PRESENTATION_HINT_VSYNC:
+      presentation_hint = META_WAYLAND_PRESENTATION_HINT_VSYNC;
+      break;
+    case WP_TEARING_CONTROL_V1_PRESENTATION_HINT_ASYNC:
+      presentation_hint = META_WAYLAND_PRESENTATION_HINT_ASYNC;
+      break;
+    default:
+      wl_resource_post_error (resource, WL_DISPLAY_ERROR_INVALID_METHOD,
+                              "Unknown presentation hint %u", hint);
+      return;
+    }
+
+  set_pending_hint (tearing_control->surface, presentation_hint);
+}
+
+static void
+tearing_control_destroy (struct wl_client   *client,
+                         struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static const struct wp_tearing_control_v1_interface tearing_control_interface =
+{
+  tearing_control_set_presentation_hint,
+  tearing_control_destroy,
+};
+
+static void
+on_surface_destroyed (MetaWaylandSurface        *surface,
+                      MetaWaylandTearingControl *tearing_control)
+{
+  detach_surface (tearing_control);
+}
+
+static void
+tearing_control_manager_destroy (struct wl_client   *client,
+                                 struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static void
+tearing_control_manager_get_tearing_control (struct wl_client   *client,
+                                             struct wl_resource *resource,
+                                             uint32_t            id,
+                                             struct wl_resource *surface_resource)
+{
+  MetaWaylandSurface *surface = wl_resource_get_user_data (surface_resource);
+  MetaWaylandTearingControl *tearing_control;
+
+  if (g_object_get_qdata (G_OBJECT (surface), quark_tearing_control))
+    {
+      wl_resource_post_error (resource,
+                              WP_TEARING_CONTROL_MANAGER_V1_ERROR_TEARING_CONTROL_EXISTS,
+                              "The surface already has a tearing control object");
+      return;
+    }
+
+  tearing_control = g_new0 (MetaWaylandTearingControl, 1);
+  tearing_control->resource =
+    wl_resource_create (client,
+                        &wp_tearing_control_v1_interface,
+                        wl_resource_get_version (resource),
+                        id);
+  tearing_control->surface = surface;
+  tearing_control->destroy_handler_id =
+    g_signal_connect (surface, "destroy",
+                      G_CALLBACK (on_surface_destroyed),
+                      tearing_control);
+  g_object_set_qdata (G_OBJECT (surface), quark_tearing_control,
+                      tearing_control);
+
+  wl_resource_set_implementation (tearing_control->resource,
+                                  &tearing_control_interface,
+                                  tearing_control,
+                                  tearing_control_destructor);
+}
+
+static const struct wp_tearing_control_manager_v1_interface tearing_control_manager_interface =
+{
+  tearing_control_manager_destroy,
+  tearing_control_manager_get_tearing_control,
+};
+
+static void
+bind_tearing_control_manager (struct wl_client *client,
+                              void             *data,
+                              uint32_t          version,
+                              uint32_t          id)
+{
+  struct wl_resource *resource;
+
+  resource = wl_resource_create (client,
+                                 &wp_tearing_control_manager_v1_interface,
+                                 version, id);
+  wl_resource_set_implementation (resource,
+                                  &tearing_control_manager_interface,
+                                  data, NULL);
+}
+
+static void
+update_policy (MetaWaylandTearingControlManager *manager)
+{
+  g_autofree char *policy = NULL;
+
+  manager->policy = META_TEARING_POLICY_FULLSCREEN_ONLY;
+  if (manager->settings)
+    {
+      policy = g_settings_get_string (manager->settings, TEARING_POLICY_KEY);
+      if (g_strcmp0 (policy, "always") == 0)
+        manager->policy = META_TEARING_POLICY_ALWAYS;
+      else if (g_strcmp0 (policy, "off") == 0)
+        manager->policy = META_TEARING_POLICY_OFF;
+    }
+
+  meta_topic (META_DEBUG_RENDER, "Tearing policy: %s",
+              meta_tearing_policy_to_string (manager->policy));
+}
+
+static void
+on_policy_changed (GSettings                        *settings,
+                   const char                       *key,
+                   MetaWaylandTearingControlManager *manager)
+{
+  update_policy (manager);
+}
+
+static void
+tearing_control_manager_free (MetaWaylandTearingControlManager *manager)
+{
+  g_clear_object (&manager->settings);
+  g_free (manager);
+}
+
+MetaTearingPolicy
+meta_wayland_tearing_control_get_policy (MetaWaylandCompositor *compositor)
+{
+  MetaWaylandTearingControlManager *manager;
+
+  manager = g_object_get_qdata (G_OBJECT (compositor),
+                                quark_tearing_control_manager);
+  if (!manager)
+    return META_TEARING_POLICY_OFF;
+
+  return manager->policy;
+}
+
+void
+meta_wayland_tearing_control_init (MetaWaylandCompositor *compositor)
+{
+  MetaWaylandTearingControlManager *manager;
+  GSettingsSchemaSource *schema_source;
+  g_autoptr (GSettingsSchema) schema = NULL;
+
+  quark_tearing_control_manager =
+    g_quark_from_static_string ("-meta-wayland-tearing-control-manager");
+  quark_tearing_control =
+    g_quark_from_static_string ("-meta-wayland-tearing-control");
+
+  manager = g_new0 (MetaWaylandTearingControlManager, 1);
+  manager->compositor = compositor;
+
+  schema_source = g_settings_schema_source_get_default ();
+  if (schema_source)
+    schema = g_settings_schema_source_lookup (schema_source,
+                                              TEARING_SCHEMA, TRUE);
+  if (schema && g_settings_schema_has_key (schema, TEARING_POLICY_KEY))
+    {
+      manager->settings = g_settings_new (TEARING_SCHEMA);
+      g_signal_connect (manager->settings, "changed::" TEARING_POLICY_KEY,
+                        G_CALLBACK (on_policy_changed), manager);
+    }
+  update_policy (manager);
+
+  if (wl_global_create (compositor->wayland_display,
+                        &wp_tearing_control_manager_v1_interface,
+                        META_WP_TEARING_CONTROL_V1_VERSION,
+                        manager, bind_tearing_control_manager) == NULL)
+    g_error ("Failed to register a global tearing-control object");
+
+  g_object_set_qdata_full (G_OBJECT (compositor),
+                           quark_tearing_control_manager,
+                           manager,
+                           (GDestroyNotify) tearing_control_manager_free);
+}
