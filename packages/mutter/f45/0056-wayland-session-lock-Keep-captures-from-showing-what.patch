 src/compositor/meta-window-actor.c         | 54 ++++++++++++++++++++-
 src/wayland/meta-wayland-screencopy.c      | 55 ++++++++++++++++++++++
 src/wayland/meta-wayland-screencopy.h      |  2 +
 src/wayland/meta-wayland-session-lock.c    | 39 +++++++++++++++
