diff --git a/src/wayland/meta-wayland-session-lock.c b/src/wayland/meta-wayland-session-lock.c
index 21b2a3c..0d9a71d 100644
--- a/src/wayland/meta-wayland-session-lock.c
+++ b/src/wayland/meta-wayland-session-lock.c
@@ -51,12 +51,15 @@
 #include "clutter/clutter.h"
 #include "compositor/compositor-private.h"
 #include "compositor/meta-surface-actor-wayland.h"
+#include "compositor/meta-window-actor-private.h"
 #include "core/display-private.h"
 #include "wayland/meta-wayland-filter-manager.h"
+#include "wayland/meta-wayland-foreign-toplevel.h"
 #include "wayland/meta-wayland-input.h"
 #include "wayland/meta-wayland-outputs.h"
 #include "wayland/meta-wayland-pointer.h"
 #include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-screencopy.h"
 #include "wayland/meta-wayland-seat.h"
 #include "wayland/meta-wayland-surface-private.h"
 #include "wayland/meta-wayland-versions.h"
@@ -572,6 +575,27 @@ on_stage_last_child_changed (ClutterActor                  *stage,
  * Locking and unlocking
  */
 
+/* The other ways to get at what is behind the lock follow the lock state:
+ * the foreign toplevel list is frozen while locked, screencopy reports
+ * the change as full damage, and window screen casts record a (blank, or
+ * after unlocking real) frame now. */
+static void
+notify_lock_state_changed (MetaWaylandSessionLockManager *manager)
+{
+  MetaCompositor *compositor = get_compositor (manager);
+  GList *l;
+
+  meta_wayland_foreign_toplevel_set_session_locked (manager->compositor,
+                                                    manager->locked);
+  meta_wayland_screencopy_damage_all (manager->compositor);
+
+  if (!compositor)
+    return;
+
+  for (l = meta_compositor_get_window_actors (compositor); l; l = l->next)
+    meta_window_actor_notify_capture_changed (l->data);
+}
+
 static void
 lock_session (MetaWaylandSessionLockManager *manager)
 {
@@ -597,6 +621,8 @@ lock_session (MetaWaylandSessionLockManager *manager)
   g_hash_table_remove_all (manager->pending_views);
   track_pending_views (manager);
   queue_redraw_all_views (manager);
+
+  notify_lock_state_changed (manager);
 }
 
 static void
@@ -623,6 +649,8 @@ unlock_session (MetaWaylandSessionLockManager *manager)
 
   queue_redraw_all_views (manager);
 
+  notify_lock_state_changed (manager);
+
   g_message ("ext-session-lock: session unlocked");
 }
 
@@ -1285,6 +1313,14 @@ meta_wayland_surface_is_in_session_lock_surface (MetaWaylandSurface *surface)
   return toplevel && META_IS_WAYLAND_SESSION_LOCK_SURFACE (toplevel->role);
 }
 
+/* A lock surface or one of its subsurfaces changed what it shows. */
+void
+meta_wayland_session_lock_notify_content_changed (MetaWaylandSurface *surface)
+{
+  if (meta_wayland_compositor_is_session_locked (surface->compositor))
+    meta_wayland_screencopy_damage_all (surface->compositor);
+}
+
 gboolean
 meta_wayland_compositor_is_session_locked (MetaWaylandCompositor *compositor)
 {
@@ -1496,6 +1532,9 @@ lock_surface_sync_actor_state (MetaWaylandActorSurface *actor_surface)
 
   actor_surface_class->sync_actor_state (actor_surface);
   update_lock_surface (META_WAYLAND_SESSION_LOCK_SURFACE (actor_surface));
+  meta_wayland_session_lock_notify_content_changed (
+    meta_wayland_surface_role_get_surface (
+      META_WAYLAND_SURFACE_ROLE (actor_surface)));
 }
 
 static void
diff --git a/src/wayland/meta-wayland-session-lock.h b/src/wayland/meta-wayland-session-lock.h
index f284a4c..bf80e2a 100644
--- a/src/wayland/meta-wayland-session-lock.h
+++ b/src/wayland/meta-wayland-session-lock.h
@@ -32,5 +32,7 @@ void meta_wayland_session_lock_init (MetaWaylandCompositor *compositor);
 
 gboolean meta_wayland_surface_is_in_session_lock_surface (MetaWaylandSurface *surface);
 
+void meta_wayland_session_lock_notify_content_changed (MetaWaylandSurface *surface);
+
 META_EXPORT_TEST
 gboolean meta_wayland_compositor_is_session_locked (MetaWaylandCompositor *compositor);
diff --git a/src/wayland/meta-wayland-subsurface.c b/src/wayland/meta-wayland-subsurface.c
index 0b5c83c..ee8f211 100644
--- a/src/wayland/meta-wayland-subsurface.c
+++ b/src/wayland/meta-wayland-subsurface.c
@@ -262,9 +262,15 @@ meta_wayland_subsurface_sync_actor_state (MetaWaylandActorSurface *actor_surface
   MetaWaylandActorSurfaceClass *actor_surface_class =
     META_WAYLAND_ACTOR_SURFACE_CLASS (meta_wayland_subsurface_parent_class);
 
-  if (meta_wayland_surface_get_window (surface) ||
-      meta_wayland_surface_is_in_session_lock_surface (surface))
-    actor_surface_class->sync_actor_state (actor_surface);
+  if (meta_wayland_surface_get_window (surface))
+    {
+      actor_surface_class->sync_actor_state (actor_surface);
+    }
+  else if (meta_wayland_surface_is_in_session_lock_surface (surface))
+    {
+      actor_surface_class->sync_actor_state (actor_surface);
+      meta_wayland_session_lock_notify_content_changed (surface);
+    }
 
   sync_actor_subsurface_state (surface);
 }
