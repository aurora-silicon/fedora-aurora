From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Date: Mon, 16 Nov 2026 20:55:34 +1100
Subject: [PATCH] wayland: Add the wlr-gamma-control-unstable-v1 protocol

Vendor wlr-gamma-control-unstable-v1.xml (version 1) from wlr-protocols
(1106a4a1) and let wayland-scanner generate its client and server code.
The protocol is not part of wayland-protocols, so it is shipped as a
private protocol like wlr-layer-shell.

Nothing implements it yet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/meson.build                               |   1 +
 .../wlr-gamma-control-unstable-v1.xml         | 126 ++++++++++++++++++
 2 files changed, 127 insertions(+)
 create mode 100644 src/wayland/protocol/wlr-gamma-control-unstable-v1.xml

diff --git a/src/meson.build b/src/meson.build
index fb0c57a..07c7e6d 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -1036,6 +1036,7 @@ wayland_protocols = [
   ['text-input', 'unstable', 3, ],
   ['wlr-data-control-unstable-v1', 'private', ],
   ['wlr-foreign-toplevel-management-unstable-v1', 'private', ],
+  ['wlr-gamma-control-unstable-v1', 'private', ],
   ['wlr-layer-shell-unstable-v1', 'private', ],
   ['viewporter', 'stable', ],
   ['xdg-activation', 'staging', 1, ],
diff --git a/src/wayland/protocol/wlr-gamma-control-unstable-v1.xml b/src/wayland/protocol/wlr-gamma-control-unstable-v1.xml
new file mode 100644
index 0000000..16e0be8
--- /dev/null
+++ b/src/wayland/protocol/wlr-gamma-control-unstable-v1.xml
@@ -0,0 +1,126 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<protocol name="wlr_gamma_control_unstable_v1">
+  <copyright>
+    Copyright © 2015 Giulio camuffo
+    Copyright © 2018 Simon Ser
+
