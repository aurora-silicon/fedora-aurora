From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Date: Tue, 17 Nov 2026 00:47:24 +1100
Subject: [PATCH] clutter/frame-clock: Add a tearing mode

When the frames of a view are presented with asynchronous page flips,
waiting for the update time of the next refresh cycle only adds latency:
the flip lands as soon as the frame is ready. clutter_frame_clock_set_tearing()
makes clutter_frame_clock_schedule_update() dispatch right away (also in
variable refresh rate mode), while throttled updates (timelines) keep
following the refresh cycle so animations do not redraw as fast as
possible.

The rescheduling that clutter_frame_clock_set_mode() does when the
timing changes is shared with the new function.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 clutter/clutter/clutter-frame-clock.c | 77 ++++++++++++++++++++++++++-
 clutter/clutter/clutter-frame-clock.h |  7 +++
 2 files changed, 83 insertions(+), 1 deletion(-)

diff --git a/clutter/clutter/clutter-frame-clock.c b/clutter/clutter/clutter-frame-clock.c
index 56f375c..b84213b 100644
--- a/clutter/clutter/clutter-frame-clock.c
+++ b/clutter/clutter/clutter-frame-clock.c
@@ -122,6 +122,11 @@ struct _ClutterFrameClock
   ClutterFrameClockMode mode;
   ClutterFrameClockPowerState power_state;
 
+  /* When tearing, the frames are presented with asynchronous page flips, so
+   * an update does not have to wait for the next refresh cycle.
+   */
+  gboolean tearing;
+
   int64_t next_update_time_us;
 
   Frame frame_pool[3];
@@ -187,6 +192,9 @@ static void
 clutter_frame_clock_schedule_update_later (ClutterFrameClock *frame_clock,
                                            int64_t            target_us);
 
+static void
+reschedule_for_new_timing (ClutterFrameClock *frame_clock);
+
 static const char *
 clutter_frame_clock_state_to_string (ClutterFrameClockState state)
 {
@@ -1472,6 +1480,15 @@ clutter_frame_clock_schedule_update_now (ClutterFrameClock *frame_clock)
       frame_clock->has_next_frame_deadline = FALSE;
       break;
     case CLUTTER_FRAME_CLOCK_MODE_VARIABLE:
+      if (frame_clock->tearing)
+        {
+          next_update_time_us = g_get_monotonic_time ();
+          frame_clock->is_next_presentation_time_valid = FALSE;
+          frame_clock->is_target_presentation_time = FALSE;
+          frame_clock->has_next_frame_deadline = FALSE;
+          break;
+        }
+
       calculate_next_variable_update_time_us (frame_clock,
                                               &next_update_time_us,
                                               &frame_clock->next_presentation_time_us,
@@ -1548,6 +1565,23 @@ schedule_update (ClutterFrameClock *frame_clock,
       return;
     }
 
+  if (frame_clock->tearing && !throttle)
+    {
+      /* Asynchronous page flips present as soon as the frame is ready, so
+       * start the update now instead of aligning it with the refresh cycle.
+       * Throttled updates (timelines) keep the refresh cycle pacing, so
+       * animations do not redraw as fast as possible.
+       */
+      next_update_time_us = g_get_monotonic_time ();
+      frame_clock->is_next_presentation_time_valid = FALSE;
+      frame_clock->is_target_presentation_time = FALSE;
+      frame_clock->has_next_frame_deadline = FALSE;
+
+      frame_clock->next_update_time_us = next_update_time_us;
+      g_source_set_ready_time (frame_clock->source, next_update_time_us);
+      return;
+    }
+
   switch (frame_clock->mode)
     {
     case CLUTTER_FRAME_CLOCK_MODE_FIXED:
@@ -1719,7 +1753,8 @@ clutter_frame_clock_schedule_flush_update (ClutterFrameClock *frame_clock)
   const Frame *last_presentation = frame_clock->prev_presentation;
   int64_t now_us, timeout_interval_us, target_time_us;
 
-  if (frame_clock->mode != CLUTTER_FRAME_CLOCK_MODE_VARIABLE)
+  if (frame_clock->mode != CLUTTER_FRAME_CLOCK_MODE_VARIABLE ||
+      frame_clock->tearing)
     {
       clutter_frame_clock_schedule_update (frame_clock);
       return;
@@ -1803,6 +1838,12 @@ clutter_frame_clock_set_mode (ClutterFrameClock     *frame_clock,
 
   frame_clock->mode = mode;
 
+  reschedule_for_new_timing (frame_clock);
+}
+
+static void
+reschedule_for_new_timing (ClutterFrameClock *frame_clock)
+{
   switch (frame_clock->state)
     {
     case CLUTTER_FRAME_CLOCK_STATE_INIT:
@@ -1839,6 +1880,40 @@ clutter_frame_clock_set_mode (ClutterFrameClock     *frame_clock,
   maybe_reschedule_update (frame_clock);
 }
 
+/**
+ * clutter_frame_clock_set_tearing:
+ * @frame_clock: A #ClutterFrameClock
+ * @tearing: whether frames are presented with asynchronous page flips
+ *
+ * While tearing, an update scheduled with clutter_frame_clock_schedule_update()
+ * is dispatched right away instead of at the update time of the next refresh
+ * cycle, since the frame will be presented as soon as it is ready. Throttled
+ * updates (timelines) keep following the refresh cycle.
+ */
+void
+clutter_frame_clock_set_tearing (ClutterFrameClock *frame_clock,
+                                 gboolean           tearing)
+{
+  if (frame_clock->tearing == tearing)
+    return;
+
+  CLUTTER_NOTE (FRAME_CLOCK, "Frame clock %s: tearing %s",
+                frame_clock->output_name, tearing ? "on" : "off");
+
+  frame_clock->tearing = tearing;
+
+  if (frame_clock->mode == CLUTTER_FRAME_CLOCK_MODE_PASSIVE)
+    return;
+
+  reschedule_for_new_timing (frame_clock);
+}
+
+gboolean
+clutter_frame_clock_is_tearing (ClutterFrameClock *frame_clock)
+{
+  return frame_clock->tearing;
+}
+
 ClutterFrameResult
 clutter_frame_clock_dispatch (ClutterFrameClock *frame_clock,
                               int64_t            time_us)
diff --git a/clutter/clutter/clutter-frame-clock.h b/clutter/clutter/clutter-frame-clock.h
index 699a2e9..98b4f74 100644
--- a/clutter/clutter/clutter-frame-clock.h
+++ b/clutter/clutter/clutter-frame-clock.h
@@ -95,6 +95,13 @@ CLUTTER_EXPORT
 void clutter_frame_clock_set_mode (ClutterFrameClock     *frame_clock,
                                    ClutterFrameClockMode  mode);
 
+CLUTTER_EXPORT
+void clutter_frame_clock_set_tearing (ClutterFrameClock *frame_clock,
+                                      gboolean           tearing);
+
+CLUTTER_EXPORT
+gboolean clutter_frame_clock_is_tearing (ClutterFrameClock *frame_clock);
+
 CLUTTER_EXPORT
 void clutter_frame_clock_notify_presented (ClutterFrameClock *frame_clock,
                                            ClutterFrameInfo  *frame_info);
