#!/bin/bash
# SPDX-License-Identifier: MIT
set -euo pipefail
# LEGACY-ASAHI(2027-02-28): settings kept from the update-m1n1 package (the
# file itself, or the copy RPM saves when it removes the old package) apply first,
# so /etc/sysconfig/update-aura overrides them.
for legacy in /etc/sysconfig/update-m1n1 /etc/sysconfig/update-m1n1.rpmsave; do
    # shellcheck disable=SC1090
    [[ ! -f $legacy ]] || source "$legacy"
done
if [[ -z ${AURA+x} && -n ${M1N1+x} ]]; then AURA=$M1N1; fi
# shellcheck disable=SC1091
[[ ! -f /etc/sysconfig/update-aura ]] || source /etc/sysconfig/update-aura
[[ -z ${AURA_UPDATE_DISABLED:-}${M1N1_UPDATE_DISABLED:-} ]] || exit 0
# shellcheck disable=SC1091
[[ ! -f /etc/u-boot.conf ]] || source /etc/u-boot.conf
export AURORA_FIRMWARE_DT=${FIRMWAREDT:-${FirmwareDT:-}}

if [[ -n ${SOURCE:-} ]]; then
    AURA=${AURA-"$SOURCE/aura.bin"}
    U_BOOT=${U_BOOT-"$SOURCE/u-boot-nodtb.bin"}
fi
if [[ -z ${AURA+x} && ! -e /usr/lib64/aura/aura.bin && -e /usr/lib64/m1n1/m1n1.bin ]]; then
    AURA=/usr/lib64/m1n1/m1n1.bin  # LEGACY-ASAHI(2027-02-28): pre-rename aura or m1n1 package
fi
export AURA=${AURA-/usr/lib64/aura/aura.bin}
export U_BOOT=${U_BOOT-/usr/share/uboot/apple_m1/u-boot-nodtb.bin}
# LEGACY-ASAHI(2027-02-28): an owner's /etc/m1n1.conf still counts until it is
# moved to /etc/aura.conf.
if [[ -z ${CONFIG:-} && ! -e /etc/aura.conf && -e /etc/m1n1.conf ]]; then
    CONFIG=/etc/m1n1.conf
fi
export CONFIG=${CONFIG:-/etc/aura.conf}
export DTBS=${DTBS-/boot/dtb}
export AURORA_DEVICE_TREE_COMPATIBLE=${AURORA_DEVICE_TREE_COMPATIBLE:-/proc/device-tree/compatible}
export AURORA_MONITOR_FREE_MARKER=${AURORA_MONITOR_FREE_MARKER:-/usr/share/aura/monitor-free}
mode=${1:-}
case $mode in
    --commit|--guard|--transaction-begin|--transaction-end)
        export AURORA_KERNEL_ACTION=refresh AURORA_KERNEL_VERSION=
        export TARGET=${TARGET:-}
        ;;
    *)
        [[ -z $mode || $mode != --* ]] || { echo "unknown update-aura option" >&2; exit 2; }
        export TARGET=${TARGET:-$mode}
        ;;
esac

# One lock covers discovery, mounting, staging and link replacement, including
# callers from both RPM file triggers and kernel-install.
mkdir -p /run/lock
exec 9>/run/lock/update-aura.lock
flock -x 9

# A package transaction that removes kernels is recorded before it starts.
# Its removals leave Stage 2 to the kernels it adds and to a refresh at its end.
case $mode in
    --transaction-begin)
        exec python3 /usr/libexec/aurora/bootchain.py --transaction-begin
        ;;
    --transaction-end)
        python3 /usr/libexec/aurora/bootchain.py --transaction-end || exit 0
        mode=
        ;;
esac
if [[ ${AURORA_KERNEL_ACTION:-} == remove ]] && python3 /usr/libexec/aurora/bootchain.py --defer-remove; then
    exit 0
fi
mounted=false
cleanup() {
    if $mounted; then umount /run/.system-efi; fi
}
trap cleanup EXIT

# Preflight before mounting the ESP. The apply pass checks again under the lock.
if [[ $mode != --commit && $mode != --guard ]] && ! python3 /usr/libexec/aurora/bootchain.py --check; then
    if [[ ${AURORA_KERNEL_ACTION:-} == remove ]]; then
        python3 /usr/libexec/aurora/bootchain.py --cleanup-remove
        exit 0
    fi
    exit 1
fi
# An image build has no device tree and no ESP: the check above validated
# every board, and the image builder writes Stage 2 itself.
if [[ -z $TARGET && $mode != --commit && $mode != --guard && ! -e $AURORA_DEVICE_TREE_COMPATIBLE ]]; then
    echo "update-aura: no device tree; Stage 2 is left to the image builder" >&2
    exit 0
fi
if [[ -z $TARGET ]]; then
    # shellcheck disable=SC1091
    source /usr/share/asahi-scripts/functions.sh
    mount_sys_esp /run/.system-efi
    mounted=true
    # The one Stage 2 file the enrolled Stage 1 loads lives in aurora/. LEGACY-ASAHI(2027-02-28):
    # a Stage 1 enrolled before the rename chainloads m1n1/boot.bin (or
    # m1n1/boot-ctxr.bin); only reinstalling Stage 1 changes that. When aurora/
    # has no Stage 2 file and m1n1/ has one, that file is the one to update.
    esp=/run/.system-efi
    if [[ -n ${AURA_ESP_DIR:-} ]]; then
        stage2_dir=$esp/$AURA_ESP_DIR
    elif [[ ! -e $esp/aurora/boot.bin && ! -e $esp/aurora/boot-ctxr.bin ]] &&
         [[ -e $esp/m1n1/boot.bin || -e $esp/m1n1/boot-ctxr.bin ]]; then
        stage2_dir=$esp/m1n1
    else
        stage2_dir=$esp/aurora
    fi
    mkdir -p "$stage2_dir"
    export TARGET=$stage2_dir/boot.bin
fi
# Resolve the actual mount, including explicitly configured ESP targets.
ESP_ROOT=$(findmnt -nro TARGET --target "$(dirname "$TARGET")")
ESP_DEVICE=$(findmnt -nro SOURCE --target "$ESP_ROOT")
ESP_FSTYPE=$(findmnt -nro FSTYPE --target "$ESP_ROOT")
export ESP_ROOT ESP_DEVICE ESP_FSTYPE
args=()
[[ $mode != --commit && $mode != --guard ]] || args+=("$mode")
if ! python3 /usr/libexec/aurora/bootchain.py "${args[@]}"; then
    if [[ ${AURORA_KERNEL_ACTION:-} == remove ]]; then
        python3 /usr/libexec/aurora/bootchain.py --cleanup-remove
        exit 0
    fi
    exit 1
fi
