#!/bin/sh
# SPDX-License-Identifier: MIT
# Finish installing Aurora kernels whose kernel-install run stopped early.
#
# Before 20261107-6 the Stage 2 updater refused a boot entry whose kernel was
# gone and every kernel from before the DT ABI marker. 15-update-m1n1.install
# then failed, kernel-install stopped before the initramfs and the boot entry,
# and the Mac kept booting the older kernel. Run kernel-install again for each
# kernel-aurora-core newer than every one that has a boot entry. Kernels
# installed in the same transaction as this package are left to their own
# %posttrans.
set -u
entries=${AURORA_BLS_ENTRIES:-/boot/loader/entries}
# Due until a run finishes: %posttrans creates it, and the unit runs at boot while it stays.
marker=${AURORA_REPAIR_MARKER:-/var/lib/update-aura/repair-pending}

# --after-transaction: started through systemd by update-aura's %posttrans.
# A libdnf5 post_transaction action isn't used because dnf5-plugin-actions is
# not installed by default on Aurora/Fedora systems and direct rpm or offline
# upgrade transactions bypass dnf plugins. The active rpm transaction still
# holds the database fcntl lock until it ends ("can't create transaction lock"),
# so wait for a read-only rpm probe to succeed first.
if [ "${1:-}" = --after-transaction ]; then
    limit=${AURORA_RPM_WAIT_SECONDS:-900}
    step=${AURORA_RPM_WAIT_STEP:-2}
    waited=0
    until rpm -q --quiet rpm 2>/dev/null; do
        if [ "$waited" -ge "$limit" ]; then
            echo "update-aura: the rpm database stayed locked for $limit s; no kernel was repaired" >&2
            exit 1
        fi
        sleep "$step"
        waited=$((waited + step))
    done
fi
modules=${AURORA_MODULES_DIR:-/usr/lib/modules}

# Still locked (run inside a transaction): the marker keeps the repair due.
rpm -q --quiet rpm 2>/dev/null || exit 0
rpm -q kernel-aurora-core >/dev/null 2>&1 || { rm -f -- "$marker"; exit 0; }
own=$(rpm -q --qf '%{INSTALLTID}\n' update-aura 2>/dev/null | sort -n | tail -n 1)
kernels=$(rpm -q --qf '%{INSTALLTID} %{VERSION}-%{RELEASE}.%{ARCH}\n' kernel-aurora-core |
    sort -k2,2V)

has_entry() {
    grep -qsxF "version $1" "$entries"/*.conf
}

newest=
for krel in $(printf '%s\n' "$kernels" | cut -d' ' -f2); do
    if has_entry "$krel"; then newest=$krel; fi
done

# Oldest first: each add makes its kernel the default, so the newest wins.
printf '%s\n' "$kernels" | { status=0; while read -r tid krel; do
    [ -n "$krel" ] && [ "$tid" != "$own" ] || continue
    if [ ! -f "$modules/$krel/vmlinuz" ] || has_entry "$krel"; then continue; fi
    if [ -n "$newest" ] &&
        [ "$(printf '%s\n%s\n' "$newest" "$krel" | sort -V | tail -n 1)" = "$newest" ]; then
        continue
    fi
    # Re-check right before adding: earlier dracut runs take minutes and a
    # concurrent dnf run may have removed this kernel or re-locked rpm.
    if ! rpm -q --quiet "kernel-aurora-core-$krel" 2>/dev/null; then
        if ! rpm -q --quiet rpm 2>/dev/null; then
            echo "update-aura: rpm database locked before kernel-install add $krel; keeping repair pending" >&2
            status=1
        fi
        continue
    fi
    if [ ! -f "$modules/$krel/vmlinuz" ] || has_entry "$krel"; then
        continue
    fi
    echo "update-aura: kernel $krel has no boot entry; finishing its kernel-install" >&2
    kernel-install add "$krel" "$modules/$krel/vmlinuz" ||
        { echo "update-aura: kernel-install add $krel failed" >&2; status=1; }
done; exit "$status"; } && rm -f -- "$marker"
exit 0
