#!/bin/bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
profile=${1:?fedora-kde, fedora-gnome or fedora-minimal required}
[[ $profile =~ ^fedora-(kde|gnome|minimal)$ ]] || exit 2
[[ $(uname -m) == aarch64 && $(id -u) == 0 ]] || { echo 'Use a disposable privileged native AArch64 image builder' >&2; exit 2; }
mkdir -p "$root/out"
upstream=$root/out/upstream-kiwi
if [[ ! -e $upstream ]]; then
  git clone https://pagure.io/fedora-asahi/kiwi-descriptions.git "$upstream"
fi
revision=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["commit"])' "$root/images/upstream.json")
git -C "$upstream" checkout --detach "$revision"
python3 "$root/images/configure.py" --upstream "$upstream" \
  --output "$root/out/$profile-description" --profile "$profile" \
  --repository-url "${AURORA_REPOSITORY_URL:-https://aurorasilicon.org/fedora-aurora/44/testing/aarch64}" \
  --signing-key "$root/keys/RPM-GPG-KEY-aurora" \
  --signing-key-fingerprint "$(cat "$root/keys/fingerprint.txt")"
python3 - "$root/out/$profile-description/aurora-image.json" <<'PY'
import json,subprocess,sys
receipt=json.load(open(sys.argv[1]))
subprocess.run(receipt['build_command'],check=True)
PY

# The common producer seals firstboot identities before exporting any filesystem.
shopt -s nullglob
images=("$root/out/$profile-description-image/"*.raw)
(( ${#images[@]} == 1 )) || { echo 'Expected one KIWI raw image' >&2; exit 1; }
python3 "$root/scripts/fetch-sources.py" aurora-firstboot --output "$root/out/finalizer-source"
source_archive=("$root/out/finalizer-source/"aurora-firstboot-*.tar.gz)
(( ${#source_archive[@]} == 1 ))
mkdir -p "$root/out/finalizer"
tar -xzf "${source_archive[0]}" --strip-components=1 -C "$root/out/finalizer"
bash "$root/out/finalizer/images/finalize-image" "${images[0]}" "$profile" "$root/out/$profile-installer"
# Every image ships the basics (locale, terminal, wallpapers, network, lid
# policy, GRUB finding /boot by UUID on the startup disk); a build that lacks
# one fails here instead of on a Mac. The finished filesystems are checked
# exactly as the installer writes them.
installer=$root/out/$profile-installer
read -r boot_uuid root_subvolume < <(python3 -c 'import json,sys; j=json.load(open(sys.argv[1])); print(j["boot_uuid"], j.get("root_subvolume", "root"))' "$installer/image.json")
basics_root=$(mktemp -d)
mount -o ro,loop,subvol="$root_subvolume" "$installer/root.img" "$basics_root"
basics=0
python3 "$root/scripts/check-basics" --profile "${profile#fedora-}" --root "$basics_root" \
  --esp "$installer/esp" --boot-image "$installer/boot.img" --boot-uuid "$boot_uuid" --grub-flavor fedora || basics=$?
umount "$basics_root"
rmdir "$basics_root"
(( basics == 0 ))
tar --sparse -C "$root/out/$profile-installer" -cf - . | zstd -T"${AURORA_BUILD_JOBS:-4}" -3 -o "$root/out/$profile-filesystems.tar.zst"
sha256sum "$root/out/$profile-filesystems.tar.zst" > "$root/out/$profile-filesystems.tar.zst.sha256"
