#!/bin/bash
# SPDX-License-Identifier: MIT
# Run inside a disposable Fedora 45 aarch64 container in a controller slot.
set -euo pipefail
# Fedora's Cargo/CMake sub-builds do not consume RPM's make job settings.
jobs=${AURORA_BUILD_JOBS:-8}
[[ $jobs =~ ^[1-8]$ ]] || { echo 'AURORA_BUILD_JOBS must be 1..8' >&2; exit 2; }
export CARGO_BUILD_JOBS=$jobs CMAKE_BUILD_PARALLEL_LEVEL=$jobs
source_only=0
case ${1:-} in
  '') ;;
  --source-only) source_only=1 ;;
  *) echo 'usage: build-firefox-avd-fedora [--source-only]' >&2; exit 2 ;;
esac
test "$(uname -m)" = aarch64
test "$(rpm -E '%fedora')" = 45
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
result=${BUILD_OUT:?controller build output directory required}/firefox-fc45
mkdir -p "$result"
exec > >(tee "$result/build.log") 2>&1
(cd "$root" && sha256sum docs/firefox/*.patch docs/firefox/prepare-fedora.py \
  scripts/build-firefox-avd-fedora) > "$result/candidate-inputs.sha256"
work=$(mktemp -d "$root/out-firefox.XXXXXX")
top=$work/rpmbuild
mkdir -p "$top"/{SOURCES,SPECS,SRPMS,RPMS,BUILD,BUILDROOT}
collect() {
  rc=$?
  trap - EXIT
  for kind in RPMS SRPMS; do
    cp -a "$top/$kind" "$result/" || true
  done
  find "$top/BUILD" -type f \( -name config.log -o -name config.status \
    -o -name mozconfig -o -name autoconf.h -o -name mozilla-config.h \) \
    -exec cp --parents '{}' "$result/" \; || true
  exit "$rc"
}
trap collect EXIT
dnf install -y fedpkg rpm-build dnf5-plugins redhat-rpm-config git python3 kernel-headers
revision=054f5ce6c099dfc8d788332920b4cb3397334ab6
git clone --branch f45 https://src.fedoraproject.org/rpms/firefox.git "$work/distgit"
git -C "$work/distgit" switch -c avd-request "$revision"
python3 "$root/docs/firefox/prepare-fedora.py" firefox "$work/distgit"
(
  cd "$work/distgit"
  # --force selects all pinned sources; checksum verification remains enabled.
  fedpkg --release f45 sources --force
  # fedpkg verifies the lookaside SHA512 entries. Retain the public manifest.
  cp sources "$result/fedora-sources"
  cp ./* "$top/SOURCES/"
)
cp "$top/SOURCES/firefox.spec" "$top/SPECS/"
dnf builddep -y "$top/SPECS/firefox.spec"
rpmspec --parse --with avd_request "$top/SPECS/firefox.spec" > "$result/expanded.spec"
if [[ $source_only == 1 ]]; then
  rpmbuild -bs --with avd_request --define "_topdir $top" \
    --define "_smp_build_ncpus $jobs" --define "_smp_mflags -j$jobs" \
    "$top/SPECS/firefox.spec"
  find "$top/SRPMS" -type f -name '*.rpm' -exec sha256sum '{}' \; \
    > "$result/rpm-sha256.txt"
  echo 'Canonical Firefox SRPM complete; no browser binary was built.'
  exit 0
fi
rpmbuild -ba --noclean --with avd_request --define "_topdir $top" \
  --define "_smp_build_ncpus $jobs" --define "_smp_mflags -j$jobs" \
  "$top/SPECS/firefox.spec"
python3 - "$top/BUILD" <<'PY'
from pathlib import Path
import sys
configs = list(Path(sys.argv[1]).rglob('mozilla-config.h'))
assert any('#define MOZ_ENABLE_V4L2 1' in p.read_text() for p in configs), \
    'built configuration did not enable the V4L2 sandbox clauses'
print('Generated MOZ_ENABLE_V4L2 confirmed')
PY
find "$top/RPMS" "$top/SRPMS" -type f -name '*.rpm' -exec sha256sum '{}' \; \
  > "$result/rpm-sha256.txt"
echo 'Firefox RPM build complete; physical AVD/browser qualification is pending.'
