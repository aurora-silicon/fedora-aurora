#!/bin/bash
# SPDX-License-Identifier: MIT
# Verify in a new Fedora 45 aarch64 installroot; no physical decoder required.
set -euo pipefail
test "$(uname -m)" = aarch64
test "$(rpm -E '%fedora')" = 45
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
result=${BUILD_OUT:?build output directory required}/firefox-fc45
verify=$(mktemp -d "$root/verify-firefox.XXXXXX")
# Keep a failing root available for inspection until the disposable runner exits.
exec > >(tee "$result/install-check.log") 2>&1
dnf --installroot "$verify" --releasever 45 --setopt=install_weak_deps=False \
  install -y \
  "$result/RPMS/aarch64/firefox-159.0-2.fc45.avd1.aarch64.rpm" \
  "$result/RPMS/aarch64/firefox-langpacks-159.0-2.fc45.avd1.aarch64.rpm" \
  "$root/out/rpms/ffmpeg-avd-8.1-1.fc45.aarch64.rpm" \
  "$root/out/rpms/libva-v4l2-request-1.3.r11-4.fc45.aarch64.rpm"
rpm --root "$verify" -q firefox firefox-langpacks ffmpeg-avd libva-v4l2-request
rpm --root "$verify" -V firefox firefox-langpacks ffmpeg-avd libva-v4l2-request
python3 - "$verify" <<'PY'
from pathlib import Path
import json
import sys
root = Path(sys.argv[1]) / 'usr/lib64/firefox'
verified = {}
for name in ('firefox', 'firefox-bin', 'libxul.so'):
    path = root / name
    if not path.is_file() or path.is_symlink():
        continue
    with path.open('rb') as stream:
        header = stream.read(20)
    if not header.startswith(b'\x7fELF'):
        continue
    assert header[4:6] == b'\x02\x01', name
    assert int.from_bytes(header[18:20], 'little') == 183, name
    verified[name] = 'ELF64 little-endian AArch64'
assert 'libxul.so' in verified
assert any(name in verified for name in ('firefox', 'firefox-bin'))
print(json.dumps(verified, indent=2))
PY
timeout 60s chroot "$verify" /usr/bin/firefox --headless --version
echo 'PASS: Firefox candidate installed and verified in clean Fedora 45 aarch64 root natively'
