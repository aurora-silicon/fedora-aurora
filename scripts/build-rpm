#!/bin/bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
package=${1:?package name required}
[[ $package =~ ^[a-z0-9][a-z0-9-]*$ && -f $root/packages/$package/$package.spec ]] || { echo 'Unknown package' >&2; exit 2; }
# Native Fedora macros select the recipe; callers can assert the intended release.
release=${AURORA_FEDORA_RELEASE:-$(rpm --eval '%{fedora}')}
[[ $release == 44 || $release == 45 ]] || { echo 'Unsupported Fedora release' >&2; exit 2; }
[[ $(rpm --eval '%{fedora}') == "$release" ]] || { echo 'Container release mismatch' >&2; exit 2; }
export AURORA_FEDORA_RELEASE=$release
top=$root/out/build/$package
mkdir -p "$top"/{SOURCES,SPECS,SRPMS,RPMS,BUILD,BUILDROOT}
find "$root/packages/$package" -maxdepth 1 -type f -exec cp {} "$top/SOURCES/" \;
if [[ $release == 45 && -d $root/packages/$package/f45 ]]; then
  cp "$root/packages/$package/f45/"* "$top/SOURCES/"
fi
cp "$top/SOURCES/$package.spec" "$top/SPECS/"
if python3 - "$root/scripts" "$package" "$release" <<'PY'
import sys
from pathlib import Path
sys.path.insert(0, sys.argv[1])
import fedoralib
raise SystemExit(0 if sys.argv[2] in fedoralib.sources(Path(sys.argv[1]).parent, int(sys.argv[3])) else 1)
PY
then
  python3 "$root/scripts/fetch-sources.py" "$package" --fedora-release "$release" --output "$top/SOURCES"
fi
if [[ ${AURORA_INSTALL_BUILDDEPS:-0} == 1 ]]; then
  dnf builddep -y "$top/SPECS/$package.spec"
fi
if [[ $package == aurora-flatpak-gl ]]; then
  commit=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import fedoralib; print(fedoralib.sources(sys.argv[2], int(sys.argv[3]))["mesa-aurora"]["commit"])' "$root/scripts" "$root" "$release")
  archive=$top/SOURCES/aurora-flatpak-gl-repo-${commit:0:12}.tar
  if [[ -n ${AURORA_FLATPAK_GL_REPO_TAR:-} ]]; then
    cp "$AURORA_FLATPAK_GL_REPO_TAR" "$archive"
  else
    bash "$root/scripts/build-flatpak-gl-repo" "$archive"
  fi
fi
# Aurora's builds carry a vendor so dnf's vendor change policy can tell them
# apart from Fedora's. aurora-repos ships that policy and aurora-release
# requires it, so both have none: they must install and upgrade without a
# vendor change on systems that don't have the policy yet.
vendor=(--define "vendor Aurora Silicon")
[[ $package == aurora-release || $package == aurora-repos ]] && vendor=()
rpmbuild -ba --define "_topdir $top" --define "_smp_mflags -j${AURORA_BUILD_JOBS:-6}" "${vendor[@]}" "$top/SPECS/$package.spec"
mkdir -p "$root/out/rpms" "$root/out/srpms"
find "$top/RPMS" -type f -name '*.rpm' -exec cp -p {} "$root/out/rpms/" \;
find "$top/SRPMS" -type f -name '*.rpm' -exec cp -p {} "$root/out/srpms/" \;
python3 "$root/scripts/build-receipt.py" "$package"
