#!/bin/bash
# SPDX-License-Identifier: MIT
# Run in a controller build slot. Full builds require Fedora 44 aarch64.
set -euo pipefail

jobs=${AURORA_BUILD_JOBS:-8}
[[ $jobs =~ ^[1-8]$ ]] || { echo 'AURORA_BUILD_JOBS must be 1..8' >&2; exit 2; }
source_only=0
case ${1:-} in
  '') ;;
  --source-only) source_only=1 ;;
  *) echo 'usage: build-firefox-rdd-v4l2-request [--source-only]' >&2; exit 2 ;;
esac

test "$(rpm -E '%fedora')" = 44
if [[ $source_only == 0 ]]; then
  test "$(uname -m)" = aarch64
fi

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
result=${BUILD_OUT:?controller build output directory required}/firefox-fc44
mkdir -p "$result"
exec > >(tee "$result/build.log") 2>&1

work=$(mktemp -d "$root/out-firefox.XXXXXX")
top=$work/rpmbuild
mkdir -p "$top"/{SOURCES,SPECS,SRPMS,RPMS,BUILD,BUILDROOT}
collect() {
  rc=$?
  trap - EXIT
  for kind in RPMS SRPMS; do
    cp -a "$top/$kind" "$result/" || true
  done
  exit "$rc"
}
trap collect EXIT

dnf install -y fedpkg rpm-build dnf5-plugins redhat-rpm-config git python3 \
  kernel-headers
revision=1465e7dfc36e96ec3825c12f3dbed41c426e080d
git init "$work/distgit"
git -C "$work/distgit" remote add origin https://src.fedoraproject.org/rpms/firefox.git
# Pagure does not advertise arbitrary commit fetches. Fetch only the bounded
# Fedora 44 history that contains the reviewed Firefox 157 revision.
git -C "$work/distgit" fetch --shallow-since=2026-09-20 origin f44
git -C "$work/distgit" checkout --detach "$revision"
python3 "$root/docs/firefox/prepare-fedora.py" "$work/distgit"
(
  cd "$work/distgit"
  fedpkg --release f44 sources --force
  cp ./* "$top/SOURCES/"
)
cp "$top/SOURCES/firefox.spec" "$top/SPECS/"
# AURORA_FIREFOX_TEST_BUILD=1: CI test build for hardware qualification only (no debuginfo,
# no langpacks, no WASI SDK / wasm-sandboxed libraries) so it fits a 4-vCPU runner.
extra=()
if [[ ${AURORA_FIREFOX_TEST_BUILD:-0} == 1 ]]; then
  sed -i 's/^%global create_debuginfo  1$/%global create_debuginfo  0/' "$top/SPECS/firefox.spec"
  grep -q '^%global create_debuginfo  0$' "$top/SPECS/firefox.spec"
  extra=(--without wasi_sdk --without langpacks)
fi
rpmspec --parse --with avd_request "${extra[@]}" "$top/SPECS/firefox.spec" > "$result/expanded.spec"

export CARGO_BUILD_JOBS=$jobs CMAKE_BUILD_PARALLEL_LEVEL=$jobs
if [[ $source_only == 1 ]]; then
  rpmbuild -bs --with avd_request --define "_topdir $top" \
    --define "_smp_build_ncpus $jobs" --define "_smp_mflags -j$jobs" \
    "$top/SPECS/firefox.spec"
else
  dnf builddep -y "${extra[@]}" "$top/SPECS/firefox.spec"
  rpmbuild -bb --noclean --with avd_request "${extra[@]}" --define "_topdir $top" \
    --define "_smp_build_ncpus $jobs" --define "_smp_mflags -j$jobs" \
    "$top/SPECS/firefox.spec"
  python3 - "$top/BUILD" <<'PY'
from pathlib import Path
import sys

configs = list(Path(sys.argv[1]).rglob("mozilla-config.h"))
assert any("#define MOZ_ENABLE_V4L2 1" in path.read_text() for path in configs), \
    "built configuration did not enable the V4L2 sandbox clauses"
print("Generated MOZ_ENABLE_V4L2 confirmed")
PY
fi

find "$top/RPMS" "$top/SRPMS" -type f -name '*.rpm' -exec sha256sum '{}' \; \
  > "$result/rpm-sha256.txt"
